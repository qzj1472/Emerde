{
  "schema_version": 1,
  "id": "emerde.douyin-publisher",
  "name": "抖音自动投稿",
  "version": "1.3.3",
  "description": "将指定直播间的最终录制文件或视频列表中的旧文件自动上传并发布到抖音。",
  "author": "Emerde",
  "execution_mode": "in_process",
  "entry_point": "Emerde.DouyinPublisher.Extension.dll",
  "entry_type": "Emerde.DouyinPublisher.ExtensionEntry",
  "minimum_host_version": "1.6.7.0",
  "capabilities": [
    "media.finalized",
    "ui.extension-detail",
    "ui.video-list-actions",
    "host.video-selection",
    "publisher.queue",
    "publisher.douyin.webview2"
  ],
  "permissions": [
    "credentials.platform-cookie.read",
    "ui.modify"
  ],
  "settings": [
    {
      "key": "auto_publish",
      "label": "自动发布",
      "description": "上传并填写完成后直接发布；关闭后会等待你在投稿浏览器中确认。",
      "section": "投稿行为",
      "column": 0,
      "type": "boolean",
      "default": "true"
    },
    {
      "key": "confirm_before_publish",
      "label": "发布前确认",
      "description": "每个视频填写完成后暂停，等待你检查并确认。",
      "section": "投稿行为",
      "column": 0,
      "type": "boolean",
      "default": "false"
    },
    {
      "key": "title_template",
      "label": "标题模板",
      "description": "支持直播标题、主播昵称、文件名和日期变量，最终标题最多 30 个字符。",
      "section": "基础信息",
      "column": 0,
      "type": "text",
      "default": "{title}",
      "options": [
        "{title}",
        "{nickname}",
        "{filename}",
        "{date}"
      ]
    },
    {
      "key": "description_template",
      "label": "作品简介",
      "description": "支持与标题相同的变量，留空时不填写简介。",
      "section": "基础信息",
      "column": 0,
      "type": "text",
      "default": ""
    },
    {
      "key": "topics",
      "label": "话题",
      "description": "用空格或逗号分隔，扩展会自动补充 #。",
      "section": "基础信息",
      "column": 0,
      "type": "text",
      "default": ""
    },
    {
      "key": "cover_path",
      "label": "默认视频封面",
      "description": "自动投稿使用的 JPG、PNG 或 WebP 图片路径，留空时使用抖音默认封面。",
      "section": "基础信息",
      "column": 0,
      "type": "text",
      "default": ""
    },
    {
      "key": "official_activity",
      "label": "默认官方活动",
      "description": "填写活动的完整名称，留空时不选择。",
      "section": "基础信息",
      "column": 0,
      "type": "text",
      "default": ""
    },
    {
      "key": "collection_name",
      "label": "默认合集",
      "description": "填写已有合集名称，留空时不添加合集。",
      "section": "基础信息",
      "column": 0,
      "type": "text",
      "default": ""
    },
    {
      "key": "declaration",
      "label": "默认自主声明",
      "description": "自动投稿使用的内容声明。",
      "section": "基础信息",
      "column": 0,
      "type": "choice",
      "default": "不声明",
      "options": [
        "不声明",
        "内容由我原创",
        "内容由AI生成",
        "内容为转载"
      ]
    },
    {
      "key": "video_chapters",
      "label": "默认视频章节",
      "description": "每行填写一个时间点和章节名称，留空时不添加。",
      "section": "基础信息",
      "column": 0,
      "type": "text",
      "default": ""
    },
    {
      "key": "tags",
      "label": "默认标签",
      "description": "自动投稿需要添加的标签，留空时不添加。",
      "section": "扩展信息",
      "column": 1,
      "type": "text",
      "default": ""
    },
    {
      "key": "location",
      "label": "默认地点",
      "description": "自动投稿关联的地点，留空时不添加。",
      "section": "扩展信息",
      "column": 1,
      "type": "text",
      "default": ""
    },
    {
      "key": "hotspot",
      "label": "默认关联热点",
      "description": "自动投稿关联的热点名称，留空时不关联。",
      "section": "扩展信息",
      "column": 1,
      "type": "text",
      "default": ""
    },
    {
      "key": "visibility",
      "label": "默认可见范围",
      "description": "自动投稿发布后的可见范围。",
      "section": "发布设置",
      "column": 1,
      "type": "choice",
      "default": "公开",
      "options": [
        "公开",
        "好友可见",
        "仅自己可见"
      ]
    },
    {
      "key": "allow_save",
      "label": "默认允许下载",
      "description": "是否允许其他用户下载自动投稿的作品。",
      "section": "发布设置",
      "column": 1,
      "type": "boolean",
      "default": "true"
    },
    {
      "key": "publish_time",
      "label": "默认发布时间",
      "description": "自动投稿立即发布或延迟到指定间隔后发布。",
      "section": "发布设置",
      "column": 1,
      "type": "choice",
      "default": "立即发布",
      "options": [
        "立即发布",
        "定时发布"
      ]
    },
    {
      "key": "schedule_delay_minutes",
      "label": "定时发布延迟",
      "description": "选择定时发布时，从任务入队起延迟的分钟数，范围 10 至 10080。",
      "section": "发布设置",
      "column": 1,
      "visible_when_key": "publish_time",
      "visible_when_value": "定时发布",
      "type": "number",
      "default": "120"
    },
    {
      "key": "max_retries",
      "label": "失败重试次数",
      "description": "页面或网络临时失败后的自动重试次数，范围 0 至 10。",
      "section": "发布设置",
      "column": 1,
      "type": "number",
      "default": "3"
    }
  ],
  "timeout_seconds": 30
}
