    <Target Name="PrunePublishedArtifacts"
            AfterTargets="Publish"
            Condition="'$(PublishDir)' != '' and Exists('$(MSBuildThisFileDirectory)..\..\build\Prune-Publish.ps1')">
        <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\build\Prune-Publish.ps1&quot; -Root &quot;$(PublishDir).&quot; -Mode &quot;$(Configuration)&quot;" />
    </Target>

    <Target Name="RemoveReleaseDiagnosticsFromBundle"
            AfterTargets="_ComputeFilesToBundle"
            Condition="'$(Configuration)' == 'Release' and '$(PublishSingleFile)' == 'true'">
        <ItemGroup>
            <ReleaseDiagnosticBundleFile Include="@(_FilesToBundle)"
                                         Condition="'%(_FilesToBundle.Filename)%(_FilesToBundle.Extension)' == 'createdump.exe'
                                                    or '%(_FilesToBundle.Filename)%(_FilesToBundle.Extension)' == 'mscordbi.dll'
                                                    or '%(_FilesToBundle.Filename)%(_FilesToBundle.Extension)' == 'Microsoft.DiaSymReader.Native.amd64.dll'
                                                    or $([System.Text.RegularExpressions.Regex]::IsMatch('%(_FilesToBundle.Filename)', '^mscordaccore', System.Text.RegularExpressions.RegexOptions.IgnoreCase))" />
            <_FilesToBundle Remove="@(ReleaseDiagnosticBundleFile)" />
        </ItemGroup>
    </Target>

