        <PackageReference Include="ComputedAnimations.WPF" Version="0.5.1" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
        <PackageReference Include="Fischless.Configuration" Version="1.1.0" />
        <PackageReference Include="Fischless.Configuration.Json" Version="1.1.0" />
        <PackageReference Include="Fischless.Configuration.Yaml" Version="1.1.0" />
        <PackageReference Include="Jint" Version="4.10.1" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="RestSharp" Version="112.1.0" />
        <PackageReference Include="Vanara.PInvoke.SHCore" Version="4.2.1" />
        <PackageReference Include="Vanara.PInvoke.User32" Version="4.2.1" />
        <PackageReference Include="Vanara.PInvoke.Kernel32" Version="4.2.1" />
        <PackageReference Include="Vanara.PInvoke.DwmApi" Version="4.2.1" />
        <PackageReference Include="Vanara.PInvoke.NtDll" Version="4.2.1" />
        <PackageReference Include="Vanara.PInvoke.Security" Version="4.2.1" />
        <PackageReference Include="MediaInfoDLL" Version="25.7.0" />
        <PackageReference Include="WindowsAPICodePack.Shell.CommonFileDialogs" Version="1.1.5" />
        <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
        <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
        <PackageReference Include="System.Drawing.Common" Version="9.0.9" />
        <PackageReference Include="YamlDotNet" Version="16.3.0" />
        <PackageReference Include="NAudio" Version="2.2.1" />
        <PackageReference Include="NAudio.Core" Version="2.2.1" />
    </ItemGroup>

