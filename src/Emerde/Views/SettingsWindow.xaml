                                    <Button Margin="0,0,8,8" Command="{Binding AppendSaveFileNameTokenCommand}" CommandParameter="{}{帧率}" Content="{I18N TokenFrameRate}" />
                                    <Button Margin="0,0,8,8" Command="{Binding AppendSaveFileNameTokenCommand}" CommandParameter="{}{画质}" Content="{I18N TokenQuality}" />
                                    <Button Margin="0,0,8,8" Command="{Binding AppendSaveFileNameTokenCommand}" CommandParameter="{}{视频编码}" Content="{I18N TokenVideoCodec}" />
                                    <Button Margin="0,0,8,8" Command="{Binding AppendSaveFileNameTokenCommand}" CommandParameter="{}{音频编码}" Content="{I18N TokenAudioCodec}" />
                                    <Button Margin="0,0,8,8" Command="{Binding AppendSaveFileNameTokenCommand}" CommandParameter="{}{优化音频}" Content="{I18N TokenOptimizedAudio}" />
                                    <Border />
                                    <Button Margin="0,0,8,8" Command="{Binding AppendSaveFileNameTokenCommand}" CommandParameter="{}{录制开始时间}" Content="{I18N TokenRecordStartTime}" />
                                    <Button Margin="0,0,8,8" Command="{Binding AppendSaveFileNameTokenCommand}" CommandParameter="{}{录制结束时间}" Content="{I18N TokenRecordEndTime}" />
                                    <Button Margin="0,0,8,8" Command="{Binding AppendSaveFileNameTokenCommand}" CommandParameter="{}{视频时长}" Content="{I18N TokenDuration}" />
                                </UniformGrid>
                            </ui:StackPanel>
                        </ui:StackPanel>
                    </ui:CardExpander>
                    <ui:Card x:Name="PreviewSettingsCard">
                        <ui:Grid MinHeight="35" ColumnDefinitions="Auto,*,Auto">
                            <Grid Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock MinWidth="26"
                                           Margin="4,0,0,0"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                           FontSize="18"
                                           Text="{x:Static ui:FontSymbols.Play}" />
                            </Grid>
                            <ui:Grid Grid.Column="1">
                                <TextBlock VerticalAlignment="Center" Text="{I18N Preview}" />
                            </ui:Grid>
                            <TextBlock Grid.Column="2"
                                       Margin="0,0,28,0"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{DynamicResource SystemFillColorSolidNeutralBrush}"
                                       Text="{I18N PreviewBuiltInPlayerHint}" />
                        </ui:Grid>
                    </ui:Card>
                    <TextBlock Margin="4,0,0,4"
                               FontSize="14"
                               Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                               Text="{I18N LongRunningSettings}" />
                    <ui:Card x:Name="KeepAwakeCard">
                        <ui:Grid MinHeight="35" ColumnDefinitions="Auto,*,Auto">
                            <Grid Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock MinWidth="26"
                                           Margin="4,0,0,0"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                           FontSize="18"
                                           Text="{x:Static ui:FontSymbols.DeviceMonitorRightPic}" />
                            </Grid>
                            <ui:Grid Grid.Column="1" RowDefinitions="Auto,Auto">
                                <TextBlock Grid.Row="0" Text="{I18N KeepAwake}" />
                                <TextBlock Grid.Row="1"
                                           FontSize="11"
                                           Foreground="{DynamicResource SystemFillColorSolidNeutralBrush}"
                                           Text="{I18N KeepActiveHint}" />
                            </ui:Grid>
                            <ui:ToggleSwitch Grid.Column="2"
                                             Margin="0,0,28,0"
                                             IsChecked="{Binding IsUseKeepAwake, Mode=TwoWay}" />
                        </ui:Grid>
                    </ui:Card>
                    <ui:CardExpander x:Name="AutoShutdownExpander">
                        <ui:CardExpander.Header>
                            <ui:Grid ColumnDefinitions="Auto,*,Auto">
                                <Grid Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock MinWidth="26"
                                               Margin="4,0,0,0"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                               FontSize="18"
                                               Text="{x:Static ui:FontSymbols.PowerButton}" />
                                </Grid>
                                <ui:Grid Grid.Column="1" RowDefinitions="Auto,Auto">
                                    <TextBlock Grid.Row="0" Text="{I18N AutoShutdown}" />
                                    <TextBlock Grid.Row="1"
                                               FontSize="11"
                                               Foreground="{DynamicResource SystemFillColorSolidNeutralBrush}"
                                               Text="{I18N AutoShutdownHint}" />
                                </ui:Grid>
                                <Grid Grid.Column="2" Margin="0,0,12,0">
                                    <ui:ToggleSwitch IsChecked="{Binding IsUseAutoShutdown, Mode=TwoWay}" />
                                </Grid>
                            </ui:Grid>
                        </ui:CardExpander.Header>
                        <controls:AdaptiveSplitPanel x:Name="AutoShutdownOptionsPanel"
                                                     Margin="56,0,28,8"
                                                     HorizontalAlignment="Stretch"
                                                     HorizontalSpacing="24"
                                                     IsEnabled="{Binding IsUseAutoShutdown}"
                                                     VerticalSpacing="12">
                            <controls:AdaptiveSplitPanel.Style>
                                <Style TargetType="{x:Type controls:AdaptiveSplitPanel}">
                                    <Setter Property="Opacity" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUseAutoShutdown}" Value="False">
                                            <Setter Property="Opacity" Value="0.45" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:AdaptiveSplitPanel.Style>
                            <ui:StackPanel Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Text="{I18N AutoShutdownTime}" />
                                <ui:StackPanel Margin="16,0,0,0"
                                               Orientation="Horizontal"
                                               Spacing="8">
                                    <controls:CompactNumberBox Width="112"
                                                               Maximum="23"
                                                               Minimum="0"
                                                               Value="{Binding AutoShutdownTimeHour, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Text=":" />
                                    <controls:CompactNumberBox Width="112"
                                                               Maximum="59"
                                                               Minimum="0"
                                                               Value="{Binding AutoShutdownTimeMinute, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </ui:StackPanel>
                            </ui:StackPanel>
                            <CheckBox VerticalAlignment="Center"
                                      Content="{I18N AutoShutdownAfterTranscode}"
                                      IsChecked="{Binding IsAutoShutdownAfterTranscode, Mode=TwoWay}" />
                            <CheckBox VerticalAlignment="Center"
                                      Content="{I18N AutoShutdownComputer}"
                                      IsChecked="{Binding IsAutoShutdownComputer, Mode=TwoWay}" />
                        </controls:AdaptiveSplitPanel>
                    </ui:CardExpander>
                    <TextBlock Margin="4,0,0,4"
                               FontSize="14"
                               Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                               Text="{I18N NetworkSettings}" />
                    <ui:Card x:Name="PlatformAccessCard">
                        <Grid MinHeight="35">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock MinWidth="26"
                                           Margin="4,0,0,0"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Top"
                                           FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                           FontSize="18"
                                           Text="{x:Static ui:FontSymbols.Globe}" />
                            </Grid>
                            <ui:StackPanel Grid.Column="1" Spacing="8">
                                <TextBlock FontWeight="SemiBold" Text="{I18N PlatformAccess}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="{I18N DomesticCookiePlatforms}" />
                                    <TextBlock Grid.Row="0"
                                               Grid.Column="1"
                                               Text="{Binding ChinaCookiePlatformsText}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="0"
                                               Margin="0,5,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="{I18N OverseasCookiePlatforms}" />
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="1"
                                               Margin="0,5,0,0"
                                               Text="{Binding OverseaCookiePlatformsText}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="2"
                                               Grid.Column="0"
                                               Margin="0,5,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="{I18N NoCookie}" />
                                    <TextBlock Grid.Row="2"
                                               Grid.Column="1"
                                               Margin="0,5,0,0"
                                               Text="{Binding DirectStreamPlatformsText}"
                                               TextWrapping="Wrap" />
                                </Grid>
                                <TextBlock FontSize="11"
                                           Foreground="{DynamicResource SystemFillColorSolidNeutralBrush}"
                                           Text="{I18N ProxyAppliesToPlatformRequests}"
                                           TextWrapping="Wrap" />
                            </ui:StackPanel>
                        </Grid>
                    </ui:Card>
                    <ui:CardExpander x:Name="ProxyExpander">
                        <ui:CardExpander.Header>
                            <ui:Grid ColumnDefinitions="Auto,*,Auto">
                                <Grid Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock MinWidth="26"
                                               Margin="4,0,0,0"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                               FontSize="18"
                                               Text="{x:Static ui:FontSymbols.VPN}" />
                                </Grid>
                                <ui:Grid Grid.Column="1" RowDefinitions="Auto,Auto">
                                    <TextBlock Grid.Row="0" Text="{I18N UseProxy}" />
                                    <TextBlock Grid.Row="1"
                                               FontSize="11"
                                               Foreground="{DynamicResource SystemFillColorSolidNeutralBrush}"
                                               Text="{I18N UseProxyHint}" />
                                </ui:Grid>
                                <Grid Grid.Column="2" Margin="0,0,12,0">
                                    <ui:ToggleSwitch IsChecked="{Binding IsUseProxy, Mode=TwoWay}" />
                                </Grid>
                            </ui:Grid>
                        </ui:CardExpander.Header>
                        <ui:StackPanel x:Name="ProxyOptionsPanel" IsEnabled="{Binding IsUseProxy}" Spacing="12">
                            <ui:Grid Margin="42,0,28,0" ColumnDefinitions="Auto,*,Auto">
                                <TextBlock VerticalAlignment="Center" Text="{I18N ProxyHostAndPort}" />
                                <ui:TextBox Grid.Column="1"
                                            Margin="8,0,0,0"
                                            PlaceholderText="127.0.0.1:7890"
                                            Text="{Binding ProxyUrl, Mode=TwoWay}" />
                                <Button Grid.Column="2"
                                        Margin="8,0,0,0"
                                        Command="{Binding CheckProxyUrlCommand}"
                                        Content="{I18N CheckConnectivity}" />
                            </ui:Grid>
                        </ui:StackPanel>
                    </ui:CardExpander>
                    <ui:CardExpander x:Name="CookieSettingsExpander">
                        <ui:CardExpander.Header>
                            <ui:Grid ColumnDefinitions="Auto,*,Auto">
                                <Grid Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock MinWidth="26"
                                               Margin="4,0,0,0"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                               FontSize="18"
                                               Text="{x:Static ui:FontSymbols.Rename}" />
                                </Grid>
                                <ui:Grid Grid.Column="1" RowDefinitions="Auto,Auto">
                                    <TextBlock Grid.Row="0" Text="{I18N UseCookie}" />
                                    <TextBlock Grid.Row="1"
                                               FontSize="11"
                                               Foreground="{DynamicResource SystemFillColorSolidNeutralBrush}"
                                               Text="{I18N UseCookieHint}" />
                                </ui:Grid>
                                <Grid Grid.Column="2" Margin="0,0,12,0">
                                    <!--  EMPTY  -->
                                </Grid>
                            </ui:Grid>
                        </ui:CardExpander.Header>
                        <ui:StackPanel Spacing="14">
                            <ui:Grid Margin="52,0,40,0">
                                <TextBlock VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Text="{I18N DomesticCookiePlatforms}" />
                            </ui:Grid>
                            <ItemsControl Margin="52,0,28,0" ItemsSource="{Binding DomesticCookiePlatforms}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:Grid Margin="0,0,18,8" ColumnDefinitions="96,*,Auto">
                                            <TextBlock Grid.Column="0"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding DisplayName, StringFormat={}{0}:}"
                                                       TextWrapping="Wrap" />
                                            <ui:PasswordBox Grid.Column="1"
                                                            MinWidth="120"
                                                            Margin="8,0,0,0"
                                                            Password="{Binding Cookie, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            PlaceholderText="{I18N UseCookieEnterHint}"
                                                            RevealButtonEnabled="True" />
                                            <Button Grid.Column="2"
                                                    MinWidth="56"
                                                    Margin="10,0,0,0"
                                                    Command="{Binding DataContext.AcquirePlatformCookieCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding}"
                                                    Content="{I18N AcquireCookie}"
                                                    FocusVisualStyle="{x:Null}" />
                                        </ui:Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Height="1"
                                    Margin="52,0,40,0"
                                    Background="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    Opacity="0.65" />
                            <ui:Grid Margin="52,0,40,0">
                                <TextBlock VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Text="{I18N OverseasCookiePlatforms}" />
                            </ui:Grid>
                            <ItemsControl Margin="52,0,28,0" ItemsSource="{Binding OverseasCookiePlatforms}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:Grid Margin="0,0,18,8" ColumnDefinitions="96,*,Auto">
                                            <TextBlock Grid.Column="0"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding DisplayName, StringFormat={}{0}:}"
                                                       TextWrapping="Wrap" />
                                            <ui:PasswordBox Grid.Column="1"
                                                            MinWidth="120"
                                                            Margin="8,0,0,0"
                                                            Password="{Binding Cookie, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            PlaceholderText="{I18N UseCookieEnterHint}"
                                                            RevealButtonEnabled="True" />
                                            <Button Grid.Column="2"
                                                    MinWidth="56"
                                                    Margin="10,0,0,0"
                                                    Command="{Binding DataContext.AcquirePlatformCookieCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding}"
                                                    Content="{I18N AcquireCookie}"
                                                    FocusVisualStyle="{x:Null}" />
                                        </ui:Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </ui:StackPanel>
                    </ui:CardExpander>
                    <ui:CardExpander x:Name="UserAgentExpander">
                        <ui:CardExpander.Header>
                            <ui:Grid ColumnDefinitions="Auto,*,Auto">
                                <Grid Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock MinWidth="26"
                                               Margin="4,0,0,0"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                               FontSize="18"
                                               Text="{x:Static ui:FontSymbols.EaseOfAccess}" />
                                </Grid>
                                <ui:Grid Grid.Column="1" RowDefinitions="Auto,Auto">
                                    <TextBlock Grid.Row="0" Text="{I18N UserAgent}" />
                                    <TextBlock Grid.Row="1"
                                               FontSize="11"
                                               Foreground="{DynamicResource SystemFillColorSolidNeutralBrush}"
                                               Text="{I18N UserAgentHint}" />
                                </ui:Grid>
                            </ui:Grid>
                        </ui:CardExpander.Header>
                        <ui:StackPanel Spacing="12">
                            <ui:Grid Margin="42,0,28,0" ColumnDefinitions="Auto,*">
                                <TextBlock VerticalAlignment="Center" Text="{I18N UserAgent}" />
                                <ui:TextBox Grid.Column="1"
                                            Margin="8,0,0,0"
                                            PlaceholderText="{I18N UserAgentEnterHint}"
                                            Text="{Binding UserAgent, Mode=TwoWay}" />
                            </ui:Grid>
                        </ui:StackPanel>
                    </ui:CardExpander>
                    <FrameworkElement Height="10" />
                </ui:StackPanel>
                <Grid x:Name="SettingsUiXPanel"
                      Visibility="Collapsed">
                    <Grid.Resources>
                        <StaticResource x:Key="EmerdeTextInputBorderBrush" ResourceKey="UiXStrongStrokeBrush" />
                        <StaticResource x:Key="EmerdeTextInputFocusedBorderBrush" ResourceKey="UiXSelectionStrokeBrush" />
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="TextWrapping" Value="Wrap" />
                            <Setter Property="TextTrimming" Value="None" />
                        </Style>
                        <Style BasedOn="{StaticResource {x:Type ComboBox}}" TargetType="{x:Type ComboBox}">
                            <Setter Property="BorderBrush" Value="{DynamicResource EmerdeTextInputBorderBrush}" />
                        </Style>
                        <Style BasedOn="{StaticResource {x:Type controls:CompactNumberBox}}" TargetType="{x:Type controls:CompactNumberBox}">
                            <Setter Property="BorderBrush" Value="{DynamicResource EmerdeTextInputBorderBrush}" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        </Style>
                        <Style BasedOn="{StaticResource {x:Type ui:ToggleSwitch}}" TargetType="{x:Type ui:ToggleSwitch}">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        </Style>
                    </Grid.Resources>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="0,0,0,14">
                        <RadioButton Click="SettingsFocusButtonClick"
                                     CommandParameter="0"
                                     Content="{I18N UiXWorkspaceAll}"
                                     GroupName="SettingsFocus"
                                     IsChecked="True"
                                     Style="{StaticResource SettingsFocusButtonStyle}" />
                        <RadioButton Click="SettingsFocusButtonClick"
                                     CommandParameter="1"
                                     Content="{I18N AppearanceSettings}"
                                     GroupName="SettingsFocus"
                                     Style="{StaticResource SettingsFocusButtonStyle}" />
                        <RadioButton Click="SettingsFocusButtonClick"
                                     CommandParameter="2"
                                     Content="{I18N UiXWorkspaceRun}"
                                     GroupName="SettingsFocus"
                                     Style="{StaticResource SettingsFocusButtonStyle}" />
                        <RadioButton Click="SettingsFocusButtonClick"
                                     CommandParameter="3"
                                     Content="{I18N UiXWorkspaceRecording}"
                                     GroupName="SettingsFocus"
                                     Style="{StaticResource SettingsFocusButtonStyle}" />
                        <RadioButton Click="SettingsFocusButtonClick"
                                     CommandParameter="4"
                                     Content="{I18N UiXWorkspaceOutput}"
                                     GroupName="SettingsFocus"
                                     Style="{StaticResource SettingsFocusButtonStyle}" />
                        <RadioButton Click="SettingsFocusButtonClick"
                                     CommandParameter="5"
                                     Content="{I18N LongRunningSettings}"
                                     GroupName="SettingsFocus"
                                     Style="{StaticResource SettingsFocusButtonStyle}" />
                        <RadioButton Click="SettingsFocusButtonClick"
                                     CommandParameter="6"
                                     Content="{I18N NetworkSettings}"
                                     GroupName="SettingsFocus"
                                     Style="{StaticResource SettingsFocusButtonStyle}" />
                    </WrapPanel>
                    <Grid x:Name="SettingsUiXColumns"
                          Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="SettingsUiXLeftColumnDefinition" Width="*" />
                            <ColumnDefinition x:Name="SettingsUiXGapColumnDefinition" Width="16" />
                            <ColumnDefinition x:Name="SettingsUiXRightColumnDefinition" Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="SettingsUiXLeftColumn"
                                    Grid.Column="0"
                                    HorizontalAlignment="Stretch" />
                        <StackPanel x:Name="SettingsUiXRightColumn"
                                    Grid.Column="2"
                                    HorizontalAlignment="Stretch" />
                    </Grid>
                    <ui:StackPanel x:Name="SettingsUiXBottomPanel"
                                   Grid.Row="2"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Stretch"
                                   Spacing="8" />
                </Grid>
                </Grid>
            </fluentControls:SmoothScrollViewer>
            <Border Height="6"
                    VerticalAlignment="Top"
                    Panel.ZIndex="20"
                    Style="{StaticResource UiXSettingsFadeStyle}"
                    IsHitTestVisible="False"
                    OpacityMask="{StaticResource TopEdgeFadeOpacityMask}" />
            <Border Height="6"
                    VerticalAlignment="Bottom"
                    Panel.ZIndex="20"
                    Style="{StaticResource UiXSettingsFadeStyle}"
                    IsHitTestVisible="False"
                    OpacityMask="{StaticResource BottomEdgeFadeOpacityMask}" />
        </ui:Grid>
    </Grid>
</UserControl>
