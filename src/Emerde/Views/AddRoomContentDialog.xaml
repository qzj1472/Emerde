<vio:ContentDialog x:Class="Emerde.Views.AddRoomContentDialog"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:controls="clr-namespace:Emerde.Controls"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:local="clr-namespace:Emerde.Views"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                   xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
                   Title="{I18N AddRoom}"
                   d:DesignHeight="NaN"
                   d:DesignWidth="NaN"
                   CloseButtonText="{I18N ButtonOfClose}"
                   DefaultButton="Primary"
                   FontSize="14"
                   PrimaryButtonClick="OnPrimaryButtonClick"
                   PrimaryButtonText="{I18N ButtonOfAdd}"
                   SnapsToDevicePixels="True"
                   Style="{StaticResource EmerdeContentDialogStyle}"
                   UseLayoutRounding="True"
                   mc:Ignorable="d">
    <Grid x:Name="AddRoomSurface"
          ClipToBounds="True"
          Focusable="False"
          FocusVisualStyle="{x:Null}"
          controls:MotionAssist.IsEntranceEnabled="True"
          controls:MotionAssist.EntranceOffsetY="8"
          controls:MotionAssist.EntranceScale="0.98">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:StackPanel Grid.Row="0" Spacing="10">
            <ui:StackPanel.Style>
                <Style TargetType="{x:Type ui:StackPanel}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsUiXEnabled}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ui:StackPanel.Style>
            <TextBlock Style="{StaticResource EmerdeDialogSectionTitleTextStyle}" Text="{I18N EnterRoomUrl}" />
            <Grid>
                <ui:TextBox x:Name="RoomUrlTextBox"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            FocusVisualStyle="{x:Null}"
                            IsKeyboardFocusWithinChanged="RoomUrlTextBoxFocusWithinChanged"
                            PlaceholderText="https://live.douyin.com/xxx / https://live.bilibili.com/xxx"
                            Text="{Binding Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <ui:TextBox.Resources>
                        <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="Transparent" />
                    </ui:TextBox.Resources>
                </ui:TextBox>
                <Border x:Name="RoomUrlInputBorder"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                        IsHitTestVisible="False" />
            </Grid>
            <Border x:Name="RoomDetectionSummary"
                    Padding="14,10"
                    BorderThickness="0"
                    Style="{StaticResource EmerdeDialogSectionStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Margin="0,0,12,4"
                               Style="{StaticResource EmerdeDialogSecondaryTextStyle}"
                               Text="{I18N Platform}" />
                    <TextBlock Grid.Row="0"
                               Grid.Column="1"
                               Margin="0,0,0,4"
                               Text="{Binding DetectedPlatformName}">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource EmerdeDialogSectionTitleTextStyle}">
                                <Setter Property="Foreground" Value="{DynamicResource UiXTextSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDetectedPlatformSupported}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource UiXTextPrimaryBrush}" />
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasRoomUrl}" Value="True" />
                                            <Condition Binding="{Binding IsDetectedPlatformSupported}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Foreground" Value="{DynamicResource UiXDangerForegroundBrush}" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Margin="0,0,12,0"
                               Style="{StaticResource EmerdeDialogSecondaryTextStyle}"
                               Text="{I18N Supported}" />
                    <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               Style="{StaticResource EmerdeDialogBodyTextStyle}"
                               Text="{Binding SupportedPlatformsText}" />
                </Grid>
            </Border>
            <ui:StackPanel Margin="0,2,0,0" Spacing="6">
                <CheckBox Content="{Binding SkipValidationText}"
                          IsChecked="{Binding IsForcedAdd, Mode=TwoWay}" />
                <CheckBox Content="{Binding FollowGlobalSettingsText}"
                          IsChecked="{Binding IsFollowGlobalSettings, Mode=TwoWay}" />
            </ui:StackPanel>
        </ui:StackPanel>
        <StackPanel Grid.Row="0">
            <StackPanel.Resources>
                <StaticResource x:Key="EmerdeTextInputBorderBrush" ResourceKey="UiXStrongStrokeBrush" />
                <StaticResource x:Key="EmerdeTextInputFocusedBorderBrush" ResourceKey="UiXSelectionStrokeBrush" />
            </StackPanel.Resources>
            <StackPanel.Style>
                <Style TargetType="{x:Type StackPanel}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsUiXEnabled}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <Border Padding="20"
                    Background="{DynamicResource UiXDialogSectionBrush}"
                    CornerRadius="{StaticResource UiXSurfaceCornerRadius}">
                <StackPanel>
                    <TextBlock FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource UiXTextPrimaryBrush}"
                               Text="{I18N EnterRoomUrl}" />
                    <TextBlock Margin="0,4,0,14"
                               FontSize="12"
                               Foreground="{DynamicResource UiXTextSecondaryBrush}"
                               Text="{Binding SupportedPlatformsText}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding SupportedPlatformsText}" />
                    <Grid Height="44">
                        <ui:TextBox x:Name="UiXRoomUrlTextBox"
                                    Background="{DynamicResource UiXDialogElevatedBrush}"
                                    BorderBrush="{DynamicResource EmerdeTextInputBorderBrush}"
                                    BorderThickness="1"
                                    FocusVisualStyle="{x:Null}"
                                    IsKeyboardFocusWithinChanged="RoomUrlTextBoxFocusWithinChanged"
                                    PlaceholderText="https://live.douyin.com/xxx / https://live.bilibili.com/xxx"
                                    Text="{Binding Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="{x:Type Ellipse}">
                                        <Setter Property="Fill" Value="{DynamicResource UiXTextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDetectedPlatformSupported}" Value="True">
                                                 <Setter Property="Fill" Value="{DynamicResource UiXDialogLiveBrush}" />
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding HasRoomUrl}" Value="True" />
                                                    <Condition Binding="{Binding IsDetectedPlatformSupported}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Fill" Value="{DynamicResource UiXDangerForegroundBrush}" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock FontWeight="SemiBold"
                                       Foreground="{DynamicResource UiXTextPrimaryBrush}"
                                       Text="{Binding DetectedPlatformName}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  Content="{Binding SkipValidationText}"
                                  IsChecked="{Binding IsForcedAdd, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>
            <Border Margin="0,14,0,0"
                    Padding="8"
                    Background="{DynamicResource UiXDialogSectionBrush}"
                    CornerRadius="{StaticResource UiXSurfaceCornerRadius}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton Grid.Column="0"
                                  MinHeight="40"
                                  Margin="0,0,4,0"
                                  Content="{Binding FollowGlobalSettingsText}"
                                  IsChecked="{Binding IsFollowGlobalSettings, Mode=TwoWay}" />
                    <ToggleButton Grid.Column="1"
                                  MinHeight="40"
                                  Margin="4,0,0,0"
                                  Content="{I18N Custom}"
                                  IsChecked="{Binding IsUsingCustomSettings, Mode=TwoWay}" />
                </Grid>
            </Border>
        </StackPanel>
        <ContentControl Grid.Row="1"
                        Margin="0,10,0,0"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Content="{Binding SettingsEditor}">
            <ContentControl.Style>
                <Style TargetType="{x:Type ContentControl}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFollowGlobalSettings}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
        <Grid x:Name="RoomLoadingOverlay"
              Grid.RowSpan="2"
              Panel.ZIndex="1"
              Focusable="False">
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSubmitting}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    Opacity="0.94" />
            <ui:StackPanel HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Spacing="10">
                <Image x:Name="LoadingFrame"
                       Width="168"
                       Height="168"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       SnapsToDevicePixels="True"
                       Stretch="Uniform" />
                <ProgressBar x:Name="LoadingFallbackProgressBar"
                             Width="168"
                             Height="4"
                             Visibility="Collapsed"
                             IsIndeterminate="True"
                             Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                <TextBlock HorizontalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{I18N CookieLoginLoading}" />
            </ui:StackPanel>
        </Grid>
    </Grid>
</vio:ContentDialog>
