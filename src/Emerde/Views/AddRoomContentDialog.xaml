<vio:ContentDialog x:Class="Emerde.Views.AddRoomContentDialog"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:controls="clr-namespace:Emerde.Controls"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:local="clr-namespace:Emerde.Views"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                   xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
                   Title="{I18N AddRoom}"
                   d:DesignHeight="NaN"
                   d:DesignWidth="NaN"
                   CloseButtonText="{I18N ButtonOfClose}"
                   DefaultButton="Primary"
                   FontSize="14"
                   PrimaryButtonClick="OnPrimaryButtonClick"
                   PrimaryButtonText="{I18N ButtonOfAdd}"
                   SnapsToDevicePixels="True"
                   Style="{StaticResource DefaultVioletaContentDialogStyle}"
                   UseLayoutRounding="True"
                   mc:Ignorable="d">
    <Grid x:Name="AddRoomSurface"
          MinWidth="420"
          ClipToBounds="True"
          Focusable="False"
          FocusVisualStyle="{x:Null}"
          controls:MotionAssist.IsEntranceEnabled="True"
          controls:MotionAssist.EntranceOffsetY="8"
          controls:MotionAssist.EntranceScale="0.98">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:StackPanel Grid.Row="0" Spacing="10">
            <TextBlock Text="{I18N EnterRoomUrl}" />
            <Grid>
                <ui:TextBox x:Name="RoomUrlTextBox"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            FocusVisualStyle="{x:Null}"
                            IsKeyboardFocusWithinChanged="RoomUrlTextBoxFocusWithinChanged"
                            PlaceholderText="https://live.douyin.com/xxx / https://live.bilibili.com/xxx"
                            Text="{Binding Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <ui:TextBox.Resources>
                        <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="Transparent" />
                    </ui:TextBox.Resources>
                </ui:TextBox>
                <Border x:Name="RoomUrlInputBorder"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                        IsHitTestVisible="False" />
            </Grid>
            <Border x:Name="RoomDetectionSummary"
                    Padding="10,8"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    CornerRadius="{StaticResource Win11ControlCornerRadius}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Margin="0,0,12,4"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{I18N Platform}" />
                    <TextBlock Grid.Row="0"
                               Grid.Column="1"
                               Margin="0,0,0,4"
                               FontWeight="SemiBold"
                               Text="{Binding DetectedPlatformName}" />
                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Margin="0,0,12,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{I18N Supported}" />
                    <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               Text="{Binding SupportedPlatformsText}"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>
            <ui:StackPanel Margin="0,2,0,0" Spacing="6">
                <CheckBox Content="{Binding SkipValidationText}"
                          IsChecked="{Binding IsForcedAdd, Mode=TwoWay}" />
                <CheckBox Content="{Binding FollowGlobalSettingsText}"
                          IsChecked="{Binding IsFollowGlobalSettings, Mode=TwoWay}" />
            </ui:StackPanel>
        </ui:StackPanel>
        <ContentControl Grid.Row="1"
                        Margin="0,10,0,0"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Content="{Binding SettingsEditor}">
            <ContentControl.Style>
                <Style TargetType="{x:Type ContentControl}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFollowGlobalSettings}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
        <Grid x:Name="RoomLoadingOverlay"
              Grid.RowSpan="2"
              Panel.ZIndex="1"
              Focusable="False">
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSubmitting}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    Opacity="0.94" />
            <ui:StackPanel HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Spacing="10">
                <Image x:Name="LoadingFrame"
                       Width="168"
                       Height="168"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       SnapsToDevicePixels="True"
                       Stretch="Uniform" />
                <ProgressBar x:Name="LoadingFallbackProgressBar"
                             Width="168"
                             Height="4"
                             Visibility="Collapsed"
                             IsIndeterminate="True"
                             Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                <TextBlock HorizontalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{I18N CookieLoginLoading}" />
            </ui:StackPanel>
        </Grid>
    </Grid>
</vio:ContentDialog>
