<UserControl x:Class="Emerde.Views.ExtensionCenterWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Emerde.Controls"
             xmlns:c="http://schemas.github.com/computedconverters/2024/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:Emerde.Views"
             FontSize="14"
             AllowDrop="True"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             DragEnter="ExtensionCenterDragEnter"
             DragLeave="ExtensionCenterDragLeave"
             DragOver="ExtensionCenterDragOver"
             Drop="ExtensionCenterDrop"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="ExtensionActionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
        <Style x:Key="ExtensionIconButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ExtensionActionButtonStyle}">
            <Setter Property="Width" Value="34" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="ExtensionSecondaryTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="17" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.StatusOfIsUiXEnabled, RelativeSource={RelativeSource AncestorType={x:Type views:MainWindow}}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource UiXTextSecondaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ExtensionPageTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.StatusOfIsUiXEnabled, RelativeSource={RelativeSource AncestorType={x:Type views:MainWindow}}}" Value="True">
                    <Setter Property="FontSize" Value="22" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="{DynamicResource UiXTextPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ExtensionPageSectionTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.StatusOfIsUiXEnabled, RelativeSource={RelativeSource AncestorType={x:Type views:MainWindow}}}" Value="True">
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="{DynamicResource UiXTextPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ExtensionSettingSectionTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,14,0,10" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.StatusOfIsUiXEnabled, RelativeSource={RelativeSource AncestorType={x:Type views:MainWindow}}}" Value="True">
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="{DynamicResource UiXTextPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ExtensionSettingLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="ExtensionPasswordInputStyle" TargetType="{x:Type ui:PasswordBox}" BasedOn="{StaticResource {x:Type ui:PasswordBox}}">
            <Style.Resources>
                <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="Transparent" />
            </Style.Resources>
            <Setter Property="Background" Value="{DynamicResource EmerdeCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmerdeExtensionInputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Effect" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource EmerdeExtensionInputBorderBrush}" />
                    <Setter Property="Effect" Value="{x:Null}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                    <Setter Property="Effect" Value="{x:Null}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ExtensionCardStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource EmerdePanelBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource Win11ControlCornerRadius}" />
            <Setter Property="Padding" Value="16" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.StatusOfIsUiXEnabled, RelativeSource={RelativeSource AncestorType={x:Type views:MainWindow}}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource UiXCardBrush}" />
                    <Setter Property="BorderThickness" Value="0" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DataContext.StatusOfIsUiXEnabled, RelativeSource={RelativeSource AncestorType={x:Type views:MainWindow}}}" Value="True" />
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource UiXCardHoverBrush}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ExtensionListBoxStyle" TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBox}">
                        <ScrollViewer Background="Transparent"
                                      BorderBrush="Transparent"
                                      BorderThickness="0"
                                      CanContentScroll="False"
                                      Focusable="False"
                                      FocusVisualStyle="{x:Null}"
                                      HorizontalScrollBarVisibility="Disabled"
                                      IsDeferredScrollingEnabled="False"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter Margin="20,0,20,14" />
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="ExtensionSettingTemplate">
            <ui:Grid MinHeight="58" Margin="0,0,0,14" ColumnDefinitions="132,*" RowDefinitions="Auto,Auto" Visibility="{Binding IsVisible, Converter={x:Static c:BoolToVisibilityConverter.Instance}}">
                <TextBlock Grid.Row="0"
                           Grid.ColumnSpan="2"
                           Style="{StaticResource ExtensionSettingSectionTitleStyle}"
                           Text="{Binding Section}"
                           Visibility="{Binding ShowSectionHeader, Converter={x:Static c:BoolToVisibilityConverter.Instance}}" />
                <ui:StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,14,0" Spacing="2">
                    <TextBlock Style="{StaticResource ExtensionSettingLabelStyle}" Text="{Binding Label}" />
                    <TextBlock Style="{StaticResource ExtensionSecondaryTextStyle}" Text="{Binding Description}" />
                </ui:StackPanel>
                <ui:PasswordBox Grid.Row="1" Grid.Column="1" MinHeight="34" Password="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{I18N EnterValue}" RevealButtonEnabled="True" ToolTip="{Binding Description}">
                    <ui:PasswordBox.Style>
                        <Style TargetType="{x:Type ui:PasswordBox}" BasedOn="{StaticResource ExtensionPasswordInputStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPassword}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:PasswordBox.Style>
                </ui:PasswordBox>
                <ui:TextBox Grid.Row="1" Grid.Column="1" MinHeight="34" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{I18N EnterValue}" ToolTip="{Binding Description}">
                    <ui:TextBox.Style>
                        <Style TargetType="{x:Type ui:TextBox}" BasedOn="{StaticResource ExtensionTextInputStyle}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPassword}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                <DataTrigger Binding="{Binding IsBoolean}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                <DataTrigger Binding="{Binding IsChoice}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                <DataTrigger Binding="{Binding HasTemplateOptions}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:TextBox.Style>
                </ui:TextBox>
                <ComboBox Grid.Row="1" Grid.Column="1" MinHeight="34" ItemsSource="{Binding Options}" SelectedItem="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Description}">
                    <ComboBox.Style>
                        <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource ExtensionChoiceInputStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding IsChoice}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>
                <ui:ToggleSwitch Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" IsChecked="{Binding BooleanValue, Mode=TwoWay}" ToolTip="{Binding Description}">
                    <ui:ToggleSwitch.Style>
                        <Style TargetType="{x:Type ui:ToggleSwitch}" BasedOn="{StaticResource {x:Type ui:ToggleSwitch}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding IsBoolean}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                    </ui:ToggleSwitch.Style>
                </ui:ToggleSwitch>
                <ui:StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                    <ui:StackPanel.Style>
                        <Style TargetType="{x:Type ui:StackPanel}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding HasTemplateOptions}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                    </ui:StackPanel.Style>
                    <ui:TextBox MinHeight="34"
                                Style="{StaticResource ExtensionTextInputStyle}"
                                Text="{Binding DisplayValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="{Binding Description}" />
                    <ItemsControl ItemsSource="{Binding TemplateOptions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Height="28"
                                        MinWidth="0"
                                        Margin="0,0,6,0"
                                        Padding="8,0"
                                        Command="{Binding DataContext.AppendTemplateOptionCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                        CommandParameter="{Binding}"
                                        Content="{Binding DisplayName}"
                                         ToolTip="{Binding InsertToolTip}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ui:StackPanel>
            </ui:Grid>
        </DataTemplate>
        <DataTemplate x:Key="ExtensionCardTemplate">
            <Border x:Name="Card" Style="{StaticResource ExtensionCardStyle}" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="42" Height="42">
                            <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="{StaticResource Win11ControlCornerRadius}" />
                            <Ellipse Visibility="{Binding HasIcon, Converter={x:Static c:BoolToVisibilityConverter.Instance}}">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding IconSource}" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <ui:FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="21" Glyph="{x:Static ui:FontSymbols.AppIconDefault}">
                                <ui:FontIcon.Style>
                                    <Style TargetType="{x:Type ui:FontIcon}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasIcon}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:FontIcon.Style>
                            </ui:FontIcon>
                        </Grid>
                        <ui:StackPanel Grid.Column="1" Margin="12,0,16,0" Spacing="3">
                            <ui:StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource ExtensionSecondaryTextStyle}" Text="{Binding Version}" />
                            </ui:StackPanel>
                            <TextBlock Style="{StaticResource ExtensionSecondaryTextStyle}" Text="{Binding Description}" MaxHeight="38" />
                        </ui:StackPanel>
                        <ui:StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                            <Border Padding="8,4" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="{StaticResource Win11ControlCornerRadius}">
                                <TextBlock FontSize="12" Text="{Binding StateText}" />
                            </Border>
                            <ui:ToggleSwitch Command="{Binding DataContext.ToggleExtensionCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                             CommandParameter="{Binding}"
                                             IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                             ToolTip="{I18N ManageExtensionToggle}" />
                        </ui:StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Margin="0,14,0,0" Padding="0,12,0,0" BorderThickness="0" Visibility="Collapsed">
                        <ui:Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="{I18N ExecutionMode}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Margin="18,0,0,0" Style="{StaticResource ExtensionSecondaryTextStyle}" Text="{Binding ExecutionText}" />
                            <TextBlock Grid.Row="1" FontWeight="SemiBold" Text="{I18N Author}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="18,0,0,0" Style="{StaticResource ExtensionSecondaryTextStyle}" Text="{Binding Author}" />
                            <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="{I18N Capabilities}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="18,0,0,0" Style="{StaticResource ExtensionSecondaryTextStyle}" Text="{Binding CapabilityText}" />
                            <TextBlock Grid.Row="3" FontWeight="SemiBold" Text="{I18N Permissions}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Margin="18,0,0,0" Style="{StaticResource ExtensionSecondaryTextStyle}" Text="{Binding PermissionText}" />
                        </ui:Grid>
                    </Border>
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button Command="{Binding DataContext.ToggleExtensionDetailsCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" Style="{StaticResource ExtensionActionButtonStyle}" Content="{Binding DetailsActionText}" />
                        <ui:StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Command="{Binding DataContext.HealthCheckCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" Style="{StaticResource ExtensionActionButtonStyle}" Content="{I18N HealthCheck}" Visibility="{Binding CanHealthCheck, Converter={x:Static c:BoolToVisibilityConverter.Instance}}" />
                            <Button Command="{Binding DataContext.RemoveExtensionCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" Style="{StaticResource ExtensionActionButtonStyle}" Content="{I18N Remove}" />
                        </ui:StackPanel>
                    </Grid>
                    <ui:StackPanel x:Name="SelectedDetails" Grid.Row="3" Margin="0,16,0,0" Spacing="12" Visibility="{Binding IsExpanded, Converter={x:Static c:BoolToVisibilityConverter.Instance}}">
                            <ui:Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
                                <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="{I18N Identifier}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Margin="18,0,0,0" Style="{StaticResource ExtensionSecondaryTextStyle}" Text="{Binding Id}" />
                                <TextBlock Grid.Row="1" FontWeight="SemiBold" Text="{I18N Status}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="18,0,0,0" Style="{StaticResource ExtensionSecondaryTextStyle}" Text="{Binding StateText}" />
                                <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="{I18N Capabilities}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Margin="18,0,0,0" Style="{StaticResource ExtensionSecondaryTextStyle}" Text="{Binding CapabilityText}" />
                                <TextBlock Grid.Row="3" FontWeight="SemiBold" Text="{I18N Permissions}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Margin="18,0,0,0" Style="{StaticResource ExtensionSecondaryTextStyle}" Text="{Binding PermissionText}" />
                            </ui:Grid>
                            <TextBlock Style="{StaticResource ExtensionSecondaryTextStyle}" Text="{Binding Description}" />
                            <Border Background="#14D83B01" CornerRadius="{StaticResource Win11ControlCornerRadius}" Padding="12" Visibility="{Binding RequiresTrustWarning, Converter={x:Static c:BoolToVisibilityConverter.Instance}}">
                                <TextBlock Foreground="#D83B01" Text="{I18N InProcessTrustWarning}" TextWrapping="Wrap" />
                            </Border>
                            <ItemsControl ItemsSource="{Binding DataContext.SelectedUiContributions, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ContentPresenter Content="{Binding Content}"
                                                          Focusable="False"
                                                          FocusVisualStyle="{x:Null}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ui:StackPanel Spacing="10" Visibility="{Binding HasSettings, Converter={x:Static c:BoolToVisibilityConverter.Instance}}">
                                <TextBlock Style="{StaticResource ExtensionPageSectionTitleStyle}" Text="{I18N ExtensionSettings}" />
                                <ItemsControl ItemsSource="{Binding PrimarySettings}"
                                              ItemTemplate="{StaticResource ExtensionSettingTemplate}"
                                              Visibility="{Binding HasOnlyPrimarySettings, Converter={x:Static c:BoolToVisibilityConverter.Instance}}" />
                                <ui:Grid ColumnDefinitions="*,24,*"
                                         Visibility="{Binding HasSecondarySettings, Converter={x:Static c:BoolToVisibilityConverter.Instance}}">
                                    <ItemsControl Grid.Column="0" ItemsSource="{Binding PrimarySettings}" ItemTemplate="{StaticResource ExtensionSettingTemplate}" />
                                    <ItemsControl Grid.Column="2"
                                                  ItemsSource="{Binding SecondarySettings}"
                                                  ItemTemplate="{StaticResource ExtensionSettingTemplate}" />
                                </ui:Grid>
                                <Button HorizontalAlignment="Right" Command="{Binding DataContext.SaveSettingsCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" Style="{StaticResource ExtensionActionButtonStyle}" Content="{I18N SaveSettings}" />
                            </ui:StackPanel>
                    </ui:StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid ClipToBounds="True" controls:MotionAssist.IsEntranceEnabled="True" controls:MotionAssist.EntranceOffsetY="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:Grid Grid.Row="0"
                 Margin="20,10,22,14"
                 ColumnDefinitions="*,Auto,Auto,Auto">
            <ui:StackPanel Spacing="3">
                <TextBlock Style="{StaticResource ExtensionPageTitleStyle}" Text="{I18N Extensions}" />
                <TextBlock Style="{StaticResource ExtensionSecondaryTextStyle}" Text="{I18N ExtensionsDescription}" />
            </ui:StackPanel>
            <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding OpenExtensionsFolderCommand}" Style="{StaticResource ExtensionIconButtonStyle}" ToolTip="{I18N OpenExtensionsFolder}">
                <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" Glyph="{x:Static ui:FontSymbols.FolderOpen}" />
            </Button>
            <Button Grid.Column="2" Margin="8,0,0,0" Command="{Binding RefreshCommand}" Style="{StaticResource ExtensionIconButtonStyle}" ToolTip="{I18N RefreshExtensions}">
                <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" Glyph="{x:Static ui:FontSymbols.Sync}" />
            </Button>
            <Button Grid.Column="3" Margin="8,0,0,0" Command="{Binding InstallCommand}" Style="{StaticResource ExtensionActionButtonStyle}">
                <ui:StackPanel Orientation="Horizontal" Spacing="6"><ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" Glyph="{x:Static ui:FontSymbols.Add}" /><TextBlock Text="{I18N InstallExtension}" /></ui:StackPanel>
            </Button>
        </ui:Grid>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <ui:Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <ui:Grid.Style>
                    <Style TargetType="{x:Type ui:Grid}">
                        <Setter Property="Margin" Value="20,0,20,10" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.StatusOfIsUiXEnabled, RelativeSource={RelativeSource AncestorType={x:Type views:MainWindow}}}" Value="True">
                                <Setter Property="Margin" Value="20,8,20,12" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:Grid.Style>
                <ui:StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Style="{StaticResource ExtensionPageSectionTitleStyle}" Text="{I18N InstalledExtensionSection}" />
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource ExtensionSecondaryTextStyle}" Text="{Binding EnabledExtensionSummary}" />
                </ui:StackPanel>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ExtensionSecondaryTextStyle}" Text="{I18N DropExtensionPackage}" />
            </ui:Grid>
            <Grid Grid.Row="1">
                <ListBox ItemsSource="{Binding Extensions}"
                         KeyboardNavigation.DirectionalNavigation="None"
                         KeyboardNavigation.TabNavigation="None"
                         SelectedItem="{Binding SelectedExtension, Mode=TwoWay}"
                         Style="{StaticResource ExtensionListBoxStyle}"
                         ItemTemplate="{StaticResource ExtensionCardTemplate}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                        <Border Background="Transparent" Padding="0">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
                <Border Background="{DynamicResource EmerdePanelBrush}" Padding="24">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="CornerRadius" Value="{StaticResource Win11ControlCornerRadius}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasExtensions}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DataContext.StatusOfIsUiXEnabled, RelativeSource={RelativeSource AncestorType={x:Type views:MainWindow}}}" Value="True">
                                    <Setter Property="Margin" Value="20,0,20,10" />
                                    <Setter Property="CornerRadius" Value="{StaticResource UiXPageSurfaceCornerRadius}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ui:StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                        <ui:FontIcon HorizontalAlignment="Center" FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="30" Glyph="{x:Static ui:FontSymbols.AppIconDefault}" />
                        <TextBlock HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="{I18N NoExtensionsInstalled}" />
                        <TextBlock HorizontalAlignment="Center" Style="{StaticResource ExtensionSecondaryTextStyle}" Text="{I18N NoExtensionsInstalledDescription}" TextAlignment="Center" />
                    </ui:StackPanel>
                </Border>
                <Border Panel.ZIndex="5" Background="{DynamicResource EmerdePanelBrush}" Padding="16" Visibility="{Binding IsDragging, Converter={x:Static c:BoolToVisibilityConverter.Instance}}">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Margin" Value="0,0,0,10" />
                            <Setter Property="CornerRadius" Value="{StaticResource Win11ControlCornerRadius}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.StatusOfIsUiXEnabled, RelativeSource={RelativeSource AncestorType={x:Type views:MainWindow}}}" Value="True">
                                    <Setter Property="Margin" Value="20,0,20,10" />
                                    <Setter Property="CornerRadius" Value="{StaticResource UiXPageSurfaceCornerRadius}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ui:StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                        <ui:FontIcon HorizontalAlignment="Center" FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="30" Glyph="{x:Static ui:FontSymbols.Add}" />
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="{I18N DropToInstallExtension}" />
                        <TextBlock Style="{StaticResource ExtensionSecondaryTextStyle}" Text="{I18N SupportedExtensionPackages}" />
                    </ui:StackPanel>
                </Border>
            </Grid>
        </Grid>
        <Border Grid.Row="1" Panel.ZIndex="10" Margin="0,0,0,10" Padding="12" HorizontalAlignment="Center" VerticalAlignment="Bottom" Background="{DynamicResource EmerdePanelBrush}" CornerRadius="{StaticResource Win11ControlCornerRadius}" Visibility="{Binding HasOperationMessage, Converter={x:Static c:BoolToVisibilityConverter.Instance}}">
            <TextBlock Text="{Binding OperationMessage}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Style.Triggers><DataTrigger Binding="{Binding OperationFailed}" Value="True"><Setter Property="Foreground" Value="#D83B01" /></DataTrigger></Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
