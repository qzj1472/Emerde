<Window x:Class="Emerde.Views.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Emerde.Controls"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Width="1"
        Height="1"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        Topmost="True"
        UseLayoutRounding="True"
        WindowStyle="None">
    <Window.Resources>
        <Style x:Key="TrayMenuItemStyle"
               TargetType="{x:Type MenuItem}"
               BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="controls:MotionAssist.IsPressEnabled" Value="True" />
            <Setter Property="controls:MotionAssist.HoverScale" Value="1.006" />
            <Setter Property="controls:MotionAssist.PressScale" Value="0.992" />
        </Style>
        <Style x:Key="PrimaryTrayMenuItemStyle"
               TargetType="{x:Type MenuItem}"
               BasedOn="{StaticResource TrayMenuItemStyle}">
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="ToggleTrayMenuItemStyle"
               TargetType="{x:Type MenuItem}"
               BasedOn="{StaticResource TrayMenuItemStyle}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid x:Name="PlacementTarget">
        <Grid.ContextMenu>
            <ContextMenu x:Name="TrayContextMenu"
                         DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                         MinWidth="196"
                         Closed="TrayContextMenuClosed"
                         Opened="TrayContextMenuOpened"
                         Placement="Custom"
                         StaysOpen="False"
                         controls:MotionAssist.IsEntranceEnabled="True"
                         controls:MotionAssist.EntranceOffsetY="6"
                         controls:MotionAssist.EntranceScale="0.98">
                <MenuItem Click="ShowMainWindowClick"
                          Header="{Binding ShowMainWindowText}"
                          Style="{StaticResource PrimaryTrayMenuItemStyle}">
                    <MenuItem.Icon>
                        <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" Glyph="{x:Static ui:FontSymbols.OpenInNewWindow}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Click="OpenSettingsClick"
                          Header="{Binding SettingsText}"
                          Style="{StaticResource TrayMenuItemStyle}">
                    <MenuItem.Icon>
                        <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" Glyph="{x:Static ui:FontSymbols.Settings}" />
                    </MenuItem.Icon>
                </MenuItem>

                <Separator />

                <MenuItem Click="ToggleMonitorClick"
                          Header="{Binding MonitorText}"
                          IsCheckable="True"
                          IsChecked="{Binding IsMonitorRunning, Mode=OneWay}"
                          Style="{StaticResource ToggleTrayMenuItemStyle}">
                    <MenuItem.Icon>
                        <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" Glyph="{x:Static ui:FontSymbols.Radar}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Click="ToggleRecordClick"
                          Header="{Binding RecordText}"
                          IsCheckable="True"
                          IsChecked="{Binding IsRecordEnabled, Mode=OneWay}"
                          Style="{StaticResource ToggleTrayMenuItemStyle}">
                    <MenuItem.Icon>
                        <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" Glyph="{x:Static ui:FontSymbols.Record}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Click="ToggleAutoRunClick"
                          Header="{Binding AutoRunText}"
                          IsCheckable="True"
                          IsChecked="{Binding IsAutoRun, Mode=OneWay}"
                          Style="{StaticResource ToggleTrayMenuItemStyle}">
                    <MenuItem.Icon>
                        <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" Glyph="{x:Static ui:FontSymbols.Play}" />
                    </MenuItem.Icon>
                </MenuItem>

                <Separator />

                <MenuItem Click="RestartClick"
                          Header="{Binding RestartText}"
                          Style="{StaticResource TrayMenuItemStyle}">
                    <MenuItem.Icon>
                        <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" Glyph="{x:Static ui:FontSymbols.Sync}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Click="ExitClick"
                          Header="{Binding ExitText}"
                          Style="{StaticResource TrayMenuItemStyle}">
                    <MenuItem.Icon>
                        <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" Glyph="{x:Static ui:FontSymbols.PowerButton}" />
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
        </Grid.ContextMenu>
    </Grid>
</Window>
