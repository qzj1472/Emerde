<Window x:Class="Emerde.Views.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Emerde.Controls"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Width="188"
        AllowsTransparency="True"
        Background="Transparent"
        FocusVisualStyle="{x:Null}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        SnapsToDevicePixels="True"
        Topmost="True"
        UseLayoutRounding="True"
        WindowStyle="None"
        Deactivated="TrayMenuWindowDeactivated"
        PreviewKeyDown="TrayMenuWindowPreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="TrayMenuSurfaceBrush" Color="#FFF7F8FA" />
        <SolidColorBrush x:Key="TrayMenuItemHoverBrush" Color="#0F172A0D" />
        <SolidColorBrush x:Key="TrayMenuDividerBrush" Color="#140F172A" />
        <SolidColorBrush x:Key="TrayMenuDangerBrush" Color="#C43D4D" />
        <Style x:Key="TrayMenuIconStyle" TargetType="{x:Type ui:FontIcon}">
            <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TrayMenuButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Height" Value="34" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="controls:MotionAssist.IsPressEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ItemSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="{StaticResource TrayMenuItemHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ItemSurface" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ItemSurface" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TrayMenuDangerButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource TrayMenuButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource TrayMenuDangerBrush}" />
        </Style>
        <Style x:Key="TrayMenuSelectionIndicatorStyle" TargetType="{x:Type Border}">
            <Setter Property="Width" Value="3" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
        <Style x:Key="TrayMenuDividerStyle" TargetType="{x:Type Border}">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="8,4" />
            <Setter Property="Background" Value="{StaticResource TrayMenuDividerBrush}" />
        </Style>
    </Window.Resources>

    <Border x:Name="MenuSurface"
            Margin="0"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            CornerRadius="8"
            Padding="4"
            controls:MotionAssist.IsEntranceEnabled="True"
            controls:MotionAssist.EntranceOffsetY="6"
            controls:MotionAssist.EntranceScale="0.98">
        <StackPanel>
            <Button Click="ShowMainWindowClick" Style="{StaticResource TrayMenuButtonStyle}">
                <Grid Margin="6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:FontIcon Grid.Column="0" Style="{StaticResource TrayMenuIconStyle}" Glyph="{x:Static ui:FontSymbols.OpenInNewWindow}" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding ShowMainWindowText}" />
                </Grid>
            </Button>
            <Button Click="OpenSettingsClick" Style="{StaticResource TrayMenuButtonStyle}">
                <Grid Margin="6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:FontIcon Grid.Column="0" Style="{StaticResource TrayMenuIconStyle}" Glyph="{x:Static ui:FontSymbols.Settings}" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding SettingsText}" />
                </Grid>
            </Button>

            <Border Style="{StaticResource TrayMenuDividerStyle}" />

            <Button Click="ToggleMonitorClick" Style="{StaticResource TrayMenuButtonStyle}">
                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource TrayMenuSelectionIndicatorStyle}" Visibility="{Binding MonitorIndicatorVisibility}" />
                    <ui:FontIcon Grid.Column="2" Style="{StaticResource TrayMenuIconStyle}" Glyph="{x:Static ui:FontSymbols.Radar}" />
                    <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="{Binding MonitorText}" />
                </Grid>
            </Button>
            <Button Click="ToggleRecordClick" Style="{StaticResource TrayMenuButtonStyle}">
                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource TrayMenuSelectionIndicatorStyle}" Visibility="{Binding RecordIndicatorVisibility}" />
                    <ui:FontIcon Grid.Column="2" Style="{StaticResource TrayMenuIconStyle}" Glyph="{x:Static ui:FontSymbols.Record}" />
                    <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="{Binding RecordText}" />
                </Grid>
            </Button>
            <Button Click="ToggleAutoRunClick" Style="{StaticResource TrayMenuButtonStyle}">
                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource TrayMenuSelectionIndicatorStyle}" Visibility="{Binding AutoRunIndicatorVisibility}" />
                    <ui:FontIcon Grid.Column="2" Style="{StaticResource TrayMenuIconStyle}" Glyph="{x:Static ui:FontSymbols.Play}" />
                    <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="{Binding AutoRunText}" />
                </Grid>
            </Button>

            <Border Style="{StaticResource TrayMenuDividerStyle}" />

            <Button Click="RestartClick" Style="{StaticResource TrayMenuButtonStyle}">
                <Grid Margin="6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:FontIcon Grid.Column="0" Style="{StaticResource TrayMenuIconStyle}" Glyph="{x:Static ui:FontSymbols.Sync}" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding RestartText}" />
                </Grid>
            </Button>
            <Button Click="ExitClick" Style="{StaticResource TrayMenuDangerButtonStyle}">
                <Grid Margin="6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:FontIcon Grid.Column="0" Style="{StaticResource TrayMenuIconStyle}" Glyph="{x:Static ui:FontSymbols.PowerButton}" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding ExitText}" />
                </Grid>
            </Button>
        </StackPanel>
    </Border>
</Window>
