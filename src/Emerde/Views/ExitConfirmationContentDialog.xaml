<vio:ContentDialog x:Class="Emerde.Views.ExitConfirmationContentDialog"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:controls="clr-namespace:Emerde.Controls"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
                   Title="{I18N QuestionTitle}"
                   d:DesignHeight="NaN"
                   d:DesignWidth="NaN"
                   CloseButtonText="{I18N No}"
                   DefaultButton="Primary"
                   FontSize="14"
                   PrimaryButtonText="{I18N Yes}"
                   SnapsToDevicePixels="True"
                   Style="{StaticResource EmerdeContentDialogStyle}"
                   UseLayoutRounding="True"
                   mc:Ignorable="d">
    <Grid Margin="0,2,0,0"
          controls:MotionAssist.IsEntranceEnabled="True"
          controls:MotionAssist.EntranceOffsetY="8"
          controls:MotionAssist.EntranceScale="0.98">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0"
                Width="36"
                Height="36"
                Margin="0,2,18,0"
                VerticalAlignment="Top"
                BorderBrush="{DynamicResource SystemAccentColorPrimaryBrush}"
                BorderThickness="2"
                CornerRadius="18">
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                       Text="?" />
        </Border>
        <TextBlock Grid.Column="1"
                   VerticalAlignment="Center"
                   Style="{StaticResource EmerdeDialogBodyTextStyle}"
                   Text="{Binding Message}" />
    </Grid>
</vio:ContentDialog>
