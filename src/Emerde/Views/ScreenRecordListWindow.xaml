<UserControl x:Class="Emerde.Views.ScreenRecordListWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:controls="clr-namespace:Emerde.Controls"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:c="http://schemas.github.com/computedconverters/2024/xaml"
                 xmlns:local="clr-namespace:Emerde.Views"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
                 FontSize="14"
                 mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="VideoListToolbarButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
        <Style x:Key="VideoListIconButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
        <Style x:Key="VideoCardActionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="58" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
        <Style x:Key="VideoListScrollPageButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VideoListScrollThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbSurface"
                                Width="4"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource SystemFillColorSolidNeutralBrush}"
                                CornerRadius="2"
                                Opacity="0.6"
                                SnapsToDevicePixels="True" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbSurface" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbSurface" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VideoListScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Track x:Name="PART_Track"
                               Width="12"
                               HorizontalAlignment="Center"
                               IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                              Style="{StaticResource VideoListScrollPageButtonStyle}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource VideoListScrollThumbStyle}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                              Style="{StaticResource VideoListScrollPageButtonStyle}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VideoListScrollViewerStyle" TargetType="{x:Type ScrollViewer}">
            <Setter Property="Padding" Value="10,8,0,10" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid ClipToBounds="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="22" />
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0"
                                                    Margin="{TemplateBinding Padding}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Width="12"
                                       Margin="0,8,0,10"
                                       HorizontalAlignment="Center"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       Minimum="0"
                                       Orientation="Vertical"
                                       Style="{StaticResource VideoListScrollBarStyle}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VideoListBoxStyle" TargetType="{x:Type ListBox}" BasedOn="{StaticResource {x:Type ListBox}}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBox}">
                        <ScrollViewer Focusable="False"
                                      FocusVisualStyle="{x:Null}"
                                      CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                      Style="{StaticResource VideoListScrollViewerStyle}">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="VideoListDialogContent">
        <Grid x:Name="VideoListContentRoot"
              Margin="0"
              controls:MotionAssist.IsEntranceEnabled="True"
              controls:MotionAssist.EntranceOffsetY="8"
            controls:MotionAssist.EntranceTrigger="{Binding IsVideoListPageSelected}">
            <Grid.RowDefinitions>
                <RowDefinition Height="92" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="10,0,22,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="44" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Text="{I18N VideoListTitle}" />

                    <StackPanel Grid.Column="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <Button Command="{Binding RefreshCommand}"
                                Margin="0,0,8,0"
                                IsEnabled="{Binding IsIdle}"
                                Style="{StaticResource VideoListToolbarButtonStyle}"
                                ToolTip="刷新视频列表（F5）">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                             Margin="0,0,7,0"
                                             Glyph="{x:Static ui:FontSymbols.Sync}" />
                                <TextBlock Text="{I18N RefreshButton}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ImportFolderCommand}"
                                Margin="0,0,8,0"
                                IsEnabled="{Binding IsIdle}"
                                Style="{StaticResource VideoListToolbarButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                             Margin="0,0,7,0"
                                             Glyph="{x:Static ui:FontSymbols.FolderOpen}" />
                                <TextBlock Text="{I18N ImportFolder}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenSaveFolderCommand}"
                                Style="{StaticResource VideoListToolbarButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                             Margin="0,0,7,0"
                                             Glyph="{x:Static ui:FontSymbols.FolderOpen}" />
                                <TextBlock Text="{I18N SaveFolder}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1"
                        Padding="0,4"
                        Background="Transparent"
                        CornerRadius="{StaticResource Win11ControlCornerRadius}"
                        controls:MotionAssist.IsEntranceEnabled="True"
                        controls:MotionAssist.EntranceOffsetY="5"
                        controls:MotionAssist.EntranceScale="0.992"
                        controls:MotionAssist.EntranceTrigger="{Binding IsVideoListPageSelected}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <Button Command="{Binding ToggleSortCommand}"
                                    Margin="0,0,12,0"
                                    IsEnabled="{Binding IsIdle}"
                                    Style="{StaticResource VideoListToolbarButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:FontIcon Margin="0,0,7,0"
                                                 FontFamily="{DynamicResource SymbolThemeFontFamily}">
                                        <ui:FontIcon.Style>
                                            <Style TargetType="{x:Type ui:FontIcon}">
                                                <Setter Property="Glyph" Value="{x:Static ui:FontSymbols.ChevronUp}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSortDescending}" Value="True">
                                                        <Setter Property="Glyph" Value="{x:Static ui:FontSymbols.ChevronDown}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:FontIcon.Style>
                                    </ui:FontIcon>
                                    <TextBlock Text="{Binding SortDirectionText}" />
                                </StackPanel>
                            </Button>
                            <TextBlock Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{I18N StreamerLabel}" />
                            <ComboBox Width="158"
                                      Margin="0,0,14,0"
                                      ItemsSource="{Binding StreamerOptions}"
                                      SelectedItem="{Binding SelectedStreamer, Mode=TwoWay}" />
                            <TextBlock Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{I18N TimeRangeLabel}" />
                            <ComboBox Width="138"
                                      ItemsSource="{Binding TimeRangeOptions}"
                                      SelectedIndex="{Binding SelectedTimeRangeIndex, Mode=TwoWay}" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Command="{Binding BeginMultiSelectCommand}"
                                Content="{I18N MultiSelect}"
                                ToolTip="进入多选模式（Ctrl+A 可全选）">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource VideoListToolbarButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasVisibleVideos}" Value="True" />
                                                <Condition Binding="{Binding IsMultiSelectMode}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="{x:Type StackPanel}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMultiSelectMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border MinHeight="30"
                                    Margin="0,0,8,0"
                                    Padding="10,0"
                                    Background="#144DA7B0"
                                    CornerRadius="{StaticResource Win11ControlCornerRadius}">
                                <TextBlock VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding SelectedVideoSummary}" />
                            </Border>
                            <Button Margin="0,0,8,0"
                                    Command="{Binding SelectAllCommand}"
                                    Style="{StaticResource VideoListIconButtonStyle}"
                                    ToolTip="全选视频（Ctrl+A）">
                                <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                             Glyph="{x:Static ui:FontSymbols.Accept}" />
                            </Button>
                            <Button Margin="0,0,8,0"
                                    Command="{Binding InvertSelectionCommand}"
                                    Style="{StaticResource VideoListIconButtonStyle}"
                                    ToolTip="反选">
                                <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                             Glyph="{x:Static ui:FontSymbols.Switch}" />
                            </Button>
                            <Button Command="{Binding CancelMultiSelectCommand}"
                                    Style="{StaticResource VideoListIconButtonStyle}"
                                    ToolTip="退出多选（Esc）">
                                <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                             Glyph="{x:Static ui:FontSymbols.CalculatorMultiply}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="VideoSelectionHost"
                  Grid.Row="1"
                  ClipToBounds="True"
                  PreviewMouseLeftButtonDown="VideoSelectionHostPreviewMouseLeftButtonDown"
                  PreviewMouseLeftButtonUp="VideoSelectionHostPreviewMouseLeftButtonUp"
                  PreviewMouseMove="VideoSelectionHostPreviewMouseMove"
                  PreviewMouseRightButtonDown="VideoSelectionHostPreviewMouseRightButtonDown"
                  LostMouseCapture="VideoSelectionHostLostMouseCapture">
                <ListBox x:Name="VideoListBox"
                          ItemsSource="{Binding Videos}"
                          Background="Transparent"
                          BorderThickness="0"
                          FocusVisualStyle="{x:Null}"
                          PreviewMouseWheel="VideoListBoxPreviewMouseWheel"
                          SelectedItem="{Binding RegularSelectedItem, Mode=TwoWay}"
                          SelectionMode="Single"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.IsDeferredScrollingEnabled="False"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.ScrollChanged="VideoListScrollChanged"
                          Style="{StaticResource VideoListBoxStyle}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="controls:MotionAssist.IsEntranceEnabled" Value="True" />
                        <Setter Property="controls:MotionAssist.EntranceOffsetY" Value="7" />
                        <Setter Property="controls:MotionAssist.EntranceScale" Value="0.99" />
                        <Setter Property="controls:MotionAssist.IsPressEnabled" Value="False" />
                        <Setter Property="controls:MotionAssist.HoverScale" Value="1" />
                        <Setter Property="controls:MotionAssist.PressScale" Value="0.996" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="VideoCardShell"
                                Margin="0,0,0,8"
                                Padding="0"
                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type local:ScreenRecordListWindow}}}"
                                Background="{DynamicResource EmerdePanelBrush}"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                CornerRadius="{StaticResource Win11ControlCornerRadius}"
                                controls:MotionAssist.IsDataContextEntranceEnabled="True"
                                controls:MotionAssist.EntranceTrigger="{Binding DataContext.IsVideoListPageSelected, RelativeSource={RelativeSource AncestorType={x:Type local:ScreenRecordListWindow}}}"
                                Loaded="VideoCardLoaded">
                            <Border.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="打开视频"
                                              Command="{Binding Tag.OpenVideoCommand}"
                                              CommandParameter="{Binding DataContext}"
                                              IsEnabled="{Binding DataContext.CanModify}" />
                                    <MenuItem Header="打开目录"
                                              Command="{Binding Tag.OpenDirectoryCommand}"
                                              CommandParameter="{Binding DataContext}"
                                              IsEnabled="{Binding DataContext.CanModify}" />
                                    <MenuItem Header="重命名"
                                              Command="{Binding Tag.RenameVideoCommand}"
                                              CommandParameter="{Binding DataContext}"
                                              IsEnabled="{Binding DataContext.CanModify}" />
                                    <MenuItem Header="转码"
                                              Command="{Binding Tag.TranscodeVideoCommand}"
                                              CommandParameter="{Binding DataContext}"
                                              IsEnabled="{Binding DataContext.CanTranscode}" />
                                    <Separator />
                                    <MenuItem Header="合并"
                                              Command="{Binding Tag.OpenMergeSelectedCommand}"
                                              IsEnabled="{Binding Tag.CanMergeSelectedVideos}" />
                                    <MenuItem Header="分割"
                                              Command="{Binding Tag.SplitContextCommand}"
                                              CommandParameter="{Binding DataContext}"
                                              IsEnabled="{Binding DataContext.CanModify}" />
                                    <MenuItem Header="移动"
                                              Command="{Binding Tag.MoveContextCommand}"
                                              CommandParameter="{Binding DataContext}"
                                              IsEnabled="{Binding DataContext.CanModify}" />
                                    <MenuItem Header="复制"
                                              Command="{Binding Tag.CopyContextCommand}"
                                              CommandParameter="{Binding DataContext}"
                                              IsEnabled="{Binding DataContext.CanModify}" />
                                    <MenuItem Header="删除"
                                              Command="{Binding Tag.DeleteContextCommand}"
                                              CommandParameter="{Binding DataContext}"
                                              IsEnabled="{Binding DataContext.CanModify}" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid>
                                <Border x:Name="VideoCardSurfaceStroke"
                                        BorderBrush="Transparent"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource Win11ControlCornerRadius}"
                                        IsHitTestVisible="False" />
                                <Border x:Name="VideoCardHoverLayer"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        BorderThickness="0"
                                        CornerRadius="{StaticResource Win11ControlCornerRadius}"
                                        IsHitTestVisible="False"
                                        Opacity="0" />
                                <Border x:Name="VideoCardSelectionLayer"
                                        Background="#18337DFF"
                                        BorderBrush="#78337DFF"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource Win11ControlCornerRadius}"
                                        IsHitTestVisible="False"
                                        Opacity="0" />
                                <Border x:Name="VideoCardMultiSelectionLayer"
                                        Background="#1D4DA7B0"
                                        BorderBrush="#944DA7B0"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource Win11ControlCornerRadius}"
                                        IsHitTestVisible="False"
                                        Opacity="0" />
                                <Border x:Name="VideoCardContent"
                                        Padding="14"
                                        Background="Transparent">
                                    <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="124" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="124"
                                        Height="70"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="#16000000"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource Win11ControlCornerRadius}"
                                        ClipToBounds="True">
                                    <Grid>
                                        <Border CornerRadius="{StaticResource Win11ControlCornerRadius}">
                                            <Border.Background>
                                                <ImageBrush AlignmentX="Center"
                                                            AlignmentY="Center"
                                                            ImageSource="{Binding ThumbnailPath, Converter={x:Static local:ThumbnailImageConverter.Instance}}"
                                                            Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                        <ui:FontIcon HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                     FontSize="24"
                                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                     Glyph="{x:Static ui:FontSymbols.Video}">
                                            <ui:FontIcon.Style>
                                                <Style TargetType="{x:Type ui:FontIcon}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:FontIcon.Style>
                                        </ui:FontIcon>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="14,0,18,0" VerticalAlignment="Center">
                                    <TextBlock FontSize="16"
                                               FontWeight="SemiBold"
                                               Text="{Binding FileName}"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                        <Border MaxWidth="110"
                                                Background="#18F59E0B"
                                                BorderBrush="#45F59E0B"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource Win11ControlCornerRadius}"
                                                Margin="0,0,6,0"
                                                MinHeight="22"
                                                Padding="9,2">
                                            <Border.Style>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsConverting}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="12"
                                                       Foreground="#C46A00"
                                                       Text="{I18N TranscodingChip}" />
                                        </Border>
                                        <Border MaxWidth="110"
                                                Background="#24D13438"
                                                BorderBrush="#80D13438"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource Win11ControlCornerRadius}"
                                                Margin="0,0,6,0"
                                                MinHeight="22"
                                                Padding="9,2">
                                            <Border.Style>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRecordingFile}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="12"
                                                       Foreground="#C50F1F"
                                                       Text="{I18N RecordStatusOfRecording}" />
                                        </Border>
                                        <TextBlock MaxWidth="360"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Text="{Binding StreamerChipText}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Margin="0,6,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="{Binding RecordingDetailsText}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            IsEnabled="{Binding CanModify}">
                                    <StackPanel.Style>
                                        <Style TargetType="{x:Type StackPanel}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsMultiSelectMode, RelativeSource={RelativeSource AncestorType={x:Type local:ScreenRecordListWindow}}}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Button Margin="0,0,8,0"
                                            Command="{Binding DataContext.OpenVideoCommand, RelativeSource={RelativeSource AncestorType={x:Type local:ScreenRecordListWindow}}}"
                                            CommandParameter="{Binding}"
                                            Content="{I18N OpenVideo}"
                                            Style="{StaticResource VideoCardActionButtonStyle}"
                                            ToolTip="打开视频（Enter）" />
                                    <Button Margin="0,0,8,0"
                                            Command="{Binding DataContext.TranscodeVideoCommand, RelativeSource={RelativeSource AncestorType={x:Type local:ScreenRecordListWindow}}}"
                                            CommandParameter="{Binding}"
                                            Content="{I18N TranscodeVideo}">
                                        <Button.Style>
                                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource VideoCardActionButtonStyle}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanTranscode}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Margin="0,0,8,0"
                                            Command="{Binding DataContext.SplitVideoCommand, RelativeSource={RelativeSource AncestorType={x:Type local:ScreenRecordListWindow}}}"
                                            CommandParameter="{Binding}"
                                            Content="{I18N SplitButton}"
                                            Style="{StaticResource VideoCardActionButtonStyle}" />
                                    <Button Command="{Binding DataContext.OpenDirectoryCommand, RelativeSource={RelativeSource AncestorType={x:Type local:ScreenRecordListWindow}}}"
                                            CommandParameter="{Binding}"
                                            Content="{I18N OpenFolder}"
                                            Style="{StaticResource VideoCardActionButtonStyle}" />
                                </StackPanel>

                                <Grid Grid.Column="2"
                                      Width="32"
                                      Height="24"
                                      Margin="8,0,0,0"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center">
                                    <Grid.Style>
                                        <Style TargetType="{x:Type Grid}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsMultiSelectMode, RelativeSource={RelativeSource AncestorType={x:Type local:ScreenRecordListWindow}}}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <CheckBox Width="22"
                                              Height="22"
                                              MinWidth="22"
                                              Padding="0"
                                              HorizontalAlignment="Center"
                                              HorizontalContentAlignment="Center"
                                              VerticalAlignment="Center"
                                              VerticalContentAlignment="Center"
                                              PreviewMouseLeftButtonDown="SelectionCheckBoxPreviewMouseLeftButtonDown"
                                              IsEnabled="{Binding CanSelect}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                        <CheckBox.Style>
                                            <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource {x:Type CheckBox}}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding DataContext.IsMultiSelectMode, RelativeSource={RelativeSource AncestorType={x:Type local:ScreenRecordListWindow}}}" Value="True" />
                                                            <Condition Binding="{Binding IsSelected}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBox.Style>
                                    </CheckBox>
                                    <Border x:Name="VideoSelectionOrderBadge"
                                            Height="24"
                                            MinWidth="24"
                                            Padding="5,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="#E64DA7B0"
                                            CornerRadius="12"
                                            Cursor="Hand"
                                            PreviewMouseLeftButtonDown="SelectionCheckBoxPreviewMouseLeftButtonDown">
                                        <Border.Style>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding DataContext.IsMultiSelectMode, RelativeSource={RelativeSource AncestorType={x:Type local:ScreenRecordListWindow}}}" Value="True" />
                                                            <Condition Binding="{Binding IsSelected}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Viewbox MaxWidth="22" MaxHeight="16">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="White"
                                                       Text="{Binding SelectionOrder}" />
                                        </Viewbox>
                                    </Border>
                                </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="VideoCardShell" Property="IsMouseOver" Value="True">
                                <Setter TargetName="VideoCardHoverLayer" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True" />
                                    <Condition Binding="{Binding DataContext.IsMultiSelectMode, RelativeSource={RelativeSource AncestorType={x:Type local:ScreenRecordListWindow}}}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="VideoCardSelectionLayer" Property="Opacity" Value="1" />
                                <MultiDataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="VideoCardSelectionLayer"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0"
                                                             To="1"
                                                             Duration="0:0:0.18"
                                                             FillBehavior="Stop" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.EnterActions>
                                <MultiDataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="VideoCardSelectionLayer"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="1"
                                                             To="0"
                                                             Duration="0:0:0.14"
                                                             FillBehavior="Stop" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.ExitActions>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsSelected}" Value="True" />
                                    <Condition Binding="{Binding DataContext.IsMultiSelectMode, RelativeSource={RelativeSource AncestorType={x:Type local:ScreenRecordListWindow}}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="VideoCardMultiSelectionLayer" Property="Opacity" Value="1" />
                                <MultiDataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="VideoCardMultiSelectionLayer"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0"
                                                             To="1"
                                                             Duration="0:0:0.18"
                                                             FillBehavior="Stop" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.EnterActions>
                                <MultiDataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="VideoCardMultiSelectionLayer"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="1"
                                                             To="0"
                                                             Duration="0:0:0.14"
                                                             FillBehavior="Stop" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.ExitActions>
                            </MultiDataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                </ListBox>
                <Canvas Panel.ZIndex="30" IsHitTestVisible="False">
                    <Rectangle x:Name="VideoSelectionRectangle"
                               Fill="#2A4DA7B0"
                               StrokeThickness="0"
                               Visibility="Collapsed" />
                </Canvas>
                <Border x:Name="VideoListTopFade"
                        Height="6"
                        Margin="10,8,22,0"
                        VerticalAlignment="Top"
                        Panel.ZIndex="20"
                        Background="{DynamicResource EmerdeSurfaceBrush}"
                        IsHitTestVisible="False"
                        OpacityMask="{StaticResource TopEdgeFadeOpacityMask}"
                        Visibility="Collapsed" />
                <Border x:Name="VideoListBottomFade"
                        Height="6"
                        Margin="10,0,22,10"
                        VerticalAlignment="Bottom"
                        Panel.ZIndex="20"
                        Background="{DynamicResource EmerdeSurfaceBrush}"
                        IsHitTestVisible="False"
                        OpacityMask="{StaticResource BottomEdgeFadeOpacityMask}"
                        Visibility="Collapsed" />
            </Grid>
        </Grid>

        <Grid x:Name="VideoListDialogOverlay"
              Background="Transparent"
              IsHitTestVisible="False"
              Panel.ZIndex="35"
              Visibility="Collapsed" />

        <Grid x:Name="VideoListModalOverlay"
              Panel.ZIndex="40"
              MouseDown="VideoListModalOverlayMouseDown"
              Visibility="{Binding IsModalOpen, Converter={x:Static c:BoolToVisibilityConverter.Instance}}">
            <Border Width="420"
                    Padding="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Win11ControlCornerRadius}"
                    Visibility="{Binding IsSplitPanelOpen, Converter={x:Static c:BoolToVisibilityConverter.Instance}}">
                <ui:Grid RowDefinitions="Auto,Auto,Auto">
                    <ui:Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                        <ui:FontIcon Grid.Column="0"
                                     Margin="0,0,12,0"
                                     VerticalAlignment="Center"
                                     FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                     FontSize="20"
                                     Glyph="{x:Static ui:FontSymbols.Cut}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock FontSize="16"
                                       FontWeight="SemiBold"
                                       Text="{I18N SplitVideo}" />
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding SplitTargetFileName}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </ui:Grid>

                    <ui:Grid Grid.Row="1"
                             Margin="0,18,0,0"
                             ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="{I18N SplitInterval}" />
                        <ui:TextBox x:Name="SplitDurationTextBox"
                                     Grid.Column="1"
                                     Margin="12,0,0,0"
                                     controls:InputAssist.EnterCommand="{Binding ConfirmSplitCommand}"
                                     controls:InputAssist.SelectAllOnVisible="True"
                                     Text="{Binding SplitDurationValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox Grid.Column="2"
                                  Width="92"
                                  Margin="8,0,0,0"
                                  SelectedIndex="{Binding SplitDurationUnitIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{I18N Minutes}" />
                            <ComboBoxItem Content="{I18N Seconds}" />
                            <ComboBoxItem Content="{I18N Hours}" />
                        </ComboBox>
                    </ui:Grid>

                    <ui:Grid Grid.Row="2"
                             Margin="0,18,0,0"
                             ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding OperationProgressText}"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="1"
                                Margin="0,0,8,0"
                                Command="{Binding CloseModalCommand}"
                                Content="{I18N ButtonOfCancel}"
                                IsEnabled="{Binding IsIdle}" />
                        <Button Grid.Column="2"
                                Command="{Binding ConfirmSplitCommand}"
                                Content="{I18N StartButton}"
                                IsEnabled="{Binding IsIdle}" />
                    </ui:Grid>
                </ui:Grid>
            </Border>
            <Border Width="460"
                    Padding="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Win11ControlCornerRadius}"
                    Visibility="{Binding IsMergePanelOpen, Converter={x:Static c:BoolToVisibilityConverter.Instance}}">
                <ui:Grid RowDefinitions="Auto,Auto,Auto,Auto">
                    <ui:Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                        <ui:FontIcon Grid.Column="0"
                                     Margin="0,0,12,0"
                                     VerticalAlignment="Center"
                                     FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                     FontSize="20"
                                     Glyph="{x:Static ui:FontSymbols.Link}" />
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="{I18N MergeVideos}" />
                    </ui:Grid>
                    <TextBlock Grid.Row="1"
                               Margin="0,16,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding MergeWarningText}"
                               TextWrapping="Wrap" />
                    <ProgressBar Grid.Row="2"
                                 Height="6"
                                 Margin="0,16,0,0"
                                 IsIndeterminate="{Binding IsMergeProgressIndeterminate}"
                                 Maximum="100"
                                 Value="{Binding MergeProgressValue}" />
                    <ui:Grid Grid.Row="3"
                             Margin="0,18,0,0"
                             ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding OperationProgressText}"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="1"
                                Margin="0,0,8,0"
                                Command="{Binding CloseModalCommand}"
                                Content="{I18N ButtonOfCancel}"
                                IsEnabled="{Binding IsIdle}" />
                        <Button Grid.Column="2"
                                Command="{Binding ConfirmMergeSelectedCommand}"
                                Content="{I18N StartButton}"
                                IsEnabled="{Binding IsIdle}" />
                    </ui:Grid>
                </ui:Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
