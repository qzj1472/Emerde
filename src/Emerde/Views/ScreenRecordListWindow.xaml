                                                             Glyph="{x:Static ui:FontSymbols.Video}">
                                                    <ui:FontIcon.Style>
                                                        <Style TargetType="{x:Type ui:FontIcon}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:FontIcon.Style>
                                                </ui:FontIcon>
                                                <Grid Margin="8"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Top">
                                                     <Border MaxWidth="104"
                                                             Background="{DynamicResource UiXTranscodeFillBrush}"
