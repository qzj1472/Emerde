                                                                       Foreground="White"
                                                                       Text="{Binding SelectionOrder}" />
                                                        </Viewbox>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Row="1"
                                                Margin="0,6,0,0"
                                                Padding="8,3"
