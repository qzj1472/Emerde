                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding IsStallSegment}" Value="True" />
                                                                            <Condition Binding="{Binding IsRecordingFile}" Value="False" />
                                                                            <Condition Binding="{Binding IsConverting}" Value="False" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock FontSize="11"
                                                                   Foreground="#1D4ED8"
