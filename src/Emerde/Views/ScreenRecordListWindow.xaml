                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.EnterActions>
                                <MultiDataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="VideoCardSelectionLayer"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="1"
                                                             To="0"
                                                             Duration="0:0:0.14"
                                                             FillBehavior="Stop" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.ExitActions>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsSelected}" Value="True" />
                                    <Condition Binding="{Binding DataContext.IsMultiSelectMode, RelativeSource={RelativeSource AncestorType={x:Type local:ScreenRecordListWindow}}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="VideoCardMultiSelectionLayer" Property="Opacity" Value="1" />
                                <MultiDataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="VideoCardMultiSelectionLayer"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0"
                                                             To="1"
                                                             Duration="0:0:0.18"
                                                             FillBehavior="Stop" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.EnterActions>
                                <MultiDataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="VideoCardMultiSelectionLayer"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="1"
                                                             To="0"
                                                             Duration="0:0:0.14"
                                                             FillBehavior="Stop" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.ExitActions>
                            </MultiDataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                </ListBox>
                <Canvas Panel.ZIndex="30" IsHitTestVisible="False">
                    <Border x:Name="VideoSelectionRectangle"
                            Style="{StaticResource VideoSelectionRectangleStyle}"
                            Visibility="Collapsed" />
                </Canvas>
                <Border x:Name="VideoListTopFade"
                        Height="6"
                        Margin="20,8,22,0"
                        VerticalAlignment="Top"
                        Panel.ZIndex="20"
                        Style="{StaticResource UiXVideoFadeStyle}"
                        IsHitTestVisible="False"
                        OpacityMask="{StaticResource TopEdgeFadeOpacityMask}"
                        Visibility="Collapsed" />
                <Border x:Name="VideoListBottomFade"
                        Height="6"
                        Margin="20,0,22,10"
                        VerticalAlignment="Bottom"
                        Panel.ZIndex="20"
                        Style="{StaticResource UiXVideoFadeStyle}"
                        IsHitTestVisible="False"
                        OpacityMask="{StaticResource BottomEdgeFadeOpacityMask}"
                        Visibility="Collapsed" />
            </Grid>
        </Grid>

        <Grid x:Name="VideoListDialogOverlay"
              Background="Transparent"
              IsHitTestVisible="False"
              Panel.ZIndex="35"
              Visibility="Collapsed" />

        <Grid x:Name="VideoListModalOverlay"
              Panel.ZIndex="40"
              MouseDown="VideoListModalOverlayMouseDown"
              Visibility="{Binding IsModalOpen, Converter={x:Static c:BoolToVisibilityConverter.Instance}}">
            <Border Width="420"
                    Padding="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Win11ControlCornerRadius}"
                    Visibility="{Binding IsSplitPanelOpen, Converter={x:Static c:BoolToVisibilityConverter.Instance}}">
                <ui:Grid RowDefinitions="Auto,Auto,Auto">
                    <ui:Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                        <ui:FontIcon Grid.Column="0"
                                     Margin="0,0,12,0"
                                     VerticalAlignment="Center"
                                     FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                     FontSize="20"
                                     Glyph="{x:Static ui:FontSymbols.Cut}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock FontSize="16"
                                       FontWeight="SemiBold"
                                       Text="{I18N SplitVideo}" />
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding SplitTargetFileName}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </ui:Grid>

                    <ui:Grid Grid.Row="1"
                             Margin="0,18,0,0"
                             ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="{I18N SplitInterval}" />
                        <ui:TextBox x:Name="SplitDurationTextBox"
                                     Grid.Column="1"
                                     Margin="12,0,0,0"
                                     controls:InputAssist.EnterCommand="{Binding ConfirmSplitCommand}"
                                     controls:InputAssist.SelectAllOnVisible="True"
                                     Text="{Binding SplitDurationValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox Grid.Column="2"
                                  Width="92"
                                  Margin="8,0,0,0"
                                  SelectedIndex="{Binding SplitDurationUnitIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{I18N Minutes}" />
                            <ComboBoxItem Content="{I18N Seconds}" />
                            <ComboBoxItem Content="{I18N Hours}" />
                        </ComboBox>
                    </ui:Grid>

                    <ui:Grid Grid.Row="2"
                             Margin="0,18,0,0"
                             ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding OperationProgressText}"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="1"
                                Margin="0,0,8,0"
                                Command="{Binding CloseModalCommand}"
                                Content="{I18N ButtonOfCancel}"
                                IsEnabled="{Binding IsIdle}" />
                        <Button Grid.Column="2"
                                Command="{Binding ConfirmSplitCommand}"
                                Content="{I18N StartButton}"
                                IsEnabled="{Binding IsIdle}" />
                    </ui:Grid>
                </ui:Grid>
            </Border>
            <Border Width="460"
                    Padding="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Win11ControlCornerRadius}"
                    Visibility="{Binding IsMergePanelOpen, Converter={x:Static c:BoolToVisibilityConverter.Instance}}">
                <ui:Grid RowDefinitions="Auto,Auto,Auto,Auto">
                    <ui:Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                        <ui:FontIcon Grid.Column="0"
                                     Margin="0,0,12,0"
                                     VerticalAlignment="Center"
                                     FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                     FontSize="20"
                                     Glyph="{x:Static ui:FontSymbols.Link}" />
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="{I18N MergeVideos}" />
                    </ui:Grid>
                    <TextBlock Grid.Row="1"
                               Margin="0,16,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding MergeWarningText}"
                               TextWrapping="Wrap" />
                    <ProgressBar Grid.Row="2"
                                 Height="6"
                                 Margin="0,16,0,0"
                                 IsIndeterminate="{Binding IsMergeProgressIndeterminate}"
                                 Maximum="100"
                                 Value="{Binding MergeProgressValue}" />
                    <ui:Grid Grid.Row="3"
                             Margin="0,18,0,0"
                             ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding OperationProgressText}"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="1"
                                Margin="0,0,8,0"
                                Command="{Binding CloseModalCommand}"
                                Content="{I18N ButtonOfCancel}"
                                IsEnabled="{Binding IsIdle}" />
                        <Button Grid.Column="2"
                                Command="{Binding ConfirmMergeSelectedCommand}"
                                Content="{I18N StartButton}"
                                IsEnabled="{Binding IsIdle}" />
                    </ui:Grid>
                </ui:Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
