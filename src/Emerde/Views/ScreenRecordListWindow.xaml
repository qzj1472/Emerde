                                                     <Border MaxWidth="104"
                                                             Background="{DynamicResource UiXRecordingFillBrush}"
                                                            CornerRadius="6"
                                                            Padding="7,2">
                                                        <Border.Style>
                                                            <Style TargetType="{x:Type Border}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRecordingFile}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock FontSize="11"
                                                                   Foreground="#B10E1C"
                                                                   Text="{I18N RecordStatusOfRecording}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </Border>
                                                     <Border MaxWidth="104"
                                                             Background="{DynamicResource UiXStallFillBrush}"
                                                            CornerRadius="6"
                                                            Padding="7,2">
