                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding IsConverting}" Value="True" />
                                                                            <Condition Binding="{Binding IsRecordingFile}" Value="False" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock FontSize="11"
                                                                   Foreground="#A75600"
                                                                   Text="{I18N TranscodingChip}"
                                                                   TextTrimming="CharacterEllipsis" />
