<UserControl x:Class="Emerde.Views.ScreenRecordListWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:controls="clr-namespace:Emerde.Controls"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:c="http://schemas.github.com/computedconverters/2024/xaml"
                 xmlns:local="clr-namespace:Emerde.Views"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
                 FontSize="14"
                 SnapsToDevicePixels="True"
                 UseLayoutRounding="True"
                 mc:Ignorable="d">
    <UserControl.Resources>
        <local:VideoDateGroupLabelConverter x:Key="VideoDateGroupLabelConverter" />
        <DataTemplate x:Key="VideoDateGroupHeaderTemplate">
            <TextBlock FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource UiXTextPrimaryBrush}"
                       Text="{Binding Name, Converter={StaticResource VideoDateGroupLabelConverter}}" />
        </DataTemplate>
        <ItemsPanelTemplate x:Key="UiXVideoGroupPanelTemplate">
            <ui:VirtualizingWrapPanel Width="{Binding VideoCardGridWidth, RelativeSource={RelativeSource AncestorType={x:Type local:ScreenRecordListWindow}}}"
                                      HorizontalAlignment="Center"
                                      IsItemsHost="True"
                                      ItemSize="{Binding VideoCardItemSize, RelativeSource={RelativeSource AncestorType={x:Type local:ScreenRecordListWindow}}}"
                                      Orientation="Vertical"
                                      SpacingMode="None"
                                      StretchItems="False" />
        </ItemsPanelTemplate>
        <ControlTemplate x:Key="UiXVideoGroupTemplate" TargetType="{x:Type GroupItem}">
            <StackPanel Width="{Binding VideoCardGridWidth, RelativeSource={RelativeSource AncestorType={x:Type local:ScreenRecordListWindow}}}"
                        Margin="0,0,0,18"
                        HorizontalAlignment="Center"
                        SnapsToDevicePixels="True">
                <ContentPresenter Margin="6,8,6,0"
                                  HorizontalAlignment="Stretch"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
                <Border Height="1"
                        Margin="6,8,6,6"
                        Background="{DynamicResource UiXDividerBrush}" />
                <ItemsPresenter HorizontalAlignment="Stretch" />
            </StackPanel>
        </ControlTemplate>
        <Style x:Key="UiXVideoFadeStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource EmerdeSurfaceBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.StatusOfIsUiXEnabled, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource UiXPanelBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="VideoListToolbarButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
        <Style x:Key="VideoListIconButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
        <Style x:Key="VideoListHeaderButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource VideoListToolbarButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.StatusOfIsUiXEnabled, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" Value="True">
                    <Setter Property="Width" Value="36" />
                    <Setter Property="MinWidth" Value="36" />
                    <Setter Property="Padding" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="VideoListHeaderIconStyle" TargetType="{x:Type ui:FontIcon}">
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.StatusOfIsUiXEnabled, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" Value="True">
                    <Setter Property="Margin" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="VideoListHeaderLabelStyle" TargetType="{x:Type TextBlock}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.StatusOfIsUiXEnabled, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="VideoCardActionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="58" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
        <Style x:Key="VideoListScrollPageButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VideoListScrollThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbSurface"
                                Width="4"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource SystemFillColorSolidNeutralBrush}"
                                CornerRadius="2"
                                Opacity="0.6"
                                SnapsToDevicePixels="True" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbSurface" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbSurface" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VideoListScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Track x:Name="PART_Track"
                               Width="12"
                               HorizontalAlignment="Center"
                               IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                              Style="{StaticResource VideoListScrollPageButtonStyle}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource VideoListScrollThumbStyle}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                              Style="{StaticResource VideoListScrollPageButtonStyle}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VideoListScrollViewerStyle" TargetType="{x:Type ScrollViewer}">
            <Setter Property="Padding" Value="20,8,0,10" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid ClipToBounds="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="22" />
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0"
                                                    Margin="{TemplateBinding Padding}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Width="12"
                                       Margin="0,8,0,10"
                                       HorizontalAlignment="Center"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       Minimum="0"
                                       Orientation="Vertical"
                                       Style="{StaticResource VideoListScrollBarStyle}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VideoListBoxStyle" TargetType="{x:Type ListBox}" BasedOn="{StaticResource {x:Type ListBox}}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBox}">
                        <ScrollViewer Focusable="False"
                                      FocusVisualStyle="{x:Null}"
                                      CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                      Style="{StaticResource VideoListScrollViewerStyle}">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="VideoListDialogContent">
        <Grid x:Name="VideoListContentRoot"
              Margin="0"
              controls:MotionAssist.IsEntranceEnabled="True"
              controls:MotionAssist.EntranceOffsetY="8"
            controls:MotionAssist.EntranceTrigger="{Binding IsVideoListPageSelected}">
            <Grid.RowDefinitions>
                <RowDefinition Height="92" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="{StaticResource UiXPageHeaderMargin}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="44" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Text="{I18N VideoListTitle}" />

                    <StackPanel Grid.Column="2"
                                x:Name="VideoListHeaderActions"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="{x:Type StackPanel}">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="8" />
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.StatusOfIsUiXEnabled, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" Value="True">
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <TranslateTransform Y="0" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <StackPanel x:Name="VideoListExtensionToolbarHost"
                                    Orientation="Horizontal" />
                        <Button Command="{Binding RefreshCommand}"
                                Margin="0,0,8,0"
                                IsEnabled="{Binding IsIdle}"
                                Style="{StaticResource VideoListHeaderButtonStyle}"
                                ToolTip="{I18N RefreshVideoListShortcutHint}">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Style="{StaticResource VideoListHeaderIconStyle}"
                                             Glyph="{x:Static ui:FontSymbols.Sync}" />
                                <TextBlock Style="{StaticResource VideoListHeaderLabelStyle}" Text="{I18N RefreshButton}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ImportFolderCommand}"
                                Margin="0,0,8,0"
                                IsEnabled="{Binding IsIdle}"
                                Style="{StaticResource VideoListHeaderButtonStyle}"
                                ToolTip="{I18N ImportFolder}">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Style="{StaticResource VideoListHeaderIconStyle}"
                                             Glyph="{x:Static ui:FontSymbols.Add}" />
                                <TextBlock Style="{StaticResource VideoListHeaderLabelStyle}" Text="{I18N ImportFolder}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenSaveFolderCommand}"
                                Margin="0,0,8,0"
                                Style="{StaticResource VideoListHeaderButtonStyle}"
                                ToolTip="{I18N SaveFolder}">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Style="{StaticResource VideoListHeaderIconStyle}"
                                             Glyph="{x:Static ui:FontSymbols.FolderOpen}" />
                                <TextBlock Style="{StaticResource VideoListHeaderLabelStyle}" Text="{I18N SaveFolder}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding BeginMultiSelectCommand}"
                                ToolTip="{I18N EnterMultiSelectShortcutHint}">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource VideoListHeaderButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasVisibleVideos}" Value="True" />
                                                <Condition Binding="{Binding IsMultiSelectMode}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Style="{StaticResource VideoListHeaderIconStyle}"
                                             Glyph="{x:Static ui:FontSymbols.BulletedList}" />
                                <TextBlock Style="{StaticResource VideoListHeaderLabelStyle}" Text="{I18N MultiSelect}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1"
                        Padding="0,4"
                        Background="Transparent"
                        CornerRadius="{StaticResource Win11ControlCornerRadius}"
                        controls:MotionAssist.IsEntranceEnabled="True"
                        controls:MotionAssist.EntranceOffsetY="5"
                        controls:MotionAssist.EntranceScale="0.992"
                        controls:MotionAssist.EntranceTrigger="{Binding IsVideoListPageSelected}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <Button Command="{Binding ToggleSortCommand}"
                                    Margin="0,0,12,0"
                                    IsEnabled="{Binding IsIdle}"
                                    Style="{StaticResource VideoListToolbarButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:FontIcon Margin="0,0,7,0"
                                                 FontFamily="{DynamicResource SymbolThemeFontFamily}">
                                        <ui:FontIcon.Style>
                                            <Style TargetType="{x:Type ui:FontIcon}">
                                                <Setter Property="Glyph" Value="{x:Static ui:FontSymbols.ChevronUp}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSortDescending}" Value="True">
                                                        <Setter Property="Glyph" Value="{x:Static ui:FontSymbols.ChevronDown}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:FontIcon.Style>
                                    </ui:FontIcon>
                                    <TextBlock Text="{Binding SortDirectionText}" />
                                </StackPanel>
                            </Button>
                            <TextBlock Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{I18N StreamerLabel}" />
                            <ComboBox Width="158"
                                      Margin="0,0,14,0"
                                      ItemsSource="{Binding StreamerOptions}"
                                      SelectedItem="{Binding SelectedStreamer, Mode=TwoWay}" />
                            <TextBlock Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{I18N TimeRangeLabel}" />
                            <ComboBox Width="138"
                                      ItemsSource="{Binding TimeRangeOptions}"
                                      SelectedIndex="{Binding SelectedTimeRangeIndex, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="{x:Type StackPanel}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMultiSelectMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border MinHeight="30"
                                    Margin="0,0,8,0"
                                    Padding="10,0"
                                    Background="#144DA7B0"
                                    CornerRadius="{StaticResource Win11ControlCornerRadius}">
                                <TextBlock VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding SelectedVideoSummary}" />
                            </Border>
                            <Button Margin="0,0,8,0"
                                    Command="{Binding SelectAllCommand}"
                                    Style="{StaticResource VideoListIconButtonStyle}"
                                    ToolTip="{I18N SelectAllVideosShortcutHint}">
                                <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                             Glyph="{x:Static ui:FontSymbols.Accept}" />
                            </Button>
                            <Button Margin="0,0,8,0"
                                    Command="{Binding InvertSelectionCommand}"
                                    Style="{StaticResource VideoListIconButtonStyle}"
                                    ToolTip="{I18N InvertSelection}">
                                <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                             Glyph="{x:Static ui:FontSymbols.Switch}" />
                            </Button>
                            <Button Command="{Binding CancelMultiSelectCommand}"
                                    Style="{StaticResource VideoListIconButtonStyle}"
                                    ToolTip="{I18N ExitMultiSelectShortcutHint}">
                                <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                             Glyph="{x:Static ui:FontSymbols.CalculatorMultiply}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="VideoSelectionHost"
                  Grid.Row="1"
                  ClipToBounds="True"
                  PreviewMouseLeftButtonDown="VideoSelectionHostPreviewMouseLeftButtonDown"
                  PreviewMouseLeftButtonUp="VideoSelectionHostPreviewMouseLeftButtonUp"
                  PreviewMouseMove="VideoSelectionHostPreviewMouseMove"
                  PreviewMouseRightButtonDown="VideoSelectionHostPreviewMouseRightButtonDown"
                  LostMouseCapture="VideoSelectionHostLostMouseCapture">
                <ListBox x:Name="VideoListBox"
                          ItemsSource="{Binding Videos}"
                          Background="Transparent"
                          BorderThickness="0"
                          FocusVisualStyle="{x:Null}"
                          PreviewMouseWheel="VideoListBoxPreviewMouseWheel"
                          SelectedItem="{Binding RegularSelectedItem, Mode=TwoWay}"
                          SelectionMode="Single"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.IsDeferredScrollingEnabled="False"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.ScrollChanged="VideoListScrollChanged"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.Style>
                    <Style TargetType="{x:Type ListBox}" BasedOn="{StaticResource VideoListBoxStyle}">
                        <Setter Property="ItemsPanel">
                            <Setter.Value>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.Style>
                <ListBox.GroupStyle>
                    <GroupStyle HeaderTemplate="{StaticResource VideoDateGroupHeaderTemplate}"
                                Panel="{StaticResource UiXVideoGroupPanelTemplate}">
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="{x:Type GroupItem}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template" Value="{StaticResource UiXVideoGroupTemplate}" />
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="controls:MotionAssist.IsEntranceEnabled" Value="True" />
                        <Setter Property="controls:MotionAssist.EntranceOffsetY" Value="7" />
                        <Setter Property="controls:MotionAssist.EntranceScale" Value="0.99" />
                        <Setter Property="controls:MotionAssist.IsPressEnabled" Value="False" />
                        <Setter Property="controls:MotionAssist.HoverScale" Value="1" />
                        <Setter Property="controls:MotionAssist.PressScale" Value="0.996" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="VideoCardShell"
                                Padding="0"
                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type local:ScreenRecordListWindow}}}"
                                BorderThickness="0"
                                ClipToBounds="True"
                                CornerRadius="{StaticResource UiXSurfaceCornerRadius}"
                                controls:MotionAssist.IsDataContextEntranceEnabled="True"
                                controls:MotionAssist.EntranceTrigger="{Binding DataContext.IsVideoListPageSelected, RelativeSource={RelativeSource AncestorType={x:Type local:ScreenRecordListWindow}}}"
                                ContextMenuOpening="VideoCardContextMenuOpening"
                                Loaded="VideoCardLoaded">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <Setter Property="Background" Value="{DynamicResource EmerdePanelBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.StatusOfIsUiXEnabled, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" Value="True">
                                            <Setter Property="Width" Value="{Binding VideoCardWidth, RelativeSource={RelativeSource AncestorType={x:Type local:ScreenRecordListWindow}}}" />
                                            <Setter Property="Margin" Value="{Binding VideoCardMargin, RelativeSource={RelativeSource AncestorType={x:Type local:ScreenRecordListWindow}}}" />
                                            <Setter Property="Background" Value="{DynamicResource UiXVideoCardBrush}" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding DataContext.StatusOfIsUiXEnabled, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" Value="True" />
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="{DynamicResource UiXVideoCardHoverBrush}" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}"
                                             Placement="MousePoint"
                                             StaysOpen="False">
                                    <MenuItem Header="{I18N OpenVideo}"
                                              Command="{Binding Tag.OpenVideoCommand}"
                                              CommandParameter="{Binding DataContext}"
                                              IsEnabled="{Binding DataContext.CanModify}" />
                                    <MenuItem Header="{I18N OpenFolder}"
                                              Command="{Binding Tag.OpenDirectoryCommand}"
                                              CommandParameter="{Binding DataContext}"
                                              IsEnabled="{Binding DataContext.CanModify}" />
                                    <MenuItem Header="{I18N Rename}"
                                              Command="{Binding Tag.RenameVideoCommand}"
                                              CommandParameter="{Binding DataContext}"
                                              IsEnabled="{Binding DataContext.CanModify}" />
                                    <MenuItem Header="{I18N TranscodeVideo}"
                                              Command="{Binding Tag.TranscodeVideoCommand}"
                                              CommandParameter="{Binding DataContext}"
                                              IsEnabled="{Binding DataContext.CanTranscode}" />
                                    <Separator />
                                    <MenuItem Header="{I18N MergeVideos}"
                                              Command="{Binding Tag.OpenMergeSelectedCommand}"
                                              IsEnabled="{Binding Tag.CanMergeSelectedVideos}" />
                                    <MenuItem Header="{I18N SplitButton}"
                                              Command="{Binding Tag.SplitContextCommand}"
                                              CommandParameter="{Binding DataContext}"
                                              IsEnabled="{Binding DataContext.CanModify}" />
                                    <MenuItem Header="{I18N MoveButton}"
                                              Command="{Binding Tag.MoveContextCommand}"
                                              CommandParameter="{Binding DataContext}"
                                              IsEnabled="{Binding DataContext.CanModify}" />
                                    <MenuItem Header="{I18N CopyButton}"
                                              Command="{Binding Tag.CopyContextCommand}"
                                              CommandParameter="{Binding DataContext}"
                                              IsEnabled="{Binding DataContext.CanModify}" />
                                    <Separator />
                                    <MenuItem Header="{I18N DeleteButton}"
                                              Command="{Binding Tag.DeleteContextCommand}"
                                              CommandParameter="{Binding DataContext}"
                                              IsEnabled="{Binding DataContext.CanModify}" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid>
                                <Border x:Name="VideoCardSurfaceStroke"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource UiXNestedCornerRadius}"
                                        IsHitTestVisible="False">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <Border x:Name="VideoCardHoverLayer"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        BorderThickness="0"
                                        CornerRadius="{StaticResource UiXSurfaceCornerRadius}"
                                        IsHitTestVisible="False"
                                        Opacity="0" />
                                <Border x:Name="VideoCardSelectionLayer"
                                        Background="#18337DFF"
                                        BorderBrush="#78337DFF"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource UiXSurfaceCornerRadius}"
                                        IsHitTestVisible="False"
                                        Opacity="0" />
