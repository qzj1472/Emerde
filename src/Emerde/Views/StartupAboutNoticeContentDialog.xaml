<vio:ContentDialog x:Class="Emerde.Views.StartupAboutNoticeContentDialog"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:controls="clr-namespace:Emerde.Controls"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
                   Title="{Binding NoticeTitle}"
                   d:DesignHeight="NaN"
                   d:DesignWidth="NaN"
                   DefaultButton="Primary"
                   FontSize="14"
                   PrimaryButtonText="{I18N ButtonOfAcknowledge}"
                   SnapsToDevicePixels="True"
                   Style="{StaticResource DefaultVioletaContentDialogStyle}"
                   UseLayoutRounding="True"
                   mc:Ignorable="d">
    <Grid MinWidth="460"
          MaxWidth="560"
          Margin="0,2,0,0"
          controls:MotionAssist.IsEntranceEnabled="True"
          controls:MotionAssist.EntranceOffsetY="8"
          controls:MotionAssist.EntranceScale="0.98">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0"
                Width="36"
                Height="36"
                Margin="0,2,18,0"
                VerticalAlignment="Top"
                BorderBrush="#3CCBF4"
                BorderThickness="2"
                CornerRadius="18">
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#3CCBF4"
                       Text="i" />
        </Border>
        <TextBlock Grid.Column="1"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   LineHeight="20"
                   Text="{Binding Message}"
                   TextWrapping="Wrap" />
    </Grid>
</vio:ContentDialog>
