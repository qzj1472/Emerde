<UserControl x:Class="Emerde.Views.LivePreviewPanel"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="http://schemas.github.com/computedconverters/2024/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Focusable="False"
             FocusVisualStyle="{x:Null}"
             KeyboardNavigation.DirectionalNavigation="None"
             KeyboardNavigation.TabNavigation="None"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <Style x:Key="PreviewControlButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="ButtonChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Win11ControlCornerRadius}"
                            SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#28FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#55FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PreviewVolumeSliderStyle" TargetType="{x:Type Slider}">
            <Setter Property="Width" Value="88" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="SmallChange" Value="1" />
            <Setter Property="LargeChange" Value="10" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid Margin="6,0" Background="Transparent">
                            <Border Height="4"
                                    VerticalAlignment="Center"
                                    Background="#66FFFFFF"
                                    CornerRadius="2" />
                            <Track x:Name="PART_Track"
                                   Margin="0"
                                   VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Height="4"
                                                        Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                        CornerRadius="2" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Ellipse Fill="White" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Height="4" Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border x:Name="PanelChrome"
            Padding="0"
            Background="#050505"
            BorderThickness="0"
            ClipToBounds="True"
            CornerRadius="{StaticResource Win11ControlCornerRadius}"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid x:Name="PreviewViewport"
                  Grid.Row="0"
                  MinHeight="180"
                  Background="#050505"
                  ClipToBounds="True"
                  SnapsToDevicePixels="True">
                <Grid x:Name="VideoSurface"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Background="#050505"
                      ClipToBounds="True"
                      SnapsToDevicePixels="True">
                    <Image x:Name="PreviewVideoFrame"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           IsHitTestVisible="False"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True"
                           Stretch="Fill"
                           Visibility="Collapsed" />
                    <Image x:Name="PreviewRoomTransitionFrame"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           IsHitTestVisible="False"
                           Opacity="0"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True"
                           Stretch="Fill"
                           Visibility="Collapsed" />
                    <Grid x:Name="PreviewOverlayRoot"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          SnapsToDevicePixels="True"
                          Visibility="Collapsed">
                        <Border x:Name="PreviewTouchLayer"
                                Panel.ZIndex="0"
                                Background="#01000000"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                MouseEnter="PreviewViewport_OnMouseActivity"
                                MouseMove="PreviewViewport_OnMouseActivity"
                                MouseLeftButtonDown="PreviewTouchLayer_OnMouseLeftButtonDown"
                                MouseLeftButtonUp="PreviewTouchLayer_OnMouseLeftButtonUp"
                                PreviewMouseWheel="PreviewVolume_OnPreviewMouseWheel" />
                        <Button x:Name="PausedIndicator"
                                Panel.ZIndex="1"
                                Width="56"
                                Height="56"
                                Padding="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding TogglePreviewPauseCommand}"
                                Cursor="Hand"
                                Focusable="False"
                                FocusVisualStyle="{x:Null}"
                                PreviewMouseWheel="PreviewVolume_OnPreviewMouseWheel"
                                ToolTip="{Binding PreviewPlaybackToolTip}"
                                Visibility="Collapsed">
                            <Button.Template>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </ControlTemplate>
                            </Button.Template>
                            <Viewbox Width="48" Height="48" Stretch="Uniform">
                                <Canvas Width="24" Height="24">
                                    <Path x:Name="PausedIndicatorIcon"
                                          Data="M7,4 L20,12 L7,20 Z"
                                          Fill="White" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Border x:Name="TopFeedback"
                                Panel.ZIndex="3"
                                MinWidth="128"
                                Margin="20"
                                Padding="12,8"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Background="#E61B1B1B"
                                BorderThickness="0"
                                CornerRadius="8"
                                IsHitTestVisible="False"
                                Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <Viewbox x:Name="TopFullScreenFeedbackIcon"
                                         Width="18"
                                         Height="18"
                                         Margin="0,0,8,0"
                                         Stretch="Uniform">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M5,10 L5,5 L10,5 M14,5 L19,5 L19,10 M19,14 L19,19 L14,19 M10,19 L5,19 L5,14"
                                              Fill="Transparent"
                                              Stroke="White"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock x:Name="TopFeedbackText"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="White" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="BottomFeedback"
                                Panel.ZIndex="3"
                                MinWidth="128"
                                Margin="20,20,20,72"
                                Padding="12,8"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Background="#E61B1B1B"
                                BorderThickness="0"
                                CornerRadius="8"
                                IsHitTestVisible="False"
                                Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <Viewbox x:Name="BottomVolumeFeedbackIcon"
                                         Width="18"
                                         Height="18"
                                         Margin="0,0,8,0"
                                         Stretch="Uniform">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M4,9 L8,9 L13,5 L13,19 L8,15 L4,15 Z" Fill="White" />
                                        <Path Data="M16,8 C18,10 18,14 16,16 M18,5 C22,9 22,15 18,19"
                                              Fill="Transparent"
                                              Stroke="White"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" />
                                    </Canvas>
                                </Viewbox>
                                <Viewbox x:Name="BottomMutedFeedbackIcon"
                                         Width="18"
                                         Height="18"
                                         Margin="0,0,8,0"
                                         Stretch="Uniform"
                                         Visibility="Collapsed">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M4,9 L8,9 L13,5 L13,19 L8,15 L4,15 Z" Fill="White" />
                                        <Path Data="M17,9 L21,13 M21,9 L17,13"
                                              Stroke="White"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock x:Name="BottomFeedbackText"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="White" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="PreviewCloseButton"
                                Panel.ZIndex="4"
                                Margin="12"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="#99000000"
                                Command="{Binding StopPreviewCommand}"
                                IsHitTestVisible="False"
                                Opacity="0"
                                Style="{StaticResource PreviewControlButtonStyle}"
                                ToolTip="关闭预览 (Esc)"
                                MouseEnter="PreviewControls_OnMouseEnter"
                                MouseLeave="PreviewControls_OnMouseLeave">
                            <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                         FontSize="14"
                                         Glyph="{x:Static ui:FontSymbols.CalculatorMultiply}" />
                        </Button>
                        <Border x:Name="PreviewControls"
                                Panel.ZIndex="4"
                                Margin="12"
                                Padding="6,3"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Bottom"
                                Background="#D9161616"
                                BorderThickness="0"
                                CornerRadius="8"
                                IsHitTestVisible="False"
                                Opacity="0"
                                MouseEnter="PreviewControls_OnMouseEnter"
                                MouseLeave="PreviewControls_OnMouseLeave">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button Style="{StaticResource PreviewControlButtonStyle}"
                                            Command="{Binding TogglePreviewPauseCommand}"
                                            IsEnabled="{Binding PreviewingRoom.CanPreview}"
                                            ToolTip="{Binding PreviewPlaybackToolTip}">
                                        <ContentControl>
                                            <c:If Condition="{Binding IsPreviewPlaying}">
                                                <c:If.TrueValue>
                                                    <Viewbox Width="18" Height="18" Stretch="Uniform">
                                                        <Canvas Width="24" Height="24">
                                                            <Rectangle Canvas.Left="5" Canvas.Top="4" Width="5" Height="16" Fill="White" RadiusX="0" RadiusY="0" />
                                                            <Rectangle Canvas.Left="14" Canvas.Top="4" Width="5" Height="16" Fill="White" RadiusX="0" RadiusY="0" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </c:If.TrueValue>
                                                <c:If.FalseValue>
                                                    <Viewbox Width="18" Height="18" Stretch="Uniform">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Data="M6,3 L21,12 L6,21 Z" Fill="White" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </c:If.FalseValue>
                                            </c:If>
                                        </ContentControl>
                                    </Button>
                                    <Button Width="26"
                                            Style="{StaticResource PreviewControlButtonStyle}"
                                            Command="{Binding RefreshPreviewCommand}"
                                            IsEnabled="{Binding IsPreviewing}"
                                            ToolTip="刷新预览 (G)">
                                        <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                     FontSize="11"
                                                     Glyph="{x:Static ui:FontSymbols.Sync}" />
                                    </Button>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0" Orientation="Horizontal">
                                    <Button Style="{StaticResource PreviewControlButtonStyle}"
                                            Command="{Binding TogglePreviewMuteCommand}"
                                            ToolTip="{Binding PreviewMuteToolTip}">
                                        <ContentControl>
                                            <c:If Condition="{Binding IsPreviewMuted}">
                                                <c:If.TrueValue>
                                                    <Viewbox Width="16" Height="16" Stretch="Uniform">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Data="M4,9 L8,9 L13,5 L13,19 L8,15 L4,15 Z" Fill="White" />
                                                            <Path Data="M17,9 L21,13 M21,9 L17,13" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </c:If.TrueValue>
                                                <c:If.FalseValue>
                                                    <Viewbox Width="16" Height="16" Stretch="Uniform">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Data="M4,9 L8,9 L13,5 L13,19 L8,15 L4,15 Z" Fill="White" />
                                                            <Path Data="M16,8 C18,10 18,14 16,16 M18,5 C22,9 22,15 18,19" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </c:If.FalseValue>
                                            </c:If>
                                        </ContentControl>
                                    </Button>
                                    <Grid Width="88" Height="30" Margin="2,0,0,0">
                                        <Slider x:Name="PreviewVolumeSlider"
                                                Style="{StaticResource PreviewVolumeSliderStyle}"
                                                ToolTip="{Binding PreviewVolumeToolTip}"
                                                PreviewMouseLeftButtonDown="PreviewVolumeSlider_OnPreviewMouseLeftButtonDown"
                                                PreviewMouseWheel="PreviewVolume_OnPreviewMouseWheel"
                                                Value="{Binding PreviewVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </StackPanel>
                                <ui:StackPanel Grid.Column="2"
                                               Margin="12,0"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Orientation="Horizontal"
                                               Spacing="7">
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="12"
                                               Foreground="White"
                                               Text="{Binding LivePreviewStatusText}" />
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="12"
                                               Foreground="#AFFFFFFF"
                                               Text="·" />
                                    <TextBlock MaxWidth="180"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Foreground="#AFFFFFFF"
                                               Text="{Binding PreviewingRoom.PreviewSourceText, Mode=OneWay}"
                                               TextTrimming="CharacterEllipsis" />
                                </ui:StackPanel>
                                <Button x:Name="WindowSizeButton"
                                        Grid.Column="3"
                                        Style="{StaticResource PreviewControlButtonStyle}"
                                        Click="ToggleWindowSize_OnClick">
                                    <Grid>
                                        <Viewbox x:Name="MaximizeIcon" Width="16" Height="16" Stretch="Uniform">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M5,10 L5,5 L10,5 M14,5 L19,5 L19,10 M19,14 L19,19 L14,19 M10,19 L5,19 L5,14" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                                            </Canvas>
                                        </Viewbox>
                                        <Viewbox x:Name="RestoreIcon" Width="16" Height="16" Stretch="Uniform" Visibility="Collapsed">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M8,4 L20,4 L20,16 M4,8 L16,8 L16,20 L4,20 Z" Stroke="White" StrokeThickness="2" StrokeLineJoin="Round" Fill="Transparent" />
                                            </Canvas>
                                        </Viewbox>
                                    </Grid>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
