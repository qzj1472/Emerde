<UserControl x:Class="Emerde.Views.AboutContentDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:base="clr-namespace:Emerde"
             xmlns:controls="clr-namespace:Emerde.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:Emerde.Views"
             FontSize="14"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="UiXAboutFadeStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource EmerdeSurfaceBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.StatusOfIsUiXEnabled, RelativeSource={RelativeSource AncestorType={x:Type views:MainWindow}}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource UiXPanelBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AboutHeroTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.StatusOfIsUiXEnabled, RelativeSource={RelativeSource AncestorType={x:Type views:MainWindow}}}" Value="True">
                    <Setter Property="FontSize" Value="24" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="{DynamicResource UiXTextPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AboutSectionTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,18,0,0" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.StatusOfIsUiXEnabled, RelativeSource={RelativeSource AncestorType={x:Type views:MainWindow}}}" Value="True">
                    <Setter Property="FontSize" Value="17" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="{DynamicResource UiXTextPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AboutSectionDescriptionStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,-2,0,2" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.StatusOfIsUiXEnabled, RelativeSource={RelativeSource AncestorType={x:Type views:MainWindow}}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource UiXTextSecondaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AboutCardStyle" TargetType="{x:Type Border}">
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Background" Value="{DynamicResource EmerdeCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Win11ControlCornerRadius}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.StatusOfIsUiXEnabled, RelativeSource={RelativeSource AncestorType={x:Type views:MainWindow}}}" Value="True">
                    <Setter Property="Padding" Value="12,10" />
                    <Setter Property="Background" Value="{DynamicResource UiXCardBrush}" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AboutWorkflowCardStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource AboutCardStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.StatusOfIsUiXEnabled, RelativeSource={RelativeSource AncestorType={x:Type views:MainWindow}}}" Value="True">
                    <Setter Property="Padding" Value="12,10" />
                    <Setter Property="Background" Value="{DynamicResource UiXCardBrush}" />
                    <Setter Property="CornerRadius" Value="{StaticResource UiXSurfaceCornerRadius}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AboutCardTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource EmerdeAboutCardTitleBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.StatusOfIsUiXEnabled, RelativeSource={RelativeSource AncestorType={x:Type views:MainWindow}}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource UiXTextPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AboutStepNumberStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="AboutBodyTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.StatusOfIsUiXEnabled, RelativeSource={RelativeSource AncestorType={x:Type views:MainWindow}}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource UiXTextSecondaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AboutBulletTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource AboutBodyTextStyle}">
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="AboutShortcutItemStyle" TargetType="{x:Type Border}">
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Padding" Value="2,3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="AboutShortcutKeyPillStyle" TargetType="{x:Type Border}">
            <Setter Property="MinWidth" Value="86" />
            <Setter Property="Padding" Value="0,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="AboutShortcutKeyTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource EmerdeAboutShortcutKeyBrush}" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
        <Style x:Key="AboutShortcutDescriptionTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="12,1,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource EmerdeAboutShortcutDescriptionBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="AboutWarningTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#D83B01" />
        </Style>
        <Style x:Key="AboutHeroCardStyle" TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="18" />
            <Setter Property="Background" Value="{DynamicResource EmerdeCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Win11ControlCornerRadius}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.StatusOfIsUiXEnabled, RelativeSource={RelativeSource AncestorType={x:Type views:MainWindow}}}" Value="True">
                    <Setter Property="Padding" Value="4,2,4,8" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="CornerRadius" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AboutNavigationButtonStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="NavigationChrome"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                CornerRadius="{StaticResource Win11ControlCornerRadius}">
                            <Grid>
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           Foreground="{TemplateBinding Foreground}"
                                           Text="{TemplateBinding Content}" />
                                <Border x:Name="NavigationIndicator"
                                        Width="20"
                                        Height="2"
                                        Margin="0,0,0,3"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                                        CornerRadius="1"
                                        Opacity="0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding DataContext.StatusOfIsUiXEnabled, RelativeSource={RelativeSource AncestorType={x:Type views:MainWindow}}}" Value="True">
                                <Setter TargetName="NavigationChrome" Property="CornerRadius" Value="{StaticResource UiXNavigationCornerRadius}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavigationChrome" Property="Background" Value="{DynamicResource UiXSubtleFillBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource UiXTextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavigationChrome" Property="Background" Value="{DynamicResource UiXSelectionFillBrush}" />
                                <Setter TargetName="NavigationIndicator" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="{DynamicResource UiXTextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AboutReleaseNotesSurfaceStyle" TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="18" />
            <Setter Property="Background" Value="{DynamicResource EmerdeCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Win11ControlCornerRadius}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.StatusOfIsUiXEnabled, RelativeSource={RelativeSource AncestorType={x:Type views:MainWindow}}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource UiXCardBrush}" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AboutReleaseNotesComboBoxStyle"
               TargetType="{x:Type ComboBox}"
               BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="BorderBrush" Value="{DynamicResource UiXStrongStrokeBrush}" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource UiXSelectionStrokeBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid ClipToBounds="True"
          controls:MotionAssist.IsEntranceEnabled="True"
          controls:MotionAssist.EntranceOffsetY="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <WrapPanel Grid.Row="0" Margin="20,10,20,10">
            <RadioButton Click="AboutNavigationButtonClick"
                         CommandParameter="Overview"
                         Content="{Binding OverviewNavigationLabel}"
                         GroupName="AboutNavigation"
                         IsChecked="True"
                         Style="{StaticResource AboutNavigationButtonStyle}" />
            <RadioButton Click="AboutNavigationButtonClick"
                         CommandParameter="ReleaseNotes"
                         Content="{Binding ReleaseNotesNavigationLabel}"
                         GroupName="AboutNavigation"
                         Style="{StaticResource AboutNavigationButtonStyle}" />
        </WrapPanel>
        <Grid Grid.Row="1">
        <ScrollViewer x:Name="AboutOverviewScrollViewer"
                      BorderThickness="0"
                      Focusable="False"
                      IsTabStop="False"
                      FocusVisualStyle="{x:Null}"
                      HorizontalScrollBarVisibility="Disabled"
                      ScrollChanged="AboutOverviewScrollChanged"
                      VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Style>
                <Style TargetType="{x:Type ScrollViewer}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsReleaseNotesSelected}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <Border x:Name="AboutOverviewContent" Padding="20,10,20,20">
                <ui:StackPanel HorizontalAlignment="Stretch" Spacing="18">
                    <Border Style="{StaticResource AboutHeroCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="78"
                                    Height="78"
                                    Background="Transparent"
                                    CornerRadius="0"
                                    ClipToBounds="True">
                                <Image RenderOptions.BitmapScalingMode="HighQuality"
                                       Source="pack://application:,,,/Assets/Favicon.png"
                                       Stretch="UniformToFill" />
                            </Border>
                            <ui:StackPanel Grid.Column="1"
                                           Margin="18,0,0,0"
                                           VerticalAlignment="Center"
                                           Spacing="8">
                                <WrapPanel>
                                    <TextBlock Style="{StaticResource AboutHeroTitleStyle}"
                                               Text="{x:Static base:AppConfig.PackName}" />
                                    <Border Padding="8,3"
                                            VerticalAlignment="Center"
                                            Background="#14337DFF"
                                            CornerRadius="{StaticResource Win11ControlCornerRadius}">
                                        <TextBlock Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                   Text="{x:Static base:AppConfig.Version}" />
                                    </Border>
                                </WrapPanel>
                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           LineHeight="20"
                                            Text="{I18N AboutTagline}"
                                           TextWrapping="Wrap" />
                                <WrapPanel>
                                    <ui:HyperlinkButton Command="{Binding OpenHyperlinkCommand}"
                                                        Content="{I18N ProjectHomepage}"
                                                        Cursor="Hand"
                                                        Padding="0" />
                                    <TextBlock Margin="10,0"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="·" />
                                    <ui:HyperlinkButton Command="{Binding OpenHyperlinkCommand}"
                                                        CommandParameter="https://github.com/ihmily/DouyinLiveRecorder"
                                                        Content="{I18N ReferenceRepository}"
                                                        Cursor="Hand"
                                                        Padding="0" />
                                </WrapPanel>
                            </ui:StackPanel>
                        </Grid>
                    </Border>

                    <ui:StackPanel Spacing="3">
                        <TextBlock Style="{StaticResource AboutSectionTitleStyle}" Text="{I18N QuickStart}" />
                        <TextBlock Style="{StaticResource AboutSectionDescriptionStyle}" Text="{I18N QuickStartDescription}" />
                    </ui:StackPanel>
                    <WrapPanel Margin="0,0,-12,0">
                        <Border Width="{Binding WorkflowCardWidth}" Style="{StaticResource AboutWorkflowCardStyle}">
                            <ui:StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource AboutStepNumberStyle}" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" Text="01" />
                                <TextBlock Style="{StaticResource AboutCardTitleStyle}" Text="{I18N AddLiveRoom}" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="{I18N AboutPasteRoomLink}" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="{I18N AboutConfirmPlatformStreamer}" />
                            </ui:StackPanel>
                        </Border>
                        <Border Width="{Binding WorkflowCardWidth}" Style="{StaticResource AboutWorkflowCardStyle}">
                            <ui:StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource AboutStepNumberStyle}" Foreground="#168A55" Text="02" />
                                <TextBlock Style="{StaticResource AboutCardTitleStyle}" Text="{I18N EnableMonitoring}" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="{I18N AboutMonitorDiscovers}" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="{I18N AboutRecordingNeedsMonitoring}" />
                            </ui:StackPanel>
                        </Border>
                        <Border Width="{Binding WorkflowCardWidth}" Style="{StaticResource AboutWorkflowCardStyle}">
                            <ui:StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource AboutStepNumberStyle}" Foreground="#D83B01" Text="03" />
                                <TextBlock Style="{StaticResource AboutCardTitleStyle}" Text="{I18N EnableRecording}" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="{I18N AboutAutoRecordOnStream}" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="{I18N AboutHomeShowsRecording}" />
                            </ui:StackPanel>
                        </Border>
                        <Border Width="{Binding WorkflowCardWidth}" Style="{StaticResource AboutWorkflowCardStyle}">
                            <ui:StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource AboutStepNumberStyle}" Foreground="#7A4DA0" Text="04" />
                                <TextBlock Style="{StaticResource AboutCardTitleStyle}" Text="{I18N ManageVideos}" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="{I18N AboutVideoListProgress}" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="{I18N AboutVideoOperations}" />
                            </ui:StackPanel>
                        </Border>
                    </WrapPanel>

                    <ui:StackPanel Spacing="3">
                        <TextBlock Style="{StaticResource AboutSectionTitleStyle}" Text="{I18N RecordingAndDetection}" />
                        <TextBlock Style="{StaticResource AboutSectionDescriptionStyle}" Text="{I18N RecordingAndDetectionDescription}" />
                    </ui:StackPanel>
                    <WrapPanel Margin="0,0,-12,0">
                        <Border Width="{Binding AboutCardWidth}" Style="{StaticResource AboutCardStyle}">
                            <ui:StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource AboutCardTitleStyle}" Text="{I18N MonitoringAndRecording}" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="{I18N AboutMonitorVsRecord}" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="{I18N AboutUnknownStatusRetry}" />
                            </ui:StackPanel>
                        </Border>
                        <Border Width="{Binding AboutCardWidth}" Style="{StaticResource AboutCardStyle}">
                            <ui:StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource AboutCardTitleStyle}" Text="{I18N DetectionIntervals}" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="{I18N AboutOfflineInterval}" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="{I18N AboutLiveInterval}" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="{I18N AboutRecentEndedInterval}" />
                            </ui:StackPanel>
                        </Border>
                        <Border Width="{Binding AboutCardWidth}" Style="{StaticResource AboutCardStyle}">
                            <ui:StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource AboutCardTitleStyle}" Text="{I18N RecordFormat}" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="{I18N AboutTsFlvRaw}" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="{I18N AboutMp4MkvConvert}" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="{I18N AboutDoNotExitProcessing}" />
                            </ui:StackPanel>
                        </Border>
                        <Border Width="{Binding AboutCardWidth}" Style="{StaticResource AboutCardStyle}">
                            <ui:StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource AboutCardTitleStyle}" Text="{I18N NetworkRecovery}" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="{I18N AboutNetworkRecovery}" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="{I18N AboutRecoveryNewSegment}" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="{I18N AboutCannotRecoverMissing}" />
                            </ui:StackPanel>
                        </Border>
                        <Border Width="{Binding AboutCardWidth}" Style="{StaticResource AboutCardStyle}">
                            <ui:StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource AboutCardTitleStyle}" Text="{I18N NetworkSpeedTest}" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="{I18N AboutSpeedTestEstimate}" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="{I18N AboutRecordingCapacityFactors}" />
                            </ui:StackPanel>
                        </Border>
                    </WrapPanel>

                    <ui:StackPanel Spacing="3">
                        <TextBlock Style="{StaticResource AboutSectionTitleStyle}" Text="{I18N FilesAndData}" />
                        <TextBlock Style="{StaticResource AboutSectionDescriptionStyle}" Text="{I18N FilesAndDataDescription}" />
                    </ui:StackPanel>
                    <WrapPanel Margin="0,0,-12,0">
                        <Border Width="{Binding AboutCardWidth}" Style="{StaticResource AboutCardStyle}">
                            <ui:StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource AboutCardTitleStyle}" Text="{I18N VideoListTitle}" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="{I18N AboutVideoListStatuses}" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="{I18N AboutRecordingFileLocked}" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="{I18N AboutTranscodingFileWarning}" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="{I18N AboutVerifySegment}" />
                            </ui:StackPanel>
                        </Border>
                        <Border Width="{Binding AboutCardWidth}" Style="{StaticResource AboutCardStyle}">
                            <ui:StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource AboutCardTitleStyle}" Text="{I18N StorageAndCleanup}" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="{I18N AboutSaveFolderSpace}" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="{I18N AboutRetentionCleanup}" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="{I18N AboutUpdatePreserveRecordings}" />
                            </ui:StackPanel>
                        </Border>
                        <Border Width="{Binding AboutCardWidth}" Style="{StaticResource AboutCardStyle}">
                            <ui:StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource AboutCardTitleStyle}" Text="{I18N LogsAndSettings}" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="{I18N AboutExportLogs}" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="{I18N AboutSettingsBackup}" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="{I18N AboutValidateImport}" />
                            </ui:StackPanel>
                        </Border>
                        <Border Width="{Binding AboutCardWidth}" Style="{StaticResource AboutCardStyle}">
                            <ui:StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource AboutCardTitleStyle}" Text="{I18N ExitAndRecovery}" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="{I18N AboutCloseToTray}" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="{I18N AboutExitFromMenu}" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="{I18N AboutResumePendingTasks}" />
                            </ui:StackPanel>
                        </Border>
                    </WrapPanel>

                    <ui:StackPanel Spacing="3">
                        <TextBlock Style="{StaticResource AboutSectionTitleStyle}" Text="{I18N ShortcutReference}" />
                        <TextBlock Style="{StaticResource AboutSectionDescriptionStyle}" Text="{I18N ShortcutReferenceHint}" />
                    </ui:StackPanel>
                    <WrapPanel Margin="0,0,-12,0">
                        <Border Width="{Binding AboutCardWidth}" Style="{StaticResource AboutCardStyle}">
                            <ui:StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource AboutCardTitleStyle}" Text="{I18N PagesAndWindows}" />
                                <UniformGrid Columns="2">
                                    <Border Style="{StaticResource AboutShortcutItemStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource AboutShortcutKeyPillStyle}"><TextBlock Style="{StaticResource AboutShortcutKeyTextStyle}" Text="Tab" /></Border>
                                            <TextBlock Grid.Column="1" Style="{StaticResource AboutShortcutDescriptionTextStyle}" Text="{I18N NavigateNextPage}" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource AboutShortcutItemStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource AboutShortcutKeyPillStyle}"><TextBlock Style="{StaticResource AboutShortcutKeyTextStyle}" Text="Alt+1~5" /></Border>
                                            <TextBlock Grid.Column="1" Style="{StaticResource AboutShortcutDescriptionTextStyle}" Text="{I18N NavigateDirectly}" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource AboutShortcutItemStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource AboutShortcutKeyPillStyle}"><TextBlock Style="{StaticResource AboutShortcutKeyTextStyle}" Text="Ctrl+W" /></Border>
                                            <TextBlock Grid.Column="1" Style="{StaticResource AboutShortcutDescriptionTextStyle}" Text="{I18N CloseWindow}" />
