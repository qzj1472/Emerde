<UserControl x:Class="Emerde.Views.AboutContentDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:base="clr-namespace:Emerde"
             xmlns:controls="clr-namespace:Emerde.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             FontSize="14"
             SizeChanged="AboutContentDialogSizeChanged"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="AboutHeroTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="AboutSectionTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,14,0,0" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
        </Style>
        <Style x:Key="AboutSectionDescriptionStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,-2,0,2" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="AboutCardStyle" TargetType="{x:Type Border}">
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Background" Value="{DynamicResource EmerdeCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Win11ControlCornerRadius}" />
        </Style>
        <Style x:Key="AboutCardTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource EmerdeAboutCardTitleBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="AboutStepNumberStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="AboutBodyTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="AboutBulletTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource AboutBodyTextStyle}">
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="AboutShortcutItemStyle" TargetType="{x:Type Border}">
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Padding" Value="2,3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="AboutShortcutKeyPillStyle" TargetType="{x:Type Border}">
            <Setter Property="MinWidth" Value="86" />
            <Setter Property="Padding" Value="0,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="AboutShortcutKeyTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource EmerdeAboutShortcutKeyBrush}" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
        <Style x:Key="AboutShortcutDescriptionTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="12,1,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource EmerdeAboutShortcutDescriptionBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="AboutWarningTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#D83B01" />
        </Style>
    </UserControl.Resources>

    <Grid ClipToBounds="True"
          controls:MotionAssist.IsEntranceEnabled="True"
          controls:MotionAssist.EntranceOffsetY="8">
        <ScrollViewer BorderThickness="0"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Border Padding="24,18,24,28">
                <ui:StackPanel HorizontalAlignment="Stretch" Spacing="18">
                    <Border Padding="18"
                            Background="{DynamicResource EmerdeCardBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Win11ControlCornerRadius}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="78"
                                    Height="78"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="{StaticResource Win11ControlCornerRadius}"
                                    ClipToBounds="True">
                                <Image RenderOptions.BitmapScalingMode="HighQuality"
                                       Source="pack://application:,,,/Assets/Favicon.png"
                                       Stretch="UniformToFill" />
                            </Border>
                            <ui:StackPanel Grid.Column="1"
                                           Margin="18,0,0,0"
                                           VerticalAlignment="Center"
                                           Spacing="8">
                                <WrapPanel>
                                    <TextBlock Style="{StaticResource AboutHeroTitleStyle}"
                                               Text="{x:Static base:AppConfig.PackName}" />
                                    <Border Padding="8,3"
                                            VerticalAlignment="Center"
                                            Background="#14337DFF"
                                            CornerRadius="{StaticResource Win11ControlCornerRadius}">
                                        <TextBlock Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                   Text="{x:Static base:AppConfig.Version}" />
                                    </Border>
                                </WrapPanel>
                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           LineHeight="20"
                                           Text="面向多直播间的监控、预览、录制与文件管理工具。这里保留日常使用最需要知道的规则。"
                                           TextWrapping="Wrap" />
                                <WrapPanel>
                                    <ui:HyperlinkButton Command="{Binding OpenHyperlinkCommand}"
                                                        Content="项目主页"
                                                        Cursor="Hand"
                                                        Padding="0" />
                                    <TextBlock Margin="10,0"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="·" />
                                    <ui:HyperlinkButton Command="{Binding OpenHyperlinkCommand}"
                                                        CommandParameter="https://github.com/ihmily/DouyinLiveRecorder"
                                                        Content="参考仓库"
                                                        Cursor="Hand"
                                                        Padding="0" />
                                </WrapPanel>
                            </ui:StackPanel>
                        </Grid>
                    </Border>

                    <ui:StackPanel Spacing="3">
                        <TextBlock Style="{StaticResource AboutSectionTitleStyle}" Text="快速开始" />
                        <TextBlock Style="{StaticResource AboutSectionDescriptionStyle}" Text="正常录制只需要确认四个开关和一个保存位置。" />
                    </ui:StackPanel>
                    <WrapPanel>
                        <Border Width="{Binding WorkflowCardWidth}" Style="{StaticResource AboutCardStyle}">
                            <ui:StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource AboutStepNumberStyle}" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" Text="01" />
                                <TextBlock Style="{StaticResource AboutCardTitleStyle}" Text="添加直播间" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="• 粘贴直播间链接" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="• 确认平台和主播信息" />
                            </ui:StackPanel>
                        </Border>
                        <Border Width="{Binding WorkflowCardWidth}" Style="{StaticResource AboutCardStyle}">
                            <ui:StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource AboutStepNumberStyle}" Foreground="#168A55" Text="02" />
                                <TextBlock Style="{StaticResource AboutCardTitleStyle}" Text="开启监控" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="• 发现开播、关播和状态变化" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="• 只录制不开监控，不会主动发现开播" />
                            </ui:StackPanel>
                        </Border>
                        <Border Width="{Binding WorkflowCardWidth}" Style="{StaticResource AboutCardStyle}">
                            <ui:StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource AboutStepNumberStyle}" Foreground="#D83B01" Text="03" />
                                <TextBlock Style="{StaticResource AboutCardTitleStyle}" Text="允许录制" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="• 检测到可用直播流后才会开始" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="• 录制中会显示写入状态和读秒" />
                            </ui:StackPanel>
                        </Border>
                        <Border Width="{Binding WorkflowCardWidth}" Style="{StaticResource AboutCardStyle}">
                            <ui:StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource AboutStepNumberStyle}" Foreground="#7A4DA0" Text="04" />
                                <TextBlock Style="{StaticResource AboutCardTitleStyle}" Text="管理文件" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="• 到视频列表查看成品" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="• 支持转码、分割、合并、移动和删除" />
                            </ui:StackPanel>
                        </Border>
                    </WrapPanel>

                    <ui:StackPanel Spacing="3">
                        <TextBlock Style="{StaticResource AboutSectionTitleStyle}" Text="录制与检测" />
                        <TextBlock Style="{StaticResource AboutSectionDescriptionStyle}" Text="这些规则决定软件什么时候刷新、什么时候开始录制、什么时候停止录制。" />
                    </ui:StackPanel>
                    <WrapPanel>
                        <Border Width="{Binding AboutCardWidth}" Style="{StaticResource AboutCardStyle}">
                            <ui:StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource AboutCardTitleStyle}" Text="监控、直播状态与连麦" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="• 连麦中的抖音直播间会结合直播状态和实际可用流判断" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="• 全部接口都无法确认时，会保留原状态，不把检测失败当成关播" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="• 手动刷新只刷新当前目标，不会被其他房间失败拖住" />
                            </ui:StackPanel>
                        </Border>
                        <Border Width="{Binding AboutCardWidth}" Style="{StaticResource AboutCardStyle}">
                            <ui:StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource AboutCardTitleStyle}" Text="检测间隔" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="• 未开播房间使用设置里的检测间隔，默认 5 秒，通常保持默认值即可" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="• 直播中的房间固定每 10 秒检查一次" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="• 直播结束后的 30 分钟内固定每 10 秒检查一次" />
                            </ui:StackPanel>
                        </Border>
                        <Border Width="{Binding AboutCardWidth}" Style="{StaticResource AboutCardStyle}">
                            <ui:StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource AboutCardTitleStyle}" Text="录制状态" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="• FFmpeg 录制进程结束后，会立即刷新对应卡片的录制状态" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="• 直播状态由下一次固定 10 秒检测更新" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="• TS/FLV 保存原始数据；MP4/MKV 会在录制结束后转换" />
                            </ui:StackPanel>
                        </Border>
                        <Border Width="{Binding AboutCardWidth}" Style="{StaticResource AboutCardStyle}">
                            <ui:StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource AboutCardTitleStyle}" Text="测速" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="• 首页底部状态栏的“测速”用于查看当前网络状态，并预计能同时录制多少路直播" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="• 会分别检查国内和国外线路，连续完成三轮下载并取平均值" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="• 可录路数会按当前开播房间的平台选择对应线路" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="• 多路录制时还要预留下载带宽和磁盘写入空间" />
                            </ui:StackPanel>
                        </Border>
                    </WrapPanel>

                    <ui:StackPanel Spacing="3">
                        <TextBlock Style="{StaticResource AboutSectionTitleStyle}" Text="文件与维护" />
                        <TextBlock Style="{StaticResource AboutSectionDescriptionStyle}" Text="录制文件、日志和配置都尽量保留可恢复空间，减少误删。" />
                    </ui:StackPanel>
                    <WrapPanel>
                        <Border Width="{Binding AboutCardWidth}" Style="{StaticResource AboutCardStyle}">
                            <ui:StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource AboutCardTitleStyle}" Text="视频列表" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="• 显示可管理的视频和任务状态" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="• 正在录制写入的文件不能选中或操作" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="• 转码中的文件会显示状态提示，避免误删" />
                            </ui:StackPanel>
                        </Border>
                        <Border Width="{Binding AboutCardWidth}" Style="{StaticResource AboutCardStyle}">
                            <ui:StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource AboutCardTitleStyle}" Text="保存目录与清理" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="• 保存目录应放在空间充足的位置" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="• 保留期清理只处理带有效 Emerde 元数据的录制" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="• 更新版本时保留 downloads、video_thumbnails、logs、cache 和配置文件" />
                            </ui:StackPanel>
                        </Border>
                        <Border Width="{Binding AboutCardWidth}" Style="{StaticResource AboutCardStyle}">
                            <ui:StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource AboutCardTitleStyle}" Text="日志与配置" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="• 导出当天日志会打包当天文件，导出全部会打包全部日志" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="• 配置文件和备份点都在 Emerde\config 文件夹内管理" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="• 导入、恢复或重置配置前会先验证文件" />
                            </ui:StackPanel>
                        </Border>
                        <Border Width="{Binding AboutCardWidth}" Style="{StaticResource AboutCardStyle}">
                            <ui:StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource AboutCardTitleStyle}" Text="退出按钮、关闭窗口与恢复" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="• 右上角关闭按钮只隐藏主窗口，软件仍会留在托盘" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="• 完全退出请使用侧边栏或托盘菜单中的“退出”" />
                                <TextBlock Style="{StaticResource AboutBulletTextStyle}" Text="• 未完成的收尾、分割或转码任务会在下次启动继续处理" />
                            </ui:StackPanel>
                        </Border>
                    </WrapPanel>

                    <ui:StackPanel Spacing="3">
                        <TextBlock Style="{StaticResource AboutSectionTitleStyle}" Text="快捷键速查" />
                        <TextBlock Style="{StaticResource AboutSectionDescriptionStyle}" Text="快捷键按当前页面生效；输入框内可直接撤销、恢复、复制和粘贴文字。" />
                    </ui:StackPanel>
                    <WrapPanel>
                        <Border Width="{Binding AboutCardWidth}" Style="{StaticResource AboutCardStyle}">
                            <ui:StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource AboutCardTitleStyle}" Text="页面与窗口" />
                                <UniformGrid Columns="2">
                                    <Border Style="{StaticResource AboutShortcutItemStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource AboutShortcutKeyPillStyle}"><TextBlock Style="{StaticResource AboutShortcutKeyTextStyle}" Text="Tab" /></Border>
                                            <TextBlock Grid.Column="1" Style="{StaticResource AboutShortcutDescriptionTextStyle}" Text="向上切换页面" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource AboutShortcutItemStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource AboutShortcutKeyPillStyle}"><TextBlock Style="{StaticResource AboutShortcutKeyTextStyle}" Text="CapsLock" /></Border>
                                            <TextBlock Grid.Column="1" Style="{StaticResource AboutShortcutDescriptionTextStyle}" Text="向下切换页面" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource AboutShortcutItemStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource AboutShortcutKeyPillStyle}"><TextBlock Style="{StaticResource AboutShortcutKeyTextStyle}" Text="Alt+1~4" /></Border>
                                            <TextBlock Grid.Column="1" Style="{StaticResource AboutShortcutDescriptionTextStyle}" Text="直达页面" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource AboutShortcutItemStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource AboutShortcutKeyPillStyle}"><TextBlock Style="{StaticResource AboutShortcutKeyTextStyle}" Text="Ctrl+W" /></Border>
                                            <TextBlock Grid.Column="1" Style="{StaticResource AboutShortcutDescriptionTextStyle}" Text="关闭窗口" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource AboutShortcutItemStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource AboutShortcutKeyPillStyle}"><TextBlock Style="{StaticResource AboutShortcutKeyTextStyle}" Text="Ctrl+Shift+W" /></Border>
                                            <TextBlock Grid.Column="1" Style="{StaticResource AboutShortcutDescriptionTextStyle}" Text="退出软件" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource AboutShortcutItemStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource AboutShortcutKeyPillStyle}"><TextBlock Style="{StaticResource AboutShortcutKeyTextStyle}" Text="Ctrl+Z" /></Border>
                                            <TextBlock Grid.Column="1" Style="{StaticResource AboutShortcutDescriptionTextStyle}" Text="输入框撤销文字" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource AboutShortcutItemStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource AboutShortcutKeyPillStyle}"><TextBlock Style="{StaticResource AboutShortcutKeyTextStyle}" Text="Ctrl+Y" /></Border>
                                            <TextBlock Grid.Column="1" Style="{StaticResource AboutShortcutDescriptionTextStyle}" Text="输入框恢复文字" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource AboutShortcutItemStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource AboutShortcutKeyPillStyle}"><TextBlock Style="{StaticResource AboutShortcutKeyTextStyle}" Text="Ctrl+C" /></Border>
                                            <TextBlock Grid.Column="1" Style="{StaticResource AboutShortcutDescriptionTextStyle}" Text="输入框复制文字" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource AboutShortcutItemStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource AboutShortcutKeyPillStyle}"><TextBlock Style="{StaticResource AboutShortcutKeyTextStyle}" Text="Ctrl+V" /></Border>
                                            <TextBlock Grid.Column="1" Style="{StaticResource AboutShortcutDescriptionTextStyle}" Text="输入框粘贴文字" />
                                        </Grid>
                                    </Border>
                                </UniformGrid>
                            </ui:StackPanel>
                        </Border>
                        <Border Width="{Binding AboutCardWidth}" Style="{StaticResource AboutCardStyle}">
                            <ui:StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource AboutCardTitleStyle}" Text="首页直播间" />
                                <UniformGrid Columns="2">
                                    <Border Style="{StaticResource AboutShortcutItemStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource AboutShortcutKeyPillStyle}"><TextBlock Style="{StaticResource AboutShortcutKeyTextStyle}" Text="↑/↓/←/→" /></Border>
                                            <TextBlock Grid.Column="1" Style="{StaticResource AboutShortcutDescriptionTextStyle}" Text="微调" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource AboutShortcutItemStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource AboutShortcutKeyPillStyle}"><TextBlock Style="{StaticResource AboutShortcutKeyTextStyle}" Text="W/A/S/D" /></Border>
                                            <TextBlock Grid.Column="1" Style="{StaticResource AboutShortcutDescriptionTextStyle}" Text="微调" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource AboutShortcutItemStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource AboutShortcutKeyPillStyle}"><TextBlock Style="{StaticResource AboutShortcutKeyTextStyle}" Text="Q" /></Border>
                                            <TextBlock Grid.Column="1" Style="{StaticResource AboutShortcutDescriptionTextStyle}" Text="预览" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource AboutShortcutItemStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource AboutShortcutKeyPillStyle}"><TextBlock Style="{StaticResource AboutShortcutKeyTextStyle}" Text="E" /></Border>
                                            <TextBlock Grid.Column="1" Style="{StaticResource AboutShortcutDescriptionTextStyle}" Text="进入直播间" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource AboutShortcutItemStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource AboutShortcutKeyPillStyle}"><TextBlock Style="{StaticResource AboutShortcutKeyTextStyle}" Text="M" /></Border>
                                            <TextBlock Grid.Column="1" Style="{StaticResource AboutShortcutDescriptionTextStyle}" Text="当前监控" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource AboutShortcutItemStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource AboutShortcutKeyPillStyle}"><TextBlock Style="{StaticResource AboutShortcutKeyTextStyle}" Text="R" /></Border>
                                            <TextBlock Grid.Column="1" Style="{StaticResource AboutShortcutDescriptionTextStyle}" Text="当前录制" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource AboutShortcutItemStyle}">
                                        <Grid>
