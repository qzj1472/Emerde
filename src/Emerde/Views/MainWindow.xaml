<ui:FluentWindow x:Class="Emerde.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:b="http://schemas.github.com/computedbehaviors/2024/xaml"
                 xmlns:c="http://schemas.github.com/computedconverters/2024/xaml"
                  xmlns:controls="clr-namespace:Emerde.Controls"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:fluent="clr-namespace:FluentWpfCore.AttachedProperties;assembly=FluentWpfCore"
                 xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                 xmlns:local="clr-namespace:Emerde"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:viewModels="clr-namespace:Emerde.ViewModels"
                 xmlns:views="clr-namespace:Emerde.Views"
                 xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
                 Title="Emerde"
                  d:Background="#FF101010"
                  Background="Transparent"
                 ExtendsContentIntoTitleBar="True"
                 BorderBrush="Transparent"
                 BorderThickness="0"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="Manual"
                 AllowDrop="True"
                 PreviewDragOver="MainWindowPreviewDragOver"
                 PreviewDrop="MainWindowPreviewDrop"
                 SnapsToDevicePixels="True"
                  UseLayoutRounding="True"
                  fluent:DwmAnimation.EnableDwmAnimation="True"
                  fluent:WindowMaterial.WindowCorner="Round"
                  mc:Ignorable="d">
    <fluent:WindowMaterial.Material>
        <fluent:WindowMaterial x:Name="UiXWindowMaterial"
                               CompositonColor="#D9F3F5F7"
                               IsDarkMode="False"
                               MaterialMode="None"
                               UseWindowComposition="False" />
    </fluent:WindowMaterial.Material>
    <Grid x:Name="ShellRoot">
        <Grid.Style>
            <Style TargetType="{x:Type Grid}">
                <Setter Property="Background" Value="{DynamicResource EmerdeShellBackgroundBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding StatusOfIsUiXEnabled}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource UiXShellBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.Resources>
            <c:ValueConverterGroup x:Key="NotZeroIntToToVisibilityConverter">
                <c:IntToBoolConverter TrueValue="0" />
                <c:BoolToVisibilityConverter />
            </c:ValueConverterGroup>

            <LinearGradientBrush x:Key="TopEdgeFadeOpacityMask" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#FFFFFFFF" />
                <GradientStop Offset="1" Color="#00FFFFFF" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="BottomEdgeFadeOpacityMask" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#00FFFFFF" />
                <GradientStop Offset="1" Color="#FFFFFFFF" />
            </LinearGradientBrush>

            <Style x:Key="UiXMainFadeStyle" TargetType="{x:Type Border}">
                <Setter Property="Background" Value="{DynamicResource EmerdePanelBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding StatusOfIsUiXEnabled}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource UiXPanelBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="UiXRoomCardFadeStyle" TargetType="{x:Type Border}">
                <Setter Property="Background" Value="{DynamicResource EmerdePanelBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding DataContext.StatusOfIsUiXEnabled, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource UiXPanelBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <SolidColorBrush x:Key="RecordActiveBackgroundBrush" Color="#1FD95C66" />
            <SolidColorBrush x:Key="RecordActiveBorderBrush" Color="#80D95C66" />
            <SolidColorBrush x:Key="RecordActiveForegroundBrush" Color="#B33D4C" />
            <SolidColorBrush x:Key="LiveActiveBackgroundBrush" Color="#2A46B86E" />
            <SolidColorBrush x:Key="LiveActiveBorderBrush" Color="#A046B86E" />
            <SolidColorBrush x:Key="LiveActiveForegroundBrush" Color="#237A49" />
            <SolidColorBrush x:Key="MonitorActiveBackgroundBrush" Color="#264C8FD8" />
            <SolidColorBrush x:Key="MonitorActiveBorderBrush" Color="#A04C8FD8" />
            <SolidColorBrush x:Key="MonitorActiveForegroundBrush" Color="#2B6EBE" />

            <Style x:Key="StatusTrayButtonStyle" TargetType="{x:Type Button}">
                <Setter Property="controls:MotionAssist.IsPressEnabled" Value="True" />
                <Setter Property="controls:MotionAssist.HoverScale" Value="1.01" />
                <Setter Property="Width" Value="22" />
                <Setter Property="Height" Value="28" />
                <Setter Property="MinWidth" Value="22" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSolidNeutralBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="ButtonChrome"
                                    Width="{TemplateBinding Width}"
                                    Height="{TemplateBinding Height}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{StaticResource Win11ControlCornerRadius}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="StatusTrayTextBlockStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            </Style>

            <Style x:Key="StatusTrayIconStyle" TargetType="{x:Type ui:FontIcon}">
                <Setter Property="Width" Value="16" />
                <Setter Property="Height" Value="16" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            </Style>

            <Style x:Key="StatusTrayChipButtonStyle" TargetType="{x:Type Button}">
                <Setter Property="controls:MotionAssist.IsPressEnabled" Value="True" />
                <Setter Property="controls:MotionAssist.HoverScale" Value="1.008" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="6,0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="ButtonChrome"
                                    Height="{TemplateBinding Height}"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{StaticResource Win11ControlCornerRadius}">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="StatusTrayCapacityButtonStyle" TargetType="{x:Type Button}">
                <Setter Property="controls:MotionAssist.IsPressEnabled" Value="True" />
                <Setter Property="controls:MotionAssist.HoverScale" Value="1.008" />
                <Setter Property="MinWidth" Value="68" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Padding" Value="4,0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="ButtonChrome"
                                    MinWidth="{TemplateBinding MinWidth}"
                                    Height="{TemplateBinding Height}"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{StaticResource Win11ControlCornerRadius}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="StatusTrayCapacityRefreshButtonStyle" TargetType="{x:Type Button}">
                <Setter Property="controls:MotionAssist.IsPressEnabled" Value="True" />
                <Setter Property="controls:MotionAssist.HoverScale" Value="1.01" />
                <Setter Property="Width" Value="22" />
                <Setter Property="Height" Value="24" />
                <Setter Property="MinWidth" Value="22" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="ButtonChrome"
                                    Width="{TemplateBinding Width}"
                                    Height="{TemplateBinding Height}"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{StaticResource Win11ControlCornerRadius}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ShellNavButtonStyle" TargetType="{x:Type ToggleButton}">
                <Setter Property="controls:MotionAssist.IsPressEnabled" Value="True" />
                <Setter Property="controls:MotionAssist.HoverScale" Value="1.01" />
                <Setter Property="Width" Value="64" />
                <Setter Property="Height" Value="58" />
                <Setter Property="Margin" Value="4,0,4,4" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                            <Grid>
                                <Border x:Name="Chrome"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="{StaticResource Win11ControlCornerRadius}" />
                                <Border x:Name="Indicator"
                                        Width="3"
                                        Height="28"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                                        CornerRadius="2"
                                        Opacity="0"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleY="0.72" />
                                    </Border.RenderTransform>
                                </Border>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding StatusOfIsUiXEnabled, RelativeSource={RelativeSource AncestorType={x:Type views:MainWindow}}}" Value="True">
                                    <Setter TargetName="Chrome" Property="CornerRadius" Value="{StaticResource UiXNavigationItemCornerRadius}" />
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                </Trigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding StatusOfIsUiXEnabled, RelativeSource={RelativeSource AncestorType={x:Type views:MainWindow}}}" Value="True" />
                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                        <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource UiXSubtleFillBrush}" />
                                </MultiDataTrigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                    <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Indicator"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 From="0"
                                                                 To="1"
                                                                 Duration="0:0:0.18" />
                                                <DoubleAnimation Storyboard.TargetName="Indicator"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 To="1"
                                                                 Duration="0:0:0.22">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Indicator"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0"
                                                                 Duration="0:0:0.14" />
                                                <DoubleAnimation Storyboard.TargetName="Indicator"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 To="0.72"
                                                                 Duration="0:0:0.16" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding StatusOfIsUiXEnabled, RelativeSource={RelativeSource AncestorType={x:Type views:MainWindow}}}" Value="True" />
                                        <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource UiXSelectionFillBrush}" />
                                    <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource UiXSelectionStrokeBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource UiXTextPrimaryBrush}" />
                                </MultiDataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding StatusOfIsUiXEnabled}" Value="True">
                        <Setter Property="Width" Value="40" />
                        <Setter Property="Height" Value="40" />
                        <Setter Property="MinWidth" Value="40" />
                        <Setter Property="MaxWidth" Value="40" />
                        <Setter Property="MinHeight" Value="40" />
                        <Setter Property="MaxHeight" Value="40" />
                        <Setter Property="Margin" Value="3,0,3,6" />
                        <Setter Property="Background" Value="Transparent" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="UiXShellNavLabelStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="11" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding StatusOfIsUiXEnabled}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ShellExitButtonStyle"
                   TargetType="{x:Type Button}"
                   BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Width" Value="64" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="6,0" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Background" Value="#52FF78AE" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Border x:Name="ThemeFill"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        CornerRadius="{StaticResource Win11ControlCornerRadius}" />
                                <Border x:Name="ButtonSurface"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="{StaticResource Win11ControlCornerRadius}"
                                        IsHitTestVisible="False" />
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding StatusOfIsUiXEnabled, RelativeSource={RelativeSource AncestorType={x:Type views:MainWindow}}}" Value="True">
                                    <Setter TargetName="ThemeFill" Property="Width" Value="40" />
                                    <Setter TargetName="ThemeFill" Property="Height" Value="40" />
                                    <Setter TargetName="ThemeFill" Property="HorizontalAlignment" Value="Center" />
                                    <Setter TargetName="ThemeFill" Property="VerticalAlignment" Value="Center" />
                                    <Setter TargetName="ThemeFill" Property="CornerRadius" Value="{StaticResource UiXNavigationInsetCornerRadius}" />
                                    <Setter TargetName="ButtonSurface" Property="Width" Value="40" />
                                    <Setter TargetName="ButtonSurface" Property="Height" Value="40" />
                                    <Setter TargetName="ButtonSurface" Property="HorizontalAlignment" Value="Center" />
                                    <Setter TargetName="ButtonSurface" Property="VerticalAlignment" Value="Center" />
                                    <Setter TargetName="ButtonSurface" Property="CornerRadius" Value="{StaticResource UiXNavigationInsetCornerRadius}" />
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ThemeFill" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                </Trigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding StatusOfIsUiXEnabled, RelativeSource={RelativeSource AncestorType={x:Type views:MainWindow}}}" Value="True" />
                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="ThemeFill" Property="Background" Value="{DynamicResource UiXSubtleFillBrush}" />
                                </MultiDataTrigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ThemeFill" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.55" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding StatusOfIsUiXEnabled}" Value="True">
                        <Setter Property="Width" Value="40" />
                        <Setter Property="Height" Value="40" />
                        <Setter Property="MinWidth" Value="40" />
                        <Setter Property="MaxWidth" Value="40" />
                        <Setter Property="MinHeight" Value="40" />
                        <Setter Property="MaxHeight" Value="40" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Background" Value="{DynamicResource UiXDangerFillBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource UiXDangerForegroundBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SelectedContextMenuOptionStyle"
                   TargetType="{x:Type MenuItem}"
                   BasedOn="{StaticResource {x:Type MenuItem}}">
                <Setter Property="controls:MotionAssist.IsPressEnabled" Value="True" />
                <Setter Property="controls:MotionAssist.HoverScale" Value="1.006" />
                <Setter Property="controls:MotionAssist.PressScale" Value="0.992" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="ToolTipService.InitialShowDelay" Value="420" />
                <Setter Property="ToolTipService.ShowDuration" Value="3000" />
                <Setter Property="ToolTipService.Placement" Value="Mouse" />
                <Style.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="MonitorContextMenuActionStyle"
                   TargetType="{x:Type MenuItem}"
                   BasedOn="{StaticResource SelectedContextMenuOptionStyle}">
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" />
                            <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Foreground" Value="{StaticResource MonitorActiveForegroundBrush}" />
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="RecordContextMenuActionStyle"
                   TargetType="{x:Type MenuItem}"
                   BasedOn="{StaticResource SelectedContextMenuOptionStyle}">
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" />
                            <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Foreground" Value="{StaticResource RecordActiveForegroundBrush}" />
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="DetailLabelStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="DetailValueStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <ControlTemplate x:Key="StableActiveActionButtonTemplate" TargetType="{x:Type Button}">
                <Border x:Name="ButtonChrome"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{StaticResource Win11ControlCornerRadius}"
                        SnapsToDevicePixels="True">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Content="{TemplateBinding Content}"
                                      ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      RecognizesAccessKey="True" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.82" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <Style x:Key="MonitorActionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" />
                            <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="{StaticResource MonitorActiveBackgroundBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource MonitorActiveBorderBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Foreground" Value="{StaticResource MonitorActiveForegroundBrush}" />
                        <Setter Property="Template" Value="{StaticResource StableActiveActionButtonTemplate}" />
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="RecordActionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" />
                            <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="{StaticResource RecordActiveBackgroundBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource RecordActiveBorderBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Foreground" Value="{StaticResource RecordActiveForegroundBrush}" />
                        <Setter Property="Template" Value="{StaticResource StableActiveActionButtonTemplate}" />
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="MonitorStatusTrayButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource StatusTrayButtonStyle}">
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" />
                            <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Foreground" Value="{StaticResource MonitorActiveForegroundBrush}" />
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="RecordStatusTrayButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource StatusTrayButtonStyle}">
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" />
                            <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Foreground" Value="{StaticResource RecordActiveForegroundBrush}" />
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="RoomCardChipStyle" TargetType="{x:Type Border}">
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="CornerRadius" Value="{StaticResource Win11ControlCornerRadius}" />
                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="LiveRoomCardChipStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource RoomCardChipStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                        <Setter Property="Background" Value="{StaticResource LiveActiveBackgroundBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource LiveActiveBorderBrush}" />
                        <Setter Property="TextElement.Foreground" Value="{StaticResource LiveActiveForegroundBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="RecordRoomCardChipStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource RoomCardChipStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                        <Setter Property="Background" Value="{StaticResource RecordActiveBackgroundBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource RecordActiveBorderBrush}" />
                        <Setter Property="TextElement.Foreground" Value="{StaticResource RecordActiveForegroundBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="CenteredVerticalScrollViewerStyle" TargetType="{x:Type ScrollViewer}">
                <Setter Property="Padding" Value="6" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollViewer}">
                            <Grid ClipToBounds="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ScrollContentPresenter x:Name="RoomCardScrollContentPresenter"
                                                        Grid.Column="0"
                                                        Margin="{TemplateBinding Padding}"
                                                        CanContentScroll="{TemplateBinding CanContentScroll}"
                                                        Content="{TemplateBinding Content}"
                                                        ContentTemplate="{TemplateBinding ContentTemplate}" />
                                <ScrollBar x:Name="PART_VerticalScrollBar"
                                           Grid.Column="1"
                                           Width="18"
                                           HorizontalAlignment="Center"
                                           Maximum="{TemplateBinding ScrollableHeight}"
                                           Minimum="0"
                                           Orientation="Vertical"
                                           IsVisibleChanged="RoomCardScrollBarVisibilityChanged"
                                           Style="{StaticResource UiScrollBar}"
                                           ViewportSize="{TemplateBinding ViewportHeight}"
                                           Value="{TemplateBinding VerticalOffset}"
                                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger SourceName="PART_VerticalScrollBar" Property="Visibility" Value="Visible">
                                    <Setter TargetName="RoomCardScrollContentPresenter" Property="Margin" Value="6,6,-6,6" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="RoomCardListBoxStyle" TargetType="{x:Type ListBox}">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBox}">
                            <Grid ClipToBounds="True">
                                <ScrollViewer x:Name="RoomCardScrollViewer"
                                              Focusable="False"
                                              FocusVisualStyle="{x:Null}"
                                              BorderThickness="0"
                                              Padding="6"
                                              HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                              VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                              Style="{StaticResource CenteredVerticalScrollViewerStyle}">
                                    <ItemsPresenter />
                                </ScrollViewer>
                                <Border x:Name="RoomCardTopFade"
                                        Height="6"
                                        Margin="6,6,6,0"
                                        VerticalAlignment="Top"
                                        Panel.ZIndex="20"
                                        Style="{StaticResource UiXRoomCardFadeStyle}"
                                        IsHitTestVisible="False"
                                        OpacityMask="{StaticResource TopEdgeFadeOpacityMask}" />
                                <Border x:Name="RoomCardBottomFade"
                                        Height="6"
                                        Margin="6,0,6,6"
                                        VerticalAlignment="Bottom"
                                        Panel.ZIndex="20"
                                        Style="{StaticResource UiXRoomCardFadeStyle}"
                                        IsHitTestVisible="False"
                                        OpacityMask="{StaticResource BottomEdgeFadeOpacityMask}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding ComputedVerticalScrollBarVisibility, ElementName=RoomCardScrollViewer}" Value="Visible">
                                    <Setter TargetName="RoomCardTopFade" Property="Margin" Value="6,6,18,0" />
                                    <Setter TargetName="RoomCardBottomFade" Property="Margin" Value="6,0,18,6" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <ui:Grid x:Name="MainContentRoot"
                 controls:MotionAssist.IsEntranceEnabled="True"
                 controls:MotionAssist.EntranceOffsetY="8">
            <ui:Grid.Style>
                <Style TargetType="{x:Type ui:Grid}">
                    <Setter Property="Margin" Value="10,42,10,10" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusOfIsUiXEnabled}" Value="True">
                            <Setter Property="Margin" Value="8,42,8,8" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ui:Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition>
                    <ColumnDefinition.Style>
                        <Style TargetType="{x:Type ColumnDefinition}">
                            <Setter Property="Width" Value="74" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusOfIsUiXEnabled}" Value="True">
                                    <Setter Property="Width" Value="50" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
                <ColumnDefinition>
                    <ColumnDefinition.Style>
                        <Style TargetType="{x:Type ColumnDefinition}">
                            <Setter Property="Width" Value="12" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusOfIsUiXEnabled}" Value="True">
                                    <Setter Property="Width" Value="8" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="ShellNavigationPanel"
                    Grid.Column="0"
                    ClipToBounds="True"
                    controls:MotionAssist.IsEntranceEnabled="True"
                    controls:MotionAssist.EntranceOffsetY="6">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Background" Value="{DynamicResource EmerdeSurfaceBrush}" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="CornerRadius" Value="{StaticResource Win11ControlCornerRadius}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusOfIsUiXEnabled}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource UiXNavigationBrush}" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="CornerRadius" Value="{StaticResource UiXShellSurfaceCornerRadius}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Margin="2,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:StackPanel x:Name="ShellNavigationItems"
                                   Grid.Row="0"
                                   HorizontalAlignment="Center"
                                   Orientation="Vertical">
                    <ToggleButton Command="{Binding ShowHomePageCommand}"
                                  IsChecked="{Binding IsHomePageSelected, Mode=OneWay}"
                                  Style="{StaticResource ShellNavButtonStyle}"
                                  ToolTip="{I18N NavigationHomeToolTip}">
                        <ui:StackPanel HorizontalAlignment="Center" Spacing="4">
                            <ui:FontIcon HorizontalAlignment="Center"
                                         FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                         FontSize="20"
                                         Glyph="{x:Static ui:FontSymbols.Home}" />
                        <TextBlock Style="{StaticResource UiXShellNavLabelStyle}" Text="{I18N HomePage}" />
                        </ui:StackPanel>
                    </ToggleButton>
                    <ToggleButton Command="{Binding OpenScreenRecordListCommand}"
                                  IsChecked="{Binding IsVideoListPageSelected, Mode=OneWay}"
                                  Style="{StaticResource ShellNavButtonStyle}"
                                  ToolTip="{I18N NavigationVideosToolTip}">
                        <ui:StackPanel HorizontalAlignment="Center" Spacing="4">
                            <ui:FontIcon HorizontalAlignment="Center"
                                         FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                         FontSize="20"
                                         Glyph="{x:Static ui:FontSymbols.Video}" />
                            <TextBlock Style="{StaticResource UiXShellNavLabelStyle}" Text="{I18N VideoListTitle}" />
                        </ui:StackPanel>
                    </ToggleButton>
                    <ToggleButton Command="{Binding OpenExtensionsCommand}"
                                  IsChecked="{Binding IsExtensionsPageSelected, Mode=OneWay}"
                                  Style="{StaticResource ShellNavButtonStyle}"
                                  ToolTip="{I18N NavigationExtensionsToolTip}">
                        <ui:StackPanel HorizontalAlignment="Center" Spacing="4">
                            <ui:FontIcon HorizontalAlignment="Center"
                                         FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                         FontSize="20"
                                         Glyph="{x:Static ui:FontSymbols.AppIconDefault}" />
                            <TextBlock Style="{StaticResource UiXShellNavLabelStyle}" Text="{I18N Extensions}" />
                        </ui:StackPanel>
                    </ToggleButton>
                    <ToggleButton Command="{Binding OpenSettingsDialogCommand}"
                                  IsChecked="{Binding IsSettingsPageSelected, Mode=OneWay}"
                                  Style="{StaticResource ShellNavButtonStyle}"
                                  ToolTip="{I18N NavigationSettingsToolTip}">
                        <ui:StackPanel HorizontalAlignment="Center" Spacing="4">
                            <ui:FontIcon HorizontalAlignment="Center"
                                         FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                         FontSize="20"
                                         Glyph="{x:Static ui:FontSymbols.Settings}" />
                            <TextBlock Style="{StaticResource UiXShellNavLabelStyle}" Text="{I18N Settings}" />
                        </ui:StackPanel>
                    </ToggleButton>
                    <ToggleButton Command="{Binding OpenAboutCommand}"
                                  IsChecked="{Binding IsAboutPageSelected, Mode=OneWay}"
                                  Style="{StaticResource ShellNavButtonStyle}"
                                  ToolTip="{I18N NavigationAboutToolTip}">
                        <ui:StackPanel HorizontalAlignment="Center" Spacing="4">
                            <ui:FontIcon HorizontalAlignment="Center"
                                         FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                         FontSize="20"
                                         Glyph="{x:Static ui:FontSymbols.Info}" />
                            <TextBlock Style="{StaticResource UiXShellNavLabelStyle}" Text="{I18N About}" />
                        </ui:StackPanel>
                    </ToggleButton>
                    <StackPanel x:Name="ExtensionNavigationHost" />
                    </ui:StackPanel>
                    <Button Grid.Row="2"
                            Command="{Binding ExitApplicationCommand}"
                            Style="{StaticResource ShellExitButtonStyle}"
                            ToolTip="{I18N ExitApplicationToolTip}">
                        <ui:StackPanel Orientation="Horizontal" Spacing="5">
                            <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                         Glyph="{x:Static ui:FontSymbols.PowerButton}">
                                <ui:FontIcon.Style>
                                    <Style TargetType="{x:Type ui:FontIcon}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusOfIsUiXEnabled}" Value="True">
                                                <Setter Property="FontSize" Value="20" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:FontIcon.Style>
                            </ui:FontIcon>
                            <TextBlock Text="{I18N TrayMenuExit}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusOfIsUiXEnabled}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </ui:StackPanel>
                    </Button>
                </Grid>
            </Border>
            <Border x:Name="ShellContentSurface"
                    Grid.Column="2"
                    Padding="10,10,10,6">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Background" Value="{DynamicResource EmerdeSurfaceBrush}" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="CornerRadius" Value="{StaticResource Win11ControlCornerRadius}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusOfIsUiXEnabled}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource UiXPanelBrush}" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="CornerRadius" Value="{StaticResource UiXShellSurfaceCornerRadius}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            <Grid x:Name="ShellPageHost">
                <ui:Grid x:Name="HomePageRoot"
                         RowDefinitions="Auto,*,Auto"
                         controls:MotionAssist.IsEntranceEnabled="True"
                         controls:MotionAssist.EntranceOffsetY="8"
                         controls:MotionAssist.EntranceTrigger="{Binding IsHomePageSelected}">
                    <ui:Grid.Style>
                        <Style TargetType="{x:Type ui:Grid}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHomePageSelected}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Grid.Style>
            <ui:Grid x:Name="HomePageHeading"
                     Grid.Row="0"
                     Height="48"
                     Margin="{StaticResource UiXPageHeaderMargin}">
                <ui:Grid.Style>
                    <Style TargetType="{x:Type ui:Grid}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusOfIsUiXEnabled}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:Grid.Style>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource UiXPageTitleTextStyle}"
                               Text="{I18N HomePage}" />
                     <TextBlock Margin="0,2,0,0"
                                Style="{StaticResource UiXPageSubtitleTextStyle}"
                                Text="{Binding PlatformSummaryText}"
                                Visibility="Collapsed" />
                </StackPanel>
            </ui:Grid>

            <ui:Grid x:Name="HomeActionBar"
                     Grid.Row="0"
                     Height="48"
                     ColumnDefinitions="Auto,*,Auto">
                <ui:Grid.Style>
                    <Style TargetType="{x:Type ui:Grid}">
                        <Setter Property="Margin" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusOfIsUiXEnabled}" Value="True">
                                <Setter Property="Margin" Value="{StaticResource UiXPageHeaderMargin}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:Grid.Style>
                <ui:StackPanel VerticalAlignment="Center"
                               Orientation="Horizontal"
                               Spacing="8">
                    <ui:StackPanel.Style>
                        <Style TargetType="{x:Type ui:StackPanel}">
                            <Setter Property="Grid.Column" Value="0" />
                            <Setter Property="HorizontalAlignment" Value="Left" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusOfIsUiXEnabled}" Value="True">
                                    <Setter Property="Grid.Column" Value="2" />
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:StackPanel.Style>
                    <ui:StackPanel x:Name="HomeExtensionToolbarHost"
                                   Orientation="Horizontal"
                                   Spacing="8" />
                    <Button MinWidth="72"
                            Command="{Binding AddRoomCommand}"
                            ToolTip="{I18N AddRoomToolTip}">
                        <Button.Content>
                            <ui:StackPanel Orientation="Horizontal" Spacing="8">
                                <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" Glyph="{x:Static ui:FontSymbols.Add}" />
                                <TextBlock Text="{I18N ButtonOfAdd}" />
                            </ui:StackPanel>
                        </Button.Content>
                    </Button>
                    <Button MinWidth="72"
                            Command="{Binding ToggleMonitorCommand}"
                            Style="{StaticResource MonitorActionButtonStyle}"
                            Tag="{Binding StatusOfIsMonitorRunning}"
                            ToolTip="{I18N ToggleAllMonitorToolTip}">
                        <Button.Content>
                            <ui:StackPanel Orientation="Horizontal" Spacing="8">
                                <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                             Glyph="{x:Static ui:FontSymbols.Radar}" />
                                <TextBlock Text="{I18N Monitor}" />
                            </ui:StackPanel>
                        </Button.Content>
                    </Button>
                    <Button MinWidth="72"
                            Command="{Binding ToggleStatusRecordCommand}"
                            Style="{StaticResource RecordActionButtonStyle}"
                            Tag="{Binding StatusOfIsToRecord}"
                            ToolTip="{I18N ToggleAllRecordingToolTip}">
                        <Button.Content>
                            <ui:StackPanel Orientation="Horizontal" Spacing="8">
                                <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                             Glyph="{x:Static ui:FontSymbols.Record}" />
                                <TextBlock Text="{I18N EnableRecord}" />
                            </ui:StackPanel>
                        </Button.Content>
                    </Button>
                </ui:StackPanel>
            </ui:Grid>

            <Grid x:Name="HomePreviewLayoutRoot"
                  Grid.Row="1"
                  SizeChanged="HomePreviewLayoutRootSizeChanged">
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Margin" Value="0,8,0,0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusOfIsUiXEnabled}" Value="True">
                                <Setter Property="Margin" Value="10,8,10,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="HomeRoomCardColumn" Width="7*" />
                    <ColumnDefinition x:Name="HomePreviewColumn" Width="0" />
                    <ColumnDefinition x:Name="HomeDetailColumn" Width="0" MaxWidth="0" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        x:Name="RoomCardPanel"
                        Padding="0"
                        ClipToBounds="True"
                        Focusable="False"
                        FocusVisualStyle="{x:Null}"
                        KeyboardNavigation.DirectionalNavigation="None"
                        KeyboardNavigation.TabNavigation="None"
                        MouseLeftButtonDown="RoomCardPanelMouseLeftButtonDown"
                        PreviewMouseLeftButtonDown="RoomCardListPreviewMouseLeftButtonDown"
                        PreviewMouseLeftButtonUp="RoomCardListPreviewMouseLeftButtonUp"
                        PreviewMouseMove="RoomCardListPreviewMouseMove"
                        PreviewMouseWheel="RoomCardListPreviewMouseWheel"
                        PreviewMouseRightButtonDown="RoomCardListPreviewMouseRightButtonDown">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Background" Value="{DynamicResource EmerdePanelBrush}" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="CornerRadius" Value="{StaticResource Win11ControlCornerRadius}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusOfIsUiXEnabled}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource UiXPanelBrush}" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="CornerRadius" Value="{StaticResource UiXPageSurfaceCornerRadius}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.ContextMenu>
                        <ContextMenu Placement="MousePoint"
                                     StaysOpen="False"
                                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="{I18N RefreshButton}"
                                      Command="{Binding RefreshRoomCardsCommand}" />
                            <MenuItem Header="{I18N CardSize}">
                                <MenuItem Header="{I18N SizeLarge}" Click="SetRoomCardLargeClick" />
                                <MenuItem Header="{I18N SizeMedium}" Click="SetRoomCardMediumClick" />
                                <MenuItem Header="{I18N SizeSmall}" Click="SetRoomCardSmallClick" />
                            </MenuItem>
                            <MenuItem Header="{I18N Sort}"
                                      SubmenuOpened="RoomSortMenuSubmenuOpened">
                                <MenuItem Header="{I18N SortByName}"
                                          IsCheckable="True"
                                          Click="SortRoomsByNameMenuItemClick"
                                          Style="{StaticResource SelectedContextMenuOptionStyle}" />
                                <MenuItem Header="{I18N SortByAddedOrder}"
                                          IsCheckable="True"
                                          Click="SortRoomsByAddedAtMenuItemClick"
                                          Style="{StaticResource SelectedContextMenuOptionStyle}" />
                            </MenuItem>
                            <MenuItem Header="{I18N PlatformFilter}"
                                      SubmenuOpened="PlatformFilterMenuSubmenuOpened">
                                <MenuItem Header="{I18N LoadPlatforms}" IsEnabled="False" />
                                <MenuItem.Style>
                                    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource {x:Type MenuItem}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlatformFilterActive}" Value="True">
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </MenuItem.Style>
                            </MenuItem>
                        </ContextMenu>
                    </Border.ContextMenu>
                    <Grid x:Name="RoomCardPanelContent"
                          ClipToBounds="True"
                          Focusable="False"
                          FocusVisualStyle="{x:Null}"
                          KeyboardNavigation.DirectionalNavigation="None"
                          KeyboardNavigation.TabNavigation="None"
                          SizeChanged="RoomCardPanelContentSizeChanged">
                        <ListBox x:Name="RoomCardList"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  ClipToBounds="True"
                                  FocusVisualStyle="{x:Null}"
                                  ItemsSource="{Binding RoomStatusesView}"
                                 Loaded="RoomCardListLoaded"
                                 LostMouseCapture="RoomCardListLostMouseCapture"
                                 Padding="0"
                                  ScrollViewer.CanContentScroll="True"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                 SelectionMode="Single"
                                 Style="{StaticResource RoomCardListBoxStyle}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid IsItemsHost="True"
                                                 VerticalAlignment="Top"
                                                 Columns="{Binding RoomCardColumnCount, RelativeSource={RelativeSource AncestorType={x:Type views:MainWindow}}}">
                                        <UniformGrid.Style>
                                            <Style TargetType="{x:Type UniformGrid}">
                                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.StatusOfIsUiXEnabled, RelativeSource={RelativeSource AncestorType={x:Type views:MainWindow}}}" Value="True">
                                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                                        <Setter Property="Width" Value="{Binding RoomCardGridWidth, RelativeSource={RelativeSource AncestorType={x:Type views:MainWindow}}}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </UniformGrid.Style>
                                    </UniformGrid>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="{x:Type ListBoxItem}">
                                    <Setter Property="controls:MotionAssist.IsEntranceEnabled" Value="True" />
                                    <Setter Property="controls:MotionAssist.EntranceOffsetY" Value="7" />
                                    <Setter Property="controls:MotionAssist.EntranceScale" Value="0.99" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
