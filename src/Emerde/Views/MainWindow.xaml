                                Panel.ZIndex="20"
                                Style="{StaticResource UiXMainFadeStyle}"
                                IsHitTestVisible="False"
                                OpacityMask="{StaticResource TopEdgeFadeOpacityMask}" />
                        <Border Height="6"
                                VerticalAlignment="Bottom"
                                Panel.ZIndex="20"
                                Style="{StaticResource UiXMainFadeStyle}"
                                IsHitTestVisible="False"
                                OpacityMask="{StaticResource BottomEdgeFadeOpacityMask}" />
                    </Grid>
                </Border>

                <views:LivePreviewPanel x:Name="HomePreviewPanel"
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        IsEmbeddedMode="True">
                    <views:LivePreviewPanel.Style>
                        <Style TargetType="{x:Type views:LivePreviewPanel}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="IsHitTestVisible" Value="False" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPreviewSurfaceVisible, RelativeSource={RelativeSource AncestorType={x:Type views:MainWindow}}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPreviewing}" Value="True">
                                    <Setter Property="IsHitTestVisible" Value="True" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:LivePreviewPanel.Style>
                </views:LivePreviewPanel>

                <Border x:Name="RoomDetailPanel"
                        Grid.Column="2"
                        Margin="8,0,0,0"
                        Padding="0"
                        Background="{DynamicResource EmerdePanelBrush}"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        CornerRadius="{StaticResource Win11ControlCornerRadius}"
                        ClipToBounds="True"
                        Visibility="Collapsed">
                    <Grid x:Name="RoomDetailPanelContent"
                          ClipToBounds="True"
                          SizeChanged="RoundedPanelContentSizeChanged">
                    <ScrollViewer BorderThickness="0"
                                  Focusable="False"
                                  FocusVisualStyle="{x:Null}"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="8"
                                  VerticalScrollBarVisibility="Visible">
                        <StackPanel Margin="0">
                            <ui:Grid ColumnDefinitions="Auto,*">
                                <vio:PersonPicture Grid.Column="0"
                                                   Width="40"
                                                   Height="40"
                                                   DisplayName="{Binding SelectedItem.NickName}"
                                                   ProfilePicture="{Binding SelectedItem.AvatarDisplaySource}"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   SnapsToDevicePixels="True" />
                                <StackPanel Grid.Column="1"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock FontSize="16"
                                               FontWeight="SemiBold"
                                               Text="{Binding SelectedItem.NickName}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,3,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="{Binding SelectedItem.RoomCodeText, StringFormat=UID: {0}}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </ui:Grid>

                            <Border Height="1"
                                    Margin="0,10,0,10"
                                    Background="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    Opacity="0.65" />

                            <ui:Grid Margin="0,0,0,8" ColumnDefinitions="*,Auto">
                                <TextBlock FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                           Text="{I18N RoomInformation}" />
                                <Button Grid.Column="1"
                                        Width="28"
                                        Height="28"
                                        MinWidth="28"
                                        Padding="0"
                                        Command="{Binding RefreshSelectedRoomInfoCommand}"
                                        ToolTip="{I18N RefreshCurrentRoomToolTip}">
                                    <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                 Glyph="{x:Static ui:FontSymbols.Sync}"
                                                 RenderTransformOrigin="0.5,0.5"
                                                 controls:MotionAssist.IsSpinActive="{Binding IsRefreshingSelectedRoomInfo}" />
                                </Button>
                            </ui:Grid>

                            <ui:Grid ColumnDefinitions="74,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,12,6" Style="{StaticResource DetailLabelStyle}" Text="{I18N Platform}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" Style="{StaticResource DetailValueStyle}" Text="{Binding SelectedItem.PlatformDisplayName}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,12,6" Style="{StaticResource DetailLabelStyle}" Text="{I18N LiveTitle}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" Style="{StaticResource DetailValueStyle}" Text="{Binding SelectedItem.LiveTitleText}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,12,6" Style="{StaticResource DetailLabelStyle}" Text="{I18N StreamStatus}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,6" Style="{StaticResource DetailValueStyle}" Text="{Binding SelectedItem.StreamStatusText}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,12,6" Style="{StaticResource DetailLabelStyle}" Text="{I18N RecordStatus}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,0,0,6" Style="{StaticResource DetailValueStyle}" Text="{Binding SelectedItem.RecordStatusText}" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,12,6" Style="{StaticResource DetailLabelStyle}" Text="{I18N RecordFormat}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,0,0,6" Style="{StaticResource DetailValueStyle}" Text="{Binding StatusOfRecordFormat}" />

                                <Border Grid.Row="5" Grid.ColumnSpan="2" Height="1" Margin="0,4,0,10" Background="{DynamicResource ControlStrokeColorDefaultBrush}" Opacity="0.45" />

                                <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,0,12,6" Style="{StaticResource DetailLabelStyle}" Text="{I18N RecentRecordingStarted}" />
                                <TextBlock Grid.Row="6" Grid.Column="1" Margin="0,0,0,6" Style="{StaticResource DetailValueStyle}" Text="{Binding SelectedRoomLastRecordedAtText}" />

                                <TextBlock Grid.Row="7" Grid.Column="0" Margin="0,0,12,6" Style="{StaticResource DetailLabelStyle}" Text="{I18N RecentRecordingEnded}" />
                                <TextBlock Grid.Row="7" Grid.Column="1" Margin="0,0,0,6" Style="{StaticResource DetailValueStyle}" Text="{Binding SelectedRoomLastEndedAtText}" />

                                <TextBlock Grid.Row="8" Grid.Column="0" Margin="0,0,12,6" Style="{StaticResource DetailLabelStyle}" Text="{I18N RoomRecordingStorageUsage}" />
                                <TextBlock Grid.Row="8" Grid.Column="1" Margin="0,0,0,6" Style="{StaticResource DetailValueStyle}" Text="{Binding SelectedRoomStorageUsageText}" />

                                <Border Grid.Row="9" Grid.ColumnSpan="2" Height="1" Margin="0,4,0,10" Background="{DynamicResource ControlStrokeColorDefaultBrush}" Opacity="0.45" />

                                <TextBlock Grid.Row="10" Grid.Column="0" Margin="0,0,12,6" Style="{StaticResource DetailLabelStyle}" Text="{I18N QualityLabel}" />
                                <TextBlock Grid.Row="10" Grid.Column="1" Margin="0,0,0,6" Style="{StaticResource DetailValueStyle}" Text="{Binding SelectedItem.QualityText}" />

                                <TextBlock Grid.Row="11" Grid.Column="0" Margin="0,0,12,6" Style="{StaticResource DetailLabelStyle}" Text="{I18N ResolutionLabel}" />
                                <TextBlock Grid.Row="11" Grid.Column="1" Margin="0,0,0,6" Style="{StaticResource DetailValueStyle}" Text="{Binding SelectedItem.ResolutionText}" />

                                <TextBlock Grid.Row="12" Grid.Column="0" Margin="0,0,12,6" Style="{StaticResource DetailLabelStyle}" Text="{I18N BitrateLabel}" />
                                <TextBlock Grid.Row="12" Grid.Column="1" Margin="0,0,0,6" Style="{StaticResource DetailValueStyle}" Text="{Binding SelectedItem.BitrateText}" />

                                <TextBlock Grid.Row="13" Grid.Column="0" Margin="0,0,12,6" Style="{StaticResource DetailLabelStyle}" Text="{I18N RoomAddress}" />
                                <ui:Grid Grid.Row="13" Grid.Column="1" Margin="0,0,0,6" ColumnDefinitions="*,Auto">
                                    <TextBlock Style="{StaticResource DetailValueStyle}" Text="{Binding SelectedItem.RoomUrl}" />
                                    <Button Grid.Column="1"
                                            Width="28"
                                            Height="28"
                                            MinWidth="28"
                                            Margin="8,0,0,0"
                                            Padding="0"
                                            Command="{Binding CopySelectedRoomUrlCommand}"
                                            ToolTip="{I18N CopyRoomAddressToolTip}">
                                        <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" Glyph="{x:Static ui:FontSymbols.Copy}" />
                                    </Button>
                                </ui:Grid>

                                <TextBlock Grid.Row="14" Grid.Column="0" Margin="0,0,12,0" Style="{StaticResource DetailLabelStyle}" Text="{I18N LiveStream}" />
                                <ui:Grid Grid.Row="14" Grid.Column="1" ColumnDefinitions="*,Auto">
                                    <TextBlock Style="{StaticResource DetailValueStyle}" Text="{Binding SelectedItem.LiveStreamText}" />
                                    <Button Grid.Column="1"
                                            Width="28"
                                            Height="28"
                                            MinWidth="28"
                                            Margin="8,0,0,0"
                                            Padding="0"
                                            Command="{Binding CopySelectedPreviewUrlCommand}"
                                            ToolTip="{I18N CopyLiveStreamToolTip}">
                                        <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" Glyph="{x:Static ui:FontSymbols.Copy}" />
                                    </Button>
                                </ui:Grid>
                            </ui:Grid>

                            <Border Height="1"
                                    Margin="0,10,0,10"
                                    Background="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    Opacity="0.65" />

                            <TextBlock Margin="0,0,0,8"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                       Text="{I18N Operation}" />
                            <ui:Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
                                <Button Grid.Row="0"
                                        Grid.Column="0"
                                        FontSize="14"
                                        Height="42"
                                        Margin="0,0,4,6"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding PreviewLiveRoomCommand}"
                                        CommandParameter="{Binding SelectedItem}"
                                        IsEnabled="{Binding CanPreviewSelectedRoom}"
                                        ToolTip="{I18N PreviewCurrentRoomToolTip}">
                                    <ui:StackPanel Orientation="Horizontal" Spacing="6">
                                        <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" Glyph="{x:Static ui:FontSymbols.Play}" />
                                        <TextBlock Text="{I18N PreviewLiveRoom}" />
                                    </ui:StackPanel>
                                </Button>
                                <Button Grid.Row="0"
                                        Grid.Column="1"
                                        FontSize="14"
                                        Height="42"
                                        Margin="4,0,0,6"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding GotoRoomUrlCommand}"
                                        ToolTip="{I18N OpenCurrentRoomToolTip}">
                                    <ui:StackPanel Orientation="Horizontal" Spacing="6">
                                        <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" Glyph="{x:Static ui:FontSymbols.OpenInNewWindow}" />
                                        <TextBlock Text="{I18N ButtonOfGoto}" />
                                    </ui:StackPanel>
                                </Button>
                                <Button Grid.Row="1"
                                        Grid.Column="0"
                                        FontSize="14"
                                        Height="42"
                                        Margin="0,0,4,6"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding ToggleSelectedRoomMonitorCommand}"
                                        Style="{StaticResource MonitorActionButtonStyle}"
                                        Tag="{Binding SelectedItem.EffectiveIsToMonitor}"
                                        ToolTip="{I18N ToggleCurrentMonitorToolTip}">
                                    <ui:StackPanel Orientation="Horizontal" Spacing="6">
                                        <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                     Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                     Glyph="{x:Static ui:FontSymbols.Radar}" />
                                        <TextBlock Text="{I18N Monitor}" />
                                    </ui:StackPanel>
                                </Button>
                                <Button Grid.Row="1"
                                        Grid.Column="1"
                                        FontSize="14"
                                        Height="42"
                                        Margin="4,0,0,6"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding ToggleSelectedRoomRecordCommand}"
                                        Style="{StaticResource RecordActionButtonStyle}"
                                        Tag="{Binding SelectedItem.EffectiveIsToRecord}"
                                        ToolTip="{I18N ToggleCurrentRecordingToolTip}">
                                    <ui:StackPanel Orientation="Horizontal" Spacing="6">
                                        <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                     Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                     Glyph="{x:Static ui:FontSymbols.Record}" />
                                        <TextBlock Text="{I18N EnableRecord}" />
                                    </ui:StackPanel>
                                </Button>
                                <Button Grid.Row="2"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        FontSize="14"
                                        Height="42"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding OpenLocalSettingsCommand}"
                                        ToolTip="{I18N OpenCurrentRoomSettingsToolTip}">
                                    <ui:StackPanel Orientation="Horizontal" Spacing="6">
                                        <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" Glyph="{x:Static ui:FontSymbols.Settings}" />
                                        <TextBlock Text="{I18N Settings}" />
                                    </ui:StackPanel>
                                </Button>
                            </ui:Grid>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Height="6"
                            VerticalAlignment="Top"
                            Panel.ZIndex="20"
                            Style="{StaticResource UiXMainFadeStyle}"
                            IsHitTestVisible="False"
                            OpacityMask="{StaticResource TopEdgeFadeOpacityMask}" />
                    <Border Height="6"
                            VerticalAlignment="Bottom"
                            Panel.ZIndex="20"
                            Style="{StaticResource UiXMainFadeStyle}"
                            IsHitTestVisible="False"
                            OpacityMask="{StaticResource BottomEdgeFadeOpacityMask}" />
                    </Grid>
                </Border>
            </Grid>

            <ui:Grid x:Name="HomeStatusTray"
                     Grid.Row="2"
                     Height="28"
                     SnapsToDevicePixels="True"
                     UseLayoutRounding="True"
                     VerticalAlignment="Center"
                     ColumnDefinitions="Auto,*,Auto">
                <ui:Grid.Style>
                    <Style TargetType="{x:Type ui:Grid}">
                        <Setter Property="Margin" Value="2,6,2,0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusOfIsUiXEnabled}" Value="True">
                                <Setter Property="Margin" Value="18,6,18,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:Grid.Style>
                <ui:StackPanel Grid.Column="0"
                               Height="28"
                               VerticalAlignment="Center"
                               Orientation="Horizontal"
                               Spacing="16">
                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding PlatformSummaryText}">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource StatusTrayTextBlockStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusOfIsUiXEnabled}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Command="{Binding TestNetworkCapacityCommand}"
                            Style="{StaticResource StatusTrayCapacityButtonStyle}"
                            ToolTip="{I18N NetworkCapacityHint}">
                        <ui:StackPanel VerticalAlignment="Center"
                                       Orientation="Horizontal"
                                       Spacing="5">
                            <Grid Width="16" Height="16">
                                <ui:FontIcon Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                             Glyph="{x:Static ui:FontSymbols.Globe}">
                                    <ui:FontIcon.Style>
                                        <Style BasedOn="{StaticResource StatusTrayIconStyle}"
                                               TargetType="{x:Type ui:FontIcon}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNetworkCapacityTesting}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:FontIcon.Style>
                                </ui:FontIcon>
                                <ui:FontIcon Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                             Glyph="{x:Static ui:FontSymbols.Sync}"
                                             RenderTransformOrigin="0.5,0.5"
                                             controls:MotionAssist.IsSpinActive="{Binding IsNetworkCapacityTesting}">
                                    <ui:FontIcon.Style>
                                        <Style BasedOn="{StaticResource StatusTrayIconStyle}"
                                               TargetType="{x:Type ui:FontIcon}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNetworkCapacityTesting}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:FontIcon.Style>
                                </ui:FontIcon>
                            </Grid>
                            <TextBlock Text="{Binding NetworkCapacityDisplayText}"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style BasedOn="{StaticResource StatusTrayTextBlockStyle}"
                                           TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNetworkCapacityTesting}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </ui:StackPanel>
                    </Button>
                </ui:StackPanel>
                <ui:StackPanel Grid.Column="2"
                               Height="28"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Opacity="0.9"
                               Orientation="Horizontal"
                               Spacing="2">
                        <Button Command="{Binding ToggleMonitorCommand}"
                                Style="{StaticResource MonitorStatusTrayButtonStyle}"
                                Tag="{Binding StatusOfIsMonitorRunning}"
                                ToolTip="{I18N ToggleAllMonitorToolTip}">
                            <ui:FontIcon Style="{StaticResource StatusTrayIconStyle}"
                                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                         Glyph="{x:Static ui:FontSymbols.Radar}" />
                        </Button>
                        <Button Command="{Binding ToggleStatusNotifyCommand}"
                                Style="{StaticResource StatusTrayButtonStyle}"
                                ToolTip="{I18N LiveNotification}">
                            <c:If Condition="{Binding StatusOfIsToNotify, Mode=OneWay}">
                                <c:If.TrueValue>
                                    <ui:FontIcon Style="{StaticResource StatusTrayIconStyle}"
                                                 Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                 Glyph="{x:Static ui:FontSymbols.Ringer}" />
                                </c:If.TrueValue>
                                <c:If.FalseValue>
                                    <ui:FontIcon Style="{StaticResource StatusTrayIconStyle}"
                                                 Foreground="{DynamicResource SystemFillColorSolidNeutralBrush}"
                                                 Glyph="{x:Static ui:FontSymbols.Ringer}" />
                                </c:If.FalseValue>
                            </c:If>
                        </Button>
                        <Button Command="{Binding ToggleStatusRecordCommand}"
                                Style="{StaticResource RecordStatusTrayButtonStyle}"
                                Tag="{Binding StatusOfIsToRecord}"
                                ToolTip="{I18N ToggleAllRecordingToolTip}">
                            <ui:FontIcon Style="{StaticResource StatusTrayIconStyle}"
                                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                         Glyph="{x:Static ui:FontSymbols.Video}" />
                        </Button>
                        <Button Command="{Binding ToggleStatusProxyCommand}"
                                Style="{StaticResource StatusTrayButtonStyle}"
                                ToolTip="{I18N UseProxy}">
                            <c:If Condition="{Binding StatusOfIsUseProxy, Mode=OneWay}">
                                <c:If.TrueValue>
                                    <ui:FontIcon Style="{StaticResource StatusTrayIconStyle}"
                                                 Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                 Glyph="{x:Static ui:FontSymbols.VPN}" />
                                </c:If.TrueValue>
                                <c:If.FalseValue>
                                    <ui:FontIcon Style="{StaticResource StatusTrayIconStyle}"
                                                 Foreground="{DynamicResource SystemFillColorSolidNeutralBrush}"
                                                 Glyph="{x:Static ui:FontSymbols.VPN}" />
                                </c:If.FalseValue>
                            </c:If>
                        </Button>
                        <Button Command="{Binding ToggleStatusKeepAwakeCommand}"
                                Style="{StaticResource StatusTrayButtonStyle}"
                                ToolTip="{I18N KeepAwake}">
                            <c:If Condition="{Binding StatusOfIsUseKeepAwake, Mode=OneWay}">
                                <c:If.TrueValue>
                                    <ui:FontIcon Style="{StaticResource StatusTrayIconStyle}"
                                                 Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                 Glyph="{x:Static ui:FontSymbols.Recent}" />
                                </c:If.TrueValue>
                                <c:If.FalseValue>
                                    <ui:FontIcon Style="{StaticResource StatusTrayIconStyle}"
                                                 Foreground="{DynamicResource SystemFillColorSolidNeutralBrush}"
                                                 Glyph="{x:Static ui:FontSymbols.Recent}" />
                                </c:If.FalseValue>
                            </c:If>
                        </Button>
                        <Button Command="{Binding ToggleStatusAutoShutdownCommand}"
                                Style="{StaticResource StatusTrayButtonStyle}"
                                ToolTip="{I18N AutoShutdown}">
                            <c:If Condition="{Binding StatusOfIsUseAutoShutdown, Mode=OneWay}">
                                <c:If.TrueValue>
                                    <ui:FontIcon Style="{StaticResource StatusTrayIconStyle}"
                                                 Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                 Glyph="{x:Static ui:FontSymbols.PowerButton}" />
                                </c:If.TrueValue>
                                <c:If.FalseValue>
                                    <ui:FontIcon Style="{StaticResource StatusTrayIconStyle}"
                                                 Foreground="{DynamicResource SystemFillColorSolidNeutralBrush}"
                                                 Glyph="{x:Static ui:FontSymbols.PowerButton}" />
                                </c:If.FalseValue>
                            </c:If>
                        </Button>
                        <TextBlock Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                   Style="{StaticResource StatusTrayTextBlockStyle}"
                                   Text="{Binding StatusOfAutoShutdownCountdown}"
                                   Visibility="{Binding StatusOfIsUseAutoShutdown, Converter={x:Static c:BoolToVisibilityConverter.Instance}}" />
                        <Border Width="1"
                                Height="14"
                                VerticalAlignment="Center"
                                Background="{DynamicResource ControlStrokeColorDefaultBrush}"
                                Opacity="0.55" />
                        <Button Command="{Binding OpenSettingsDialogCommand}"
                                Style="{StaticResource StatusTrayChipButtonStyle}">
                            <TextBlock Style="{StaticResource StatusTrayTextBlockStyle}"
                                       Text="{Binding StatusOfRoutineIntervalWithUnit}" />
                        </Button>
                        <Border Width="1"
                                Height="14"
                                VerticalAlignment="Center"
                                Background="{DynamicResource ControlStrokeColorDefaultBrush}"
                                Opacity="0.55" />
                        <TextBlock Opacity="0.6"
                                   Style="{StaticResource StatusTrayTextBlockStyle}"
                                   Text="{Binding StatusOfRecordFormat}" />
                </ui:StackPanel>
            </ui:Grid>
                </ui:Grid>

                <views:ScreenRecordListWindow x:Name="VideoListPage"
                                              Margin="0,0,-10,0"
                                              controls:MotionAssist.IsEntranceEnabled="True"
                                              controls:MotionAssist.EntranceOffsetY="8"
                                              controls:MotionAssist.EntranceTrigger="{Binding DataContext.IsVideoListPageSelected, ElementName=ShellPageHost}">
                    <views:ScreenRecordListWindow.Style>
                        <Style TargetType="{x:Type views:ScreenRecordListWindow}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsVideoListPageSelected, ElementName=ShellPageHost}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:ScreenRecordListWindow.Style>
                </views:ScreenRecordListWindow>

                <views:SettingsWindow x:Name="SettingsPage"
                                      controls:MotionAssist.IsEntranceEnabled="True"
                                      controls:MotionAssist.EntranceOffsetY="8"
                                      controls:MotionAssist.EntranceTrigger="{Binding DataContext.IsSettingsPageSelected, ElementName=ShellPageHost}">
                    <views:SettingsWindow.Style>
                        <Style TargetType="{x:Type views:SettingsWindow}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsSettingsPageSelected, ElementName=ShellPageHost}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:SettingsWindow.Style>
                </views:SettingsWindow>

                <views:ExtensionCenterWindow x:Name="ExtensionsPage"
                                             controls:MotionAssist.IsEntranceEnabled="True"
                                             controls:MotionAssist.EntranceOffsetY="8"
                                             controls:MotionAssist.EntranceTrigger="{Binding DataContext.IsExtensionsPageSelected, ElementName=ShellPageHost}">
                    <views:ExtensionCenterWindow.Style>
                        <Style TargetType="{x:Type views:ExtensionCenterWindow}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsExtensionsPageSelected, ElementName=ShellPageHost}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:ExtensionCenterWindow.Style>
                </views:ExtensionCenterWindow>

                <views:AboutContentDialog x:Name="AboutPage"
                                          controls:MotionAssist.IsEntranceEnabled="True"
                                          controls:MotionAssist.EntranceOffsetY="8"
                                          controls:MotionAssist.EntranceTrigger="{Binding DataContext.IsAboutPageSelected, ElementName=ShellPageHost}">
                    <views:AboutContentDialog.Style>
                        <Style TargetType="{x:Type views:AboutContentDialog}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsAboutPageSelected, ElementName=ShellPageHost}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:AboutContentDialog.Style>
                </views:AboutContentDialog>
                <Grid x:Name="ExtensionPageHost" Visibility="Collapsed" />
            </Grid>
            </Border>
        </ui:Grid>

        <Grid x:Name="MainDialogOverlay"
              Background="Transparent"
              IsHitTestVisible="False"
              Panel.ZIndex="40"
              Visibility="Collapsed" />

        <Grid x:Name="ShellTitleBar"
