<ui:FluentWindow x:Class="Emerde.Views.PlatformCookieLoginWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
                 Title="Emerde"
                 Width="1020"
                 Height="760"
                 MinWidth="760"
                 MinHeight="560"
                 BorderBrush="Transparent"
                 BorderThickness="0"
                 ExtendsContentIntoTitleBar="True"
                 ResizeMode="CanResize"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner">
    <Grid Background="{DynamicResource EmerdeShellBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
            <RowDefinition Height="62" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="WindowTitleBar"
                     Grid.Row="0"
                     Height="36"
                     ShowMaximize="True" />

        <Grid Grid.Row="1" Margin="16,8,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton"
                    Width="34"
                    Height="34"
                    MinWidth="34"
                    Padding="0"
                    Click="BackButtonClick"
                    FocusVisualStyle="{x:Null}"
                    ToolTip="Back">
                <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}"
                             FontSize="14"
                             Glyph="&#xE72B;" />
            </Button>
            <Button Grid.Column="1"
                    Width="34"
                    Height="34"
                    MinWidth="34"
                    Margin="8,0,0,0"
                    Padding="0"
                    Click="RefreshButtonClick"
                    FocusVisualStyle="{x:Null}"
                    ToolTip="Refresh">
                <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}"
                             FontSize="14"
                             Glyph="&#xE72C;" />
            </Button>
            <Border Grid.Column="2"
                    Height="34"
                    Margin="8,0,0,0"
                    Padding="12,0"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    CornerRadius="{StaticResource ButtonCornerRadius}">
                <TextBlock x:Name="AddressText"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Margin="16,0"
                Background="{DynamicResource EmerdeSurfaceBrush}"
                ClipToBounds="True"
                CornerRadius="{StaticResource Win11ControlCornerRadius}">
            <wv2:WebView2 x:Name="Browser" />
        </Border>

        <Grid Grid.Row="3" Margin="16,10,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{I18N CookieLoginInitializing}"
                       TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1"
                    MinWidth="88"
                    Margin="12,0,0,0"
                    Click="CancelButtonClick"
                    Content="{I18N ButtonOfCancel}"
                    FocusVisualStyle="{x:Null}" />
            <Button x:Name="CompleteButton"
                    Grid.Column="2"
                    MinWidth="116"
                    Margin="8,0,0,0"
                    Click="CompleteButtonClick"
                    Content="{I18N CookieLoginFinish}"
                    FocusVisualStyle="{x:Null}"
                    IsEnabled="False" />
        </Grid>
    </Grid>
</ui:FluentWindow>
