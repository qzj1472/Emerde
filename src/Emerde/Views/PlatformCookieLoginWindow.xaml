<ui:FluentWindow x:Class="Emerde.Views.PlatformCookieLoginWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
                 Title="Emerde"
                  Width="1020"
                  Height="720"
                  MinWidth="640"
                  MinHeight="480"
                 BorderBrush="Transparent"
                 BorderThickness="0"
                 ExtendsContentIntoTitleBar="True"
                 ResizeMode="CanResize"
                 WindowCornerPreference="Round"
                 SnapsToDevicePixels="True"
                 UseLayoutRounding="True"
                 WindowStartupLocation="CenterOwner">
    <ui:FluentWindow.Resources>
        <Style x:Key="CookieLoginShellStyle" TargetType="{x:Type Grid}">
            <Setter Property="Background" Value="{DynamicResource EmerdeShellBackgroundBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding MainWindow.DataContext.StatusOfIsUiXEnabled, Source={x:Static Application.Current}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource UiXWindowFallbackBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CookieLoginAddressStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="{StaticResource ButtonCornerRadius}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding MainWindow.DataContext.StatusOfIsUiXEnabled, Source={x:Static Application.Current}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource UiXDialogSectionBrush}" />
                    <Setter Property="CornerRadius" Value="{StaticResource UiXSurfaceCornerRadius}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CookieLoginBrowserSurfaceStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource EmerdeSurfaceBrush}" />
            <Setter Property="CornerRadius" Value="{StaticResource Win11ControlCornerRadius}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding MainWindow.DataContext.StatusOfIsUiXEnabled, Source={x:Static Application.Current}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource UiXDialogSurfaceBrush}" />
                    <Setter Property="CornerRadius" Value="{StaticResource UiXSurfaceCornerRadius}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CookieLoginSecondaryTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding MainWindow.DataContext.StatusOfIsUiXEnabled, Source={x:Static Application.Current}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource UiXTextSecondaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>
    <Grid Style="{StaticResource CookieLoginShellStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="WindowTitleBar"
                     Grid.Row="0"
                     Height="36"
                     ShowMaximize="True" />

        <Grid Grid.Row="1" Margin="16,8,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton"
                    Width="34"
                    Height="34"
                    MinWidth="34"
                    Padding="0"
                    Click="BackButtonClick"
                    FocusVisualStyle="{x:Null}"
                    ToolTip="{I18N CookieLoginBack}">
                <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}"
                             FontSize="14"
                             Glyph="&#xE72B;" />
            </Button>
            <Button Grid.Column="1"
                    Width="34"
                    Height="34"
                    MinWidth="34"
                    Margin="8,0,0,0"
                    Padding="0"
                    Click="RefreshButtonClick"
                    FocusVisualStyle="{x:Null}"
                    ToolTip="{I18N RefreshButton}">
                <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}"
                             FontSize="14"
                             Glyph="&#xE72C;" />
            </Button>
            <Border Grid.Column="2"
                    Height="34"
                    Margin="8,0,0,0"
                    Padding="12,0"
                    Style="{StaticResource CookieLoginAddressStyle}">
                <TextBlock x:Name="AddressText"
                           VerticalAlignment="Center"
                           Style="{StaticResource CookieLoginSecondaryTextStyle}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Margin="16,0"
                ClipToBounds="True"
                Style="{StaticResource CookieLoginBrowserSurfaceStyle}">
            <wv2:WebView2 x:Name="Browser" />
        </Border>

        <Grid Grid.Row="3" Margin="16,10,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Style="{StaticResource CookieLoginSecondaryTextStyle}"
                       Text="{I18N CookieLoginInitializing}"
                       TextWrapping="Wrap"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <Button Grid.Column="1"
                    MinWidth="88"
                    Margin="12,0,0,0"
                    Click="CancelButtonClick"
                    Content="{I18N ButtonOfCancel}"
                    FocusVisualStyle="{x:Null}" />
            <Button x:Name="CompleteButton"
                    Grid.Column="2"
                    MinWidth="116"
                    Margin="8,0,0,0"
                    Click="CompleteButtonClick"
                    Content="{I18N CookieLoginFinish}"
                    FocusVisualStyle="{x:Null}"
                    IsEnabled="False" />
        </Grid>
    </Grid>
</ui:FluentWindow>
