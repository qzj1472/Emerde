<UserControl x:Class="Emerde.Views.LocalSettingsContentDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="http://schemas.github.com/computedconverters/2024/xaml"
             xmlns:controls="clr-namespace:Emerde.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
             xmlns:views="clr-namespace:Emerde.Views"
             MinWidth="0"
             MinHeight="0"
             Focusable="False"
             FocusVisualStyle="{x:Null}"
             FontSize="14"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="UiXLocalSettingsGroupStyle" TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="16" />
            <Setter Property="Background" Value="{DynamicResource UiXDialogSectionBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource UiXSurfaceCornerRadius}" />
        </Style>
        <Style x:Key="UiXLocalSettingsFadeStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource EmerdeSurfaceBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.StatusOfIsUiXEnabled, RelativeSource={RelativeSource AncestorType={x:Type views:MainWindow}}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource UiXDialogSurfaceBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type ui:Card}" BasedOn="{StaticResource {x:Type ui:Card}}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="{DynamicResource EmerdePanelBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="86" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ui:Card}">
                        <Border MinHeight="{TemplateBinding MinHeight}"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Win11ControlCornerRadius}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.StatusOfIsUiXEnabled, RelativeSource={RelativeSource AncestorType={x:Type views:MainWindow}}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource UiXDialogSectionBrush}" />
                    <Setter Property="BorderThickness" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type ui:CardExpander}" BasedOn="{StaticResource {x:Type ui:CardExpander}}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="{DynamicResource EmerdePanelBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="86" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="ContentPadding" Value="0,8,0,14" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.StatusOfIsUiXEnabled, RelativeSource={RelativeSource AncestorType={x:Type views:MainWindow}}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource UiXDialogSectionBrush}" />
                    <Setter Property="BorderThickness" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Border Background="Transparent">
        <Border x:Name="LocalSettingsSurface"
                Padding="0"
                ClipToBounds="True"
                CornerRadius="{StaticResource Win11ControlCornerRadius}"
                Focusable="False"
                FocusVisualStyle="{x:Null}"
                SizeChanged="LocalSettingsSurfaceSizeChanged"
                Style="{StaticResource EmerdeDialogSurfaceStyle}"
                controls:MotionAssist.IsEntranceEnabled="True"
                controls:MotionAssist.EntranceOffsetY="8"
                controls:MotionAssist.EntranceScale="0.98">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="14,10,14,0"
                      Visibility="{Binding ShowIdentityHeader, Converter={x:Static c:BoolToVisibilityConverter.Instance}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:FontIcon Grid.Column="0"
                                 Margin="0,0,12,0"
                                 VerticalAlignment="Center"
                                 FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                 FontSize="20"
                                 Glyph="{x:Static ui:FontSymbols.Settings}" />
                    <ui:StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock FontWeight="SemiBold" Text="{Binding NickName}" />
                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding RoomUrl}"
                                   TextTrimming="CharacterEllipsis" />
                    </ui:StackPanel>
                </Grid>

                <ui:Card x:Name="SettingsModeCard"
                         Grid.Row="1"
                         MinHeight="64"
                         Margin="14,10,14,8"
                         Padding="14,8"
                         Visibility="{Binding ShowSettingsHeader, Converter={x:Static c:BoolToVisibilityConverter.Instance}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0"
                                  Content="{I18N FollowGlobalSettings}"
                                  IsChecked="{Binding IsFollowGlobalSettings, Mode=TwoWay}" />
                        <CheckBox Grid.Column="1"
                                  HorizontalAlignment="Left"
                                  Content="{I18N LiveNotification}"
                                  IsChecked="{Binding IsToNotify, Mode=TwoWay}" />
                    </Grid>
                </ui:Card>

                <Border Grid.Row="2"
                        Margin="14,12,14,14"
                        Padding="20">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}" BasedOn="{StaticResource UiXLocalSettingsGroupStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsUiXEnabled}" Value="True" />
                                        <Condition Binding="{Binding IsFollowGlobalSettings}" Value="True" />
                                        <Condition Binding="{Binding ShowSettingsHeader}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:FontIcon Grid.Column="0"
                                     Margin="0,0,14,0"
                                     VerticalAlignment="Center"
                                     FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                     FontSize="20"
                                     Foreground="{DynamicResource UiXTextSecondaryBrush}"
                                     Glyph="{x:Static ui:FontSymbols.Sync}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource UiXSectionTitleTextStyle}" Text="{I18N FollowGlobalSettings}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="IsEnabled" Value="True" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFollowGlobalSettings}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsUiXEnabled}" Value="True" />
                                        <Condition Binding="{Binding IsFollowGlobalSettings}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid ClipToBounds="True">
                        <ScrollViewer x:Name="LocalSettingsScrollViewer"
                                      Margin="0,0,8,0"
                                      BorderThickness="0"
                                      Focusable="True"
                                      IsTabStop="True"
                                      Padding="14,12,6,12"
                                      PanningMode="VerticalOnly"
                                      ScrollViewer.CanContentScroll="False"
                                      VerticalScrollBarVisibility="Visible">
                            <ui:StackPanel x:Name="LocalSettingsItemsPanel" Margin="0,0,8,0" Spacing="10">
                                <ui:Card x:Name="RoomActionsCard" Padding="14">
                                    <Grid MinHeight="54">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton Grid.Column="0"
                                                       Margin="0,0,6,0"
                                                       HorizontalAlignment="Stretch"
                                                       Content="{I18N Monitor}"
                                                       IsChecked="{Binding IsToMonitor, Mode=TwoWay}" />
                                        <ToggleButton Grid.Column="1"
                                                       Margin="6,0,0,0"
                                                       HorizontalAlignment="Stretch"
                                                       Content="{I18N EnableRecord}"
                                                       IsChecked="{Binding IsToRecord, Mode=TwoWay}" />
                                    </Grid>
                                </ui:Card>

                                <ui:Card x:Name="QualityCard">
                                    <Grid MinHeight="35">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:FontIcon Grid.Column="0"
                                                     Margin="4,0,18,0"
                                                     VerticalAlignment="Center"
                                                     FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                     FontSize="20"
                                                     Glyph="{x:Static ui:FontSymbols.Video}" />
                                        <Grid Grid.Column="1">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="{I18N QualityLabel}" />
                                            <TextBlock Grid.Row="1"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SystemFillColorSolidNeutralBrush}"
                                                       Text="{I18N StreamQualityHint}" />
                                        </Grid>
                                        <ComboBox Grid.Column="2"
                                                  MinWidth="150"
                                                  Margin="16,0,12,0"
                                                  DisplayMemberPath="DisplayName"
                                                  ItemsSource="{Binding QualityOptions}"
                                                  SelectedValue="{Binding PreferredQuality, Mode=TwoWay}"
                                                  SelectedValuePath="Value" />
                                    </Grid>
                                </ui:Card>

                                <ui:Card x:Name="SchedulePresetCard" Visibility="{Binding IsRoutineSchedulePreset, Converter={x:Static c:BoolToVisibilityConverter.Instance}}">
                                    <Grid MinHeight="35">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:FontIcon Grid.Column="0"
                                                     Margin="4,0,18,0"
                                                     VerticalAlignment="Center"
                                                     FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                     FontSize="20"
                                                     Glyph="{x:Static ui:FontSymbols.Calendar}" />
                                        <Grid Grid.Column="1">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="{I18N MonitoringSchedule}" />
                                            <TextBlock Grid.Row="1"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SystemFillColorSolidNeutralBrush}"
                                                       Text="{I18N RoomMonitoringScheduleHint}" />
                                        </Grid>
                                        <ComboBox Grid.Column="2"
                                                  MinWidth="150"
                                                  Margin="16,0,12,0"
                                                  SelectedIndex="{Binding RoutineScheduleModeIndex, Mode=TwoWay}">
                                            <ComboBoxItem Content="{I18N ScheduleAlways}" ToolTip="{I18N ScheduleAlwaysHint}" />
                                            <ComboBoxItem Content="{I18N ScheduleWeekdays}" ToolTip="{I18N ScheduleWeekdaysHint}" />
                                            <ComboBoxItem Content="{I18N ScheduleWeekends}" ToolTip="{I18N ScheduleWeekendsHint}" />
                                            <ComboBoxItem Content="{I18N ScheduleNight}" ToolTip="{I18N ScheduleNightHint}" />
                                            <ComboBoxItem Content="{I18N ScheduleCustom}" ToolTip="{I18N ScheduleCustomHint}" />
                                        </ComboBox>
                                    </Grid>
                                </ui:Card>

                                <ui:CardExpander x:Name="ScheduleCustomCard"
                                                 IsExpanded="True"
                                                 Visibility="{Binding IsRoutineScheduleCustom, Converter={x:Static c:BoolToVisibilityConverter.Instance}}">
                                    <ui:CardExpander.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:FontIcon Grid.Column="0"
                                                         Margin="4,0,18,0"
                                                         VerticalAlignment="Center"
                                                         FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                         FontSize="20"
                                                         Glyph="{x:Static ui:FontSymbols.Calendar}" />
                                            <Grid Grid.Column="1">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="{I18N MonitoringSchedule}" />
                                                <TextBlock Grid.Row="1"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource SystemFillColorSolidNeutralBrush}"
                                                           Text="{I18N RoomMonitoringScheduleHint}" />
                                            </Grid>
                                            <ComboBox Grid.Column="2"
                                                      MinWidth="150"
                                                      Margin="0,0,12,0"
                                                      SelectedIndex="{Binding RoutineScheduleModeIndex, Mode=TwoWay}">
                                                <ComboBoxItem Content="{I18N ScheduleAlways}" ToolTip="{I18N ScheduleAlwaysHint}" />
                                                <ComboBoxItem Content="{I18N ScheduleWeekdays}" ToolTip="{I18N ScheduleWeekdaysHint}" />
                                                <ComboBoxItem Content="{I18N ScheduleWeekends}" ToolTip="{I18N ScheduleWeekendsHint}" />
                                                <ComboBoxItem Content="{I18N ScheduleNight}" ToolTip="{I18N ScheduleNightHint}" />
                                                <ComboBoxItem Content="{I18N ScheduleCustom}" ToolTip="{I18N ScheduleCustomHint}" />
                                            </ComboBox>
                                        </Grid>
                                    </ui:CardExpander.Header>
                                    <ui:StackPanel Margin="42,0,28,0" Spacing="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="92" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" Text="{I18N Date}" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <DatePicker Width="160" SelectedDate="{Binding RoutineScheduleStartDate, Mode=TwoWay}" />
                                                <TextBlock Margin="12,0" VerticalAlignment="Center" Text="{I18N To}" />
                                                <DatePicker Width="160" SelectedDate="{Binding RoutineScheduleEndDate, Mode=TwoWay}" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="92" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                <TextBlock VerticalAlignment="Center" Text="{I18N ScheduleDays}" />
                                                <ui:ToggleSwitch Margin="10,0,0,0" IsChecked="{Binding RoutineScheduleUseDays, Mode=TwoWay}" />
                                            </StackPanel>
                                            <UniformGrid Grid.Column="1" Columns="7" IsEnabled="{Binding RoutineScheduleUseDays}">
                                                <ToggleButton Margin="0,0,6,0" HorizontalAlignment="Stretch" Content="{I18N Monday}" IsChecked="{Binding RoutineScheduleMonday, Mode=TwoWay}" />
                                                <ToggleButton Margin="0,0,6,0" HorizontalAlignment="Stretch" Content="{I18N Tuesday}" IsChecked="{Binding RoutineScheduleTuesday, Mode=TwoWay}" />
                                                <ToggleButton Margin="0,0,6,0" HorizontalAlignment="Stretch" Content="{I18N Wednesday}" IsChecked="{Binding RoutineScheduleWednesday, Mode=TwoWay}" />
                                                <ToggleButton Margin="0,0,6,0" HorizontalAlignment="Stretch" Content="{I18N Thursday}" IsChecked="{Binding RoutineScheduleThursday, Mode=TwoWay}" />
                                                <ToggleButton Margin="0,0,6,0" HorizontalAlignment="Stretch" Content="{I18N Friday}" IsChecked="{Binding RoutineScheduleFriday, Mode=TwoWay}" />
                                                <ToggleButton Margin="0,0,6,0" HorizontalAlignment="Stretch" Content="{I18N Saturday}" IsChecked="{Binding RoutineScheduleSaturday, Mode=TwoWay}" />
                                                <ToggleButton HorizontalAlignment="Stretch" Content="{I18N Sunday}" IsChecked="{Binding RoutineScheduleSunday, Mode=TwoWay}" />
                                            </UniformGrid>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="92" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                <TextBlock VerticalAlignment="Center" Text="{I18N TimeRange}" />
                                                <ui:ToggleSwitch Margin="10,0,0,0" IsChecked="{Binding RoutineScheduleUseTimeRange, Mode=TwoWay}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" IsEnabled="{Binding RoutineScheduleUseTimeRange}">
                                                <controls:CompactNumberBox Width="112" Maximum="23" Minimum="0" Value="{Binding RoutineScheduleStartHour, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Margin="6,0" VerticalAlignment="Center" Text=":" />
                                                <controls:CompactNumberBox Width="112" Maximum="59" Minimum="0" Value="{Binding RoutineScheduleStartMinute, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Margin="12,0" VerticalAlignment="Center" Text="{I18N To}" />
                                                <controls:CompactNumberBox Width="112" Maximum="23" Minimum="0" Value="{Binding RoutineScheduleEndHour, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Margin="6,0" VerticalAlignment="Center" Text=":" />
                                                <controls:CompactNumberBox Width="112" Maximum="59" Minimum="0" Value="{Binding RoutineScheduleEndMinute, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>
                                    </ui:StackPanel>
                                </ui:CardExpander>

                                <ui:Card x:Name="RoutineIntervalCard">
                                    <Grid MinHeight="35">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:FontIcon Grid.Column="0"
                                                     Margin="4,0,18,0"
                                                     VerticalAlignment="Center"
                                                     FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                     FontSize="20"
                                                     Glyph="{x:Static ui:FontSymbols.DeviceMonitorRightPic}" />
                                        <Grid Grid.Column="1">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="{I18N RoutineInterval}" />
                                            <TextBlock Grid.Row="1"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SystemFillColorSolidNeutralBrush}"
                                                       Text="{I18N RoutineIntervalHint}" />
                                        </Grid>
                                        <ui:StackPanel Grid.Column="2"
                                                       Margin="16,0,12,0"
                                                       Orientation="Horizontal"
                                                       Spacing="8">
                                            <controls:CompactNumberBox MinWidth="112"
                                                                       Maximum="2147483647"
                                                                       Minimum="1"
                                                                       Value="{Binding RoutineIntervalValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <ComboBox MinWidth="86"
                                                      DisplayMemberPath="DisplayName"
                                                      ItemsSource="{Binding TimeUnitOptions}"
                                                      SelectedValue="{Binding RoutineIntervalUnitIndex, Mode=TwoWay}"
                                                      SelectedValuePath="Value" />
                                        </ui:StackPanel>
                                    </Grid>
                                </ui:Card>

                                <ui:CardExpander x:Name="RecordFormatCard">
                                    <ui:CardExpander.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:FontIcon Grid.Column="0"
                                                         Margin="4,0,18,0"
                                                         VerticalAlignment="Center"
                                                         FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                         FontSize="20"
                                                         Glyph="{x:Static ui:FontSymbols.Filter}" />
                                            <Grid Grid.Column="1">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="{I18N RecordFormat}" />
                                                <TextBlock Grid.Row="1"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource SystemFillColorSolidNeutralBrush}"
                                                           Text="{I18N RecordFormatHint}" />
                                            </Grid>
                                            <ComboBox Grid.Column="2"
                                                      MinWidth="150"
                                                      Margin="0,0,12,0"
                                                      SelectedIndex="{Binding RecordFormatIndex, Mode=TwoWay}">
                                                <ComboBoxItem Content="TS/FLV" />
                                                <ComboBoxItem Content="TS/FLV -&gt; MP4" />
                                                <ComboBoxItem Content="TS/FLV -&gt; MKV" />
                                            </ComboBox>
                                        </Grid>
                                    </ui:CardExpander.Header>
                                    <StackPanel Margin="42,0,28,0">
                                        <CheckBox Content="{I18N CreateOptimizedAudioTrack}"
                                                  Margin="0,0,0,12"
                                                  IsChecked="{Binding IsOptimizeAudio, Mode=TwoWay}"
                                                  Visibility="{Binding IsMp4RecordFormat, Converter={x:Static c:BoolToVisibilityConverter.Instance}}" />
                                        <CheckBox Content="{I18N RecordFormatAutoRemove}"
                                                  IsChecked="{Binding IsRemoveTs, Mode=TwoWay}"
                                                  Visibility="{Binding IsTranscodedRecordFormat, Converter={x:Static c:BoolToVisibilityConverter.Instance}}" />
                                    </StackPanel>
                                </ui:CardExpander>

                                <ui:Card x:Name="SegmentCard">
                                    <Grid MinHeight="35">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:FontIcon Grid.Column="0"
                                                     Margin="4,0,18,0"
                                                     VerticalAlignment="Center"
                                                     FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                     FontSize="20"
                                                     Glyph="{x:Static ui:FontSymbols.BulletedList}" />
                                        <Grid Grid.Column="1">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="{I18N Segment}" />
                                            <TextBlock Grid.Row="1"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SystemFillColorSolidNeutralBrush}"
                                                       Text="{I18N SegmentHint}" />
                                        </Grid>
                                        <ui:StackPanel Grid.Column="2"
                                                       Margin="16,0,12,0"
                                                       Orientation="Horizontal"
                                                       Spacing="8">
                                            <ui:StackPanel Orientation="Horizontal"
                                                           Spacing="8"
                                                           Visibility="{Binding IsToSegment, Converter={x:Static c:BoolToVisibilityConverter.Instance}}">
                                                <controls:CompactNumberBox MinWidth="112"
                                                                           Maximum="2147483647"
                                                                           Minimum="1"
                                                                           Value="{Binding SegmentTimeValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <ComboBox MinWidth="86"
                                                          DisplayMemberPath="DisplayName"
                                                          ItemsSource="{Binding SegmentUnitOptions}"
                                                          SelectedValue="{Binding SegmentTimeUnitIndex, Mode=TwoWay}"
                                                          SelectedValuePath="Value" />
                                            </ui:StackPanel>
                                            <ui:ToggleSwitch IsChecked="{Binding IsToSegment, Mode=TwoWay}" />
                                        </ui:StackPanel>
                                    </Grid>
                                </ui:Card>

                                <ui:CardExpander x:Name="SaveCard">
                                    <ui:CardExpander.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ui:FontIcon Grid.Column="0"
                                                         Margin="4,0,18,0"
                                                         VerticalAlignment="Center"
                                                         FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                         FontSize="20"
                                                         Glyph="{x:Static ui:FontSymbols.Folder}" />
                                            <Grid Grid.Column="1">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="{I18N Save}" />
                                                <TextBlock Grid.Row="1"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource SystemFillColorSolidNeutralBrush}"
                                                           Text="{I18N SaveFolderHint}" />
                                            </Grid>
                                        </Grid>
                                    </ui:CardExpander.Header>
                                    <ui:StackPanel Spacing="10">
                                        <Grid Margin="42,0,28,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{I18N SaveFolder}" />
                                            <ui:TextBox Grid.Column="1"
                                                        Margin="8,0,0,0"
                                                        PlaceholderText="EmerdeDownloads"
                                                        Text="{Binding SaveFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="2"
                                                    Margin="8,0,0,0"
                                                    Command="{Binding SelectSaveFolderCommand}"
                                                    Content="{I18N SelectFolder}" />
                                            <Button Grid.Column="3"
                                                    Margin="8,0,0,0"
                                                    Command="{Binding OpenSaveFolderCommand}"
                                                    Content="{I18N OpenFolder}" />
                                        </Grid>
                                        <Grid Margin="42,0,28,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{I18N SavePathLevel}" />
                                            <ComboBox Grid.Column="1"
                                                      MinWidth="190"
                                                      Margin="8,0,0,0"
                                                      SelectedIndex="{Binding SaveFolderPathLevelIndex, Mode=TwoWay}">
                                                <ComboBoxItem Content="{I18N SavePathLevelRootOnly}" />
                                                <ComboBoxItem Content="{I18N SavePathLevelAuthor}" />
                                                <ComboBoxItem Content="{I18N SavePathLevelAuthorYearMonth}" />
                                                <ComboBoxItem Content="{I18N SavePathLevelAuthorDate}" />
                                            </ComboBox>
                                        </Grid>
                                        <ui:StackPanel Margin="42,10,28,0" Spacing="10">
                                            <Border Height="1"
                                                    Margin="0,0,0,2"
                                                    Background="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                    Opacity="0.65" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{I18N CustomRule}" />
                                                <ui:TextBox Grid.Column="1"
                                                            Margin="16,0,0,0"
                                                            Cursor="Arrow"
                                                            Focusable="False"
                                                            IsReadOnly="True"
                                                            IsTabStop="False"
                                                            PlaceholderText="{}{主播名}_{录制开始时间}_{直播标题}"
                                                            Text="{Binding SaveFileNameCustomRule, Mode=OneWay}" />
                                                <Button Grid.Column="2"
                                                        Width="34"
                                                        Height="34"
                                                        MinWidth="34"
                                                        Margin="8,0,0,0"
                                                        Padding="0"
                                                        Command="{Binding DeleteLastSaveFileNameTokenCommand}"
                                                        ToolTip="{I18N DeleteLast}">
                                                    <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" Glyph="{x:Static ui:FontSymbols.Delete}" />
                                                </Button>
                                                <Button Grid.Column="3"
                                                        Width="34"
                                                        Height="34"
                                                        MinWidth="34"
                                                        Margin="8,0,0,0"
                                                        Padding="0"
                                                        Command="{Binding ClearSaveFileNameCustomRuleCommand}"
                                                        ToolTip="{I18N Clear}">
                                                    <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" Glyph="{x:Static ui:FontSymbols.CalculatorMultiply}" />
                                                </Button>
                                            </Grid>
                                            <UniformGrid Columns="4">
                                                <Button Margin="0,0,8,8" Command="{Binding AppendSaveFileNameTokenCommand}" CommandParameter="{}{主播名}" Content="{I18N TokenAuthor}" />
                                                <Button Margin="0,0,8,8" Command="{Binding AppendSaveFileNameTokenCommand}" CommandParameter="{}{平台}" Content="{I18N Platform}" />
                                                <Button Margin="0,0,8,8" Command="{Binding AppendSaveFileNameTokenCommand}" CommandParameter="{}{直播标题}" Content="{I18N TokenLiveTitle}" />
                                                <Button Margin="0,0,8,8" Command="{Binding AppendSaveFileNameTokenCommand}" CommandParameter="{}{房间号}" Content="{I18N TokenRoomId}" />
                                                <Button Margin="0,0,8,8" Command="{Binding AppendSaveFileNameTokenCommand}" CommandParameter="{}{分辨率}" Content="{I18N ResolutionLabel}" />
                                                <Button Margin="0,0,8,8" Command="{Binding AppendSaveFileNameTokenCommand}" CommandParameter="{}{码率}" Content="{I18N TokenBitrate}" />
                                                <Button Margin="0,0,8,8" Command="{Binding AppendSaveFileNameTokenCommand}" CommandParameter="{}{帧率}" Content="{I18N TokenFrameRate}" />
                                                <Button Margin="0,0,8,8" Command="{Binding AppendSaveFileNameTokenCommand}" CommandParameter="{}{画质}" Content="{I18N TokenQuality}" />
                                                <Button Margin="0,0,8,8" Command="{Binding AppendSaveFileNameTokenCommand}" CommandParameter="{}{视频编码}" Content="{I18N TokenVideoCodec}" />
                                                <Button Margin="0,0,8,8" Command="{Binding AppendSaveFileNameTokenCommand}" CommandParameter="{}{音频编码}" Content="{I18N TokenAudioCodec}" />
                                                <Button Margin="0,0,8,8" Command="{Binding AppendSaveFileNameTokenCommand}" CommandParameter="{}{优化音频}" Content="{I18N TokenOptimizedAudio}" />
                                                <Border />
                                                <Button Margin="0,0,8,8" Command="{Binding AppendSaveFileNameTokenCommand}" CommandParameter="{}{录制开始时间}" Content="{I18N TokenRecordStartTime}" />
                                                <Button Margin="0,0,8,8" Command="{Binding AppendSaveFileNameTokenCommand}" CommandParameter="{}{录制结束时间}" Content="{I18N TokenRecordEndTime}" />
                                                <Button Margin="0,0,8,8" Command="{Binding AppendSaveFileNameTokenCommand}" CommandParameter="{}{视频时长}" Content="{I18N TokenDuration}" />
                                            </UniformGrid>
                                        </ui:StackPanel>
                                    </ui:StackPanel>
                                </ui:CardExpander>
                            </ui:StackPanel>
                        </ScrollViewer>
                        <Border x:Name="TopScrollFade"
                                Margin="14,0,30,0"
                                VerticalAlignment="Top"
                                Panel.ZIndex="20"
                                IsHitTestVisible="False"
                                OpacityMask="{StaticResource TopEdgeFadeOpacityMask}">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}" BasedOn="{StaticResource UiXLocalSettingsFadeStyle}">
                                    <Setter Property="Height" Value="18" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ShowIdentityHeader}" Value="False" />
                                                <Condition Binding="{Binding ShowSettingsHeader}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Height" Value="32" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <Border x:Name="BottomScrollFade"
                                Margin="14,0,30,0"
                                VerticalAlignment="Bottom"
                                Panel.ZIndex="20"
                                IsHitTestVisible="False"
                                OpacityMask="{StaticResource BottomEdgeFadeOpacityMask}">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}" BasedOn="{StaticResource UiXLocalSettingsFadeStyle}">
                                    <Setter Property="Height" Value="26" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ShowIdentityHeader}" Value="False" />
                                                <Condition Binding="{Binding ShowSettingsHeader}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Height" Value="36" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</UserControl>
