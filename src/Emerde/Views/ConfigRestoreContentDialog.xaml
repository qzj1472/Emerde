<UserControl x:Class="Emerde.Views.ConfigRestoreContentDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Emerde.Controls"
             xmlns:views="clr-namespace:Emerde.Views"
             AllowDrop="True"
             DragOver="ConfigRestoreDragOver"
             Drop="ConfigRestoreDrop"
             Loaded="ConfigRestoreContentLoaded"
             SizeChanged="ConfigRestoreContentSizeChanged"
             Focusable="False"
             FocusVisualStyle="{x:Null}"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <Style x:Key="RestoreOptionListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="controls:MotionAssist.IsEntranceEnabled" Value="True" />
            <Setter Property="controls:MotionAssist.EntranceOffsetY" Value="6" />
            <Setter Property="controls:MotionAssist.EntranceScale" Value="0.99" />
            <Setter Property="controls:MotionAssist.IsPressEnabled" Value="True" />
            <Setter Property="controls:MotionAssist.HoverScale" Value="1.004" />
            <Setter Property="controls:MotionAssist.PressScale" Value="0.996" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RestoreOptionsSurfaceStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource EmerdeDialogBackgroundBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding MainWindow.DataContext.StatusOfIsUiXEnabled, Source={x:Static Application.Current}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource EmerdeDialogBackgroundBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RestoreOptionListBoxStyle" TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="KeyboardNavigation.TabNavigation" Value="Local" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBox}">
                        <Grid ClipToBounds="True">
                            <ScrollViewer x:Name="OptionsScrollViewer"
                                          Focusable="True"
                                          CanContentScroll="False"
                                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                          ScrollChanged="OptionsScrollViewerScrollChanged">
                                <Border Padding="0,16,0,8"
                                        Style="{StaticResource RestoreOptionsSurfaceStyle}">
                                    <ItemsPresenter />
                                </Border>
                            </ScrollViewer>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RestoreOptionCardStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource EmerdeDialogSectionStyle}">
            <Setter Property="Margin" Value="0,0,18,8" />
            <Setter Property="Padding" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding MainWindow.DataContext.StatusOfIsUiXEnabled, Source={x:Static Application.Current}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource UiXDialogSectionBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RestoreOptionStrokeStyle" TargetType="{x:Type Border}">
            <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Win11ControlCornerRadius}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding MainWindow.DataContext.StatusOfIsUiXEnabled, Source={x:Static Application.Current}}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource UiXStrokeBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="ContentRoot"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          controls:MotionAssist.IsEntranceEnabled="True"
          controls:MotionAssist.EntranceOffsetY="8"
          controls:MotionAssist.EntranceScale="0.98">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,18,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Style="{StaticResource EmerdeDialogBodyTextStyle}"
                           Text="{I18N ConfigRestoreDescription}" />
                <TextBlock Margin="0,6,0,0"
                           Style="{StaticResource EmerdeDialogSecondaryTextStyle}"
                           Text="{I18N ConfigRestoreBackupHint}" />
            </StackPanel>
            <Button Grid.Column="1"
                    MinWidth="104"
                    VerticalAlignment="Top"
                    Click="ImportButtonClick"
                    Content="{I18N ImportConfigTitle}" />
        </Grid>

        <Grid x:Name="OptionsViewport"
              Grid.Row="1"
              MinHeight="0"
              Margin="0,4,0,0"
              ClipToBounds="True">
            <ListBox x:Name="OptionsListBox"
                     HorizontalContentAlignment="Stretch"
                     ItemContainerStyle="{StaticResource RestoreOptionListBoxItemStyle}"
                     ItemsSource="{Binding Options, RelativeSource={RelativeSource AncestorType={x:Type views:ConfigRestoreContentDialog}}}"
                     SelectionChanged="OptionsListBoxSelectionChanged">
                <ListBox.Style>
                    <StaticResource ResourceKey="RestoreOptionListBoxStyle" />
                </ListBox.Style>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type views:ConfigRestoreOption}">
                        <Border x:Name="Card"
                                Padding="0"
                                BorderThickness="0"
                                Style="{StaticResource RestoreOptionCardStyle}">
                            <Grid>
                                <Border x:Name="CardStrokeLayer"
                                        BorderThickness="1"
                                        Style="{StaticResource RestoreOptionStrokeStyle}"
                                        IsHitTestVisible="False" />
                                <Border Padding="13"
                                        Background="Transparent">
                                    <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource EmerdeDialogSectionTitleTextStyle}"
                                               Text="{Binding Title}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,4,0,0"
                                               Style="{StaticResource EmerdeDialogSecondaryTextStyle}"
                                               Text="{Binding Subtitle}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,6,0,0"
                                               Style="{StaticResource EmerdeDialogSecondaryTextStyle}"
                                               Text="{Binding Detail}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Border x:Name="Badge"
                                        Grid.Column="1"
                                        Margin="12,0,0,0"
                                        Padding="9,4"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource UiXDialogSelectionBrush}"
                                        CornerRadius="{StaticResource Win11ControlCornerRadius}">
                                    <TextBlock x:Name="BadgeText"
                                               FontSize="11"
                                               Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                               Text="{Binding BadgeText}" />
                                </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsImported}" Value="True">
                                <Setter TargetName="Badge" Property="Background" Value="{DynamicResource UiXDialogLiveBrush}" />
                                <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource UiXTextPrimaryBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource UiXDialogWarningBrush}" />
                                <Setter TargetName="CardStrokeLayer" Property="BorderBrush" Value="{DynamicResource UiXStrongStrokeBrush}" />
                                <Setter TargetName="Badge" Property="Background" Value="{DynamicResource UiXDialogWarningBrush}" />
                                <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource UiXTextPrimaryBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource UiXDialogSelectionBrush}" />
                                <Setter TargetName="CardStrokeLayer" Property="BorderBrush" Value="{DynamicResource UiXSelectionStrokeBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Height="16"
                    x:Name="OptionsTopFade"
                    VerticalAlignment="Top"
                    Panel.ZIndex="10"
                    Style="{StaticResource RestoreOptionsSurfaceStyle}"
                    IsHitTestVisible="False"
                    OpacityMask="{StaticResource TopEdgeFadeOpacityMask}"
                    Visibility="Collapsed" />
            <Border Height="12"
                    x:Name="OptionsBottomFade"
                    VerticalAlignment="Bottom"
                    Panel.ZIndex="10"
                    Style="{StaticResource RestoreOptionsSurfaceStyle}"
                    IsHitTestVisible="False"
                    OpacityMask="{StaticResource BottomEdgeFadeOpacityMask}"
                    Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
