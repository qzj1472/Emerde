<UserControl x:Class="Emerde.Views.ConfigRestoreContentDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Emerde.Views"
             AllowDrop="True"
             DragOver="ConfigRestoreDragOver"
             Drop="ConfigRestoreDrop"
             Focusable="False"
             FocusVisualStyle="{x:Null}">
    <UserControl.Resources>
        <Style x:Key="RestoreOptionListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RestoreOptionListBoxStyle" TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBox}">
                        <Grid ClipToBounds="True">
                            <ScrollViewer x:Name="OptionsScrollViewer"
                                          Focusable="False"
                                          CanContentScroll="False"
                                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                                <Border Padding="0,16,0,8"
                                        Background="{DynamicResource EmerdeSurfaceBrush}">
                                    <ItemsPresenter />
                                </Border>
                            </ScrollViewer>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="ContentRoot"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,18,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Foreground="{DynamicResource SystemFillColorSolidNeutralBrush}"
                           Text="选择一个配置备份点恢复，也可以导入或拖入 YAML 配置文件；确认前不会替换当前配置。"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,6,0,0"
                           FontSize="11"
                           Foreground="{DynamicResource SystemFillColorSolidNeutralBrush}"
                           Text="导入、恢复、重置都会先备份有意义的当前配置，重启后生效。"
                           TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1"
                    MinWidth="104"
                    VerticalAlignment="Top"
                    Click="ImportButtonClick"
                    Content="导入配置" />
        </Grid>

        <Grid x:Name="OptionsViewport"
              Grid.Row="1"
              MinHeight="0"
              Margin="0,4,0,0"
              ClipToBounds="True">
            <ListBox x:Name="OptionsListBox"
                     HorizontalContentAlignment="Stretch"
                     ItemContainerStyle="{StaticResource RestoreOptionListBoxItemStyle}"
                     ItemsSource="{Binding Options, RelativeSource={RelativeSource AncestorType={x:Type views:ConfigRestoreContentDialog}}}"
                     PreviewMouseWheel="OptionsListBoxPreviewMouseWheel"
                     SelectionChanged="OptionsListBoxSelectionChanged">
                <ListBox.Style>
                    <StaticResource ResourceKey="RestoreOptionListBoxStyle" />
                </ListBox.Style>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type views:ConfigRestoreOption}">
                        <Border x:Name="Card"
                                Margin="0,0,18,8"
                                Padding="12"
                                Background="{DynamicResource EmerdeCardBrush}"
                                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Win11ControlCornerRadius}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock FontSize="14"
                                               FontWeight="SemiBold"
                                               Text="{Binding Title}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,4,0,0"
                                               Foreground="{DynamicResource SystemFillColorSolidNeutralBrush}"
                                               Text="{Binding Subtitle}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,6,0,0"
                                               FontSize="11"
                                               Foreground="{DynamicResource SystemFillColorSolidNeutralBrush}"
                                               Text="{Binding Detail}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Border x:Name="Badge"
                                        Grid.Column="1"
                                        Margin="12,0,0,0"
                                        Padding="9,4"
                                        VerticalAlignment="Top"
                                        Background="#14337DFF"
                                        CornerRadius="{StaticResource Win11ControlCornerRadius}">
                                    <TextBlock x:Name="BadgeText"
                                               FontSize="11"
                                               Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                               Text="{Binding BadgeText}" />
                                </Border>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsImported}" Value="True">
                                <Setter TargetName="Badge" Property="Background" Value="#1420A060" />
                                <Setter TargetName="BadgeText" Property="Foreground" Value="#20A060" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#0CD97706" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="#33D97706" />
                                <Setter TargetName="Badge" Property="Background" Value="#14D97706" />
                                <Setter TargetName="BadgeText" Property="Foreground" Value="#D97706" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#18337DFF" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="#60337DFF" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Height="16"
                    x:Name="OptionsTopFade"
                    VerticalAlignment="Top"
                    Panel.ZIndex="10"
                    Background="{DynamicResource EmerdeSurfaceBrush}"
                    IsHitTestVisible="False"
                    OpacityMask="{StaticResource TopEdgeFadeOpacityMask}"
                    Visibility="Collapsed" />
            <Border Height="12"
                    x:Name="OptionsBottomFade"
                    VerticalAlignment="Bottom"
                    Panel.ZIndex="10"
                    Background="{DynamicResource EmerdeSurfaceBrush}"
                    IsHitTestVisible="False"
                    OpacityMask="{StaticResource BottomEdgeFadeOpacityMask}"
                    Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
