<Window x:Class="Emerde.Views.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Emerde.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:Emerde.Views"
        xmlns:lottie="clr-namespace:LottieSharp.WPF;assembly=LottieSharp"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="LoadingWindow"
        Width="800"
        Height="450"
        d:Background="Black"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        mc:Ignorable="d">
    <Grid HorizontalAlignment="Center"
          VerticalAlignment="Center"
          controls:MotionAssist.IsEntranceEnabled="True"
          controls:MotionAssist.EntranceOffsetY="6"
          controls:MotionAssist.EntranceScale="0.96">
        <lottie:LottieAnimationView Width="46"
                                    Height="46"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    AutoPlay="True"
                                    RepeatCount="-1"
                                    ResourcePath="pack://application:,,,/Emerde;component/Assets/Loading.json" />
    </Grid>
</Window>
