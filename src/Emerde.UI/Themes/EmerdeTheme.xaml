<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <CornerRadius x:Key="Win11ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="TextControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="DefaultControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="DefaultOverlayCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="DefaultTextControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadiusLarge">8</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="SettingsCardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ComboBoxCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="TextBoxCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ContentDialogCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="PopupCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="FlyoutCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="MenuFlyoutItemCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ToggleSwitchCornerRadius">8</CornerRadius>

    <SolidColorBrush x:Key="EmerdeBrandFillBrush" Color="#14B86B" />
    <SolidColorBrush x:Key="EmerdeBrandFillPressedBrush" Color="#0A9553" />
    <SolidColorBrush x:Key="EmerdeBrandFillSubtleBrush" Color="#0B14B86B" />
    <SolidColorBrush x:Key="EmerdeBrandStrokeSubtleBrush" Color="#3514B86B" />

    <Style x:Key="EmerdeFocusVisualStyle" TargetType="{x:Type Control}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Border Margin="0"
                            BorderBrush="{DynamicResource EmerdeBrandFillBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            IsHitTestVisible="False"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <SolidColorBrush x:Key="ProgressBarForeground" Color="#14B86B" />
    <SolidColorBrush x:Key="ProgressBarBackground" Color="{DynamicResource ControlAltFillColorQuarternary}" />
    <SolidColorBrush x:Key="ProgressBarIndeterminateBackground" Color="{DynamicResource ControlAltFillColorQuarternary}" />

    <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="#24000000" />
    <SolidColorBrush x:Key="DialogMaskBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="EmerdeDialogSurfaceBrush" Color="#FFF1F4F5" />
    <SolidColorBrush x:Key="EmerdeDialogBorderBrush" Color="#24000000" />
    <SolidColorBrush x:Key="EmerdeDialogWarningBrush" Color="#FFF3E2CE" />
    <SolidColorBrush x:Key="EmerdeDialogTextPrimaryBrush" Color="#E8171B20" />
    <SolidColorBrush x:Key="EmerdeDialogTextSecondaryBrush" Color="#A8171B20" />
</ResourceDictionary>
