<ui:FluentWindow x:Class="Emerde.Installer.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Emerde 安装器"
                 Width="600"
                 Height="400"
                 d:Background="{DynamicResource ApplicationBackgroundBrush}"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen"
                 WindowStyle="None"
                 BorderBrush="Transparent"
                 BorderThickness="0"
                 ResizeMode="NoResize"
                 SnapsToDevicePixels="True"
                 SourceInitialized="MainWindowSourceInitialized"
                 UseLayoutRounding="True"
                 mc:Ignorable="d">
    <ui:FluentWindow.Style>
        <Style TargetType="{x:Type ui:FluentWindow}" BasedOn="{StaticResource DefaultFluentWindowStyle}">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Window}">
                        <AdornerDecorator>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="Transparent"
                                    BorderThickness="0">
                                <ContentPresenter />
                            </Border>
                        </AdornerDecorator>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Style>
    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.Resources>
            <Style x:Key="TitleStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="SubtitleStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="LineHeight" Value="19" />
            </Style>
            <Style x:Key="LinkButtonStyle" TargetType="{x:Type ui:Button}">
                <Setter Property="Padding" Value="5,3" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="#168A55" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ui:Button}">
                            <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.72" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Opacity" Value="0.52" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="EmerdePrimaryButtonStyle" TargetType="{x:Type ui:Button}">
                <Setter Property="Padding" Value="18,7" />
                <Setter Property="Background" Value="#14B86B" />
                <Setter Property="BorderBrush" Value="#14B86B" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ui:Button}">
                            <Border x:Name="ButtonChrome"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonChrome" Property="Background" Value="#0EAA60" />
                                    <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#0EAA60" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonChrome" Property="Background" Value="#0A9553" />
                                    <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#0A9553" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SecondaryButtonStyle" TargetType="{x:Type ui:Button}">
                <Setter Property="Padding" Value="16,7" />
                <Setter Property="Background" Value="#0A000000" />
                <Setter Property="BorderBrush" Value="#24000000" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ui:Button}">
                            <Border x:Name="ButtonChrome"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonChrome" Property="Background" Value="#10000000" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonChrome" Property="Background" Value="#18000000" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="MaintenanceActionButtonStyle"
                   TargetType="{x:Type ui:Button}"
                   BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="Height" Value="76" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="10" />
            </Style>
            <Style x:Key="MaintenanceUpgradeButtonStyle"
                   TargetType="{x:Type ui:Button}"
                   BasedOn="{StaticResource MaintenanceActionButtonStyle}">
                <Setter Property="Background" Value="#0B14B86B" />
                <Setter Property="BorderBrush" Value="#3514B86B" />
            </Style>
            <Style x:Key="MaintenanceRepairButtonStyle"
                   TargetType="{x:Type ui:Button}"
                   BasedOn="{StaticResource MaintenanceActionButtonStyle}">
                <Setter Property="Background" Value="#0B0078D4" />
                <Setter Property="BorderBrush" Value="#350078D4" />
            </Style>
            <Style x:Key="MaintenanceUninstallButtonStyle"
                   TargetType="{x:Type ui:Button}"
                   BasedOn="{StaticResource MaintenanceActionButtonStyle}">
                <Setter Property="Background" Value="#0BC42B1C" />
                <Setter Property="BorderBrush" Value="#35C42B1C" />
            </Style>
            <Style x:Key="InstallerTextBoxStyle"
                   TargetType="{x:Type ui:TextBox}"
                   BasedOn="{StaticResource {x:Type ui:TextBox}}">
                <Style.Resources>
                    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="Transparent" />
                </Style.Resources>
                <Setter Property="BorderBrush" Value="#24000000" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Effect" Value="{x:Null}" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="#24000000" />
                        <Setter Property="Effect" Value="{x:Null}" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                        <Setter Property="Effect" Value="{x:Null}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Panel.ZIndex="10">
            <ui:TitleBar Height="40" Title="" ShowMaximize="False" />
            <StackPanel Margin="16,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Orientation="Horizontal">
                <Image x:Name="TitleIconImage"
                       Width="18"
                       Height="18"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="pack://application:,,,/Assets/Installer.png" />
                <TextBlock Margin="9,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Text="Emerde 安装器" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid x:Name="WelcomePage">
                <Grid.RowDefinitions>
                    <RowDefinition Height="304" />
                    <RowDefinition Height="56" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Width="100"
                           Height="100"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="pack://application:,,,/Assets/Installer.png">
                        <Image.Effect>
                            <DropShadowEffect BlurRadius="10"
                                              Direction="270"
                                              Opacity="0.18"
                                              ShadowDepth="2"
                                              Color="Black" />
                        </Image.Effect>
                    </Image>
                    <TextBlock Margin="0,16,0,0"
                               HorizontalAlignment="Center"
                               Style="{StaticResource TitleStyle}"
                               Text="Emerde" />
                    <ui:Button Width="220"
                               Height="44"
                               Margin="0,24,0,0"
                               Click="InstallNowButtonClick"
                               Content="安装"
                               Style="{StaticResource EmerdePrimaryButtonStyle}" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="22,0">
                    <ui:Button x:Name="OptionsToggleButton"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Click="OptionsButtonClick"
                               Content="安装选项"
                               Style="{StaticResource LinkButtonStyle}" />
                </Grid>

                <Grid x:Name="InstallOptionsPanel"
                      Grid.Row="2"
                      Margin="22,0,22,17"
                      Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Rectangle Height="1"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Top"
                                   Fill="#20000000" />
                        <Grid Grid.Row="1" Margin="18,15,18,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="InstallPathTextBox"
                                        Height="34"
                                        VerticalContentAlignment="Center"
                                        PlaceholderText="安装位置"
                                        Style="{StaticResource InstallerTextBoxStyle}" />
                            <ui:Button Grid.Column="2"
                                       Height="34"
                                       Click="BrowseInstallFolderButtonClick"
                                       Content="浏览"
                                       FontSize="12"
                                       Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>
                        <Grid Grid.Row="2" Margin="18,14,18,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="CreateShortcutsCheckBox"
                                      VerticalAlignment="Center"
                                      Content="快捷方式"
                                      IsChecked="True" />
                            <CheckBox x:Name="AutoStartCheckBox"
                                      Grid.Column="1"
                                      VerticalAlignment="Center"
                                      Content="开机自启" />
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <Grid x:Name="MaintenancePage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Margin="0,17,0,0" HorizontalAlignment="Center">
                    <Image x:Name="MaintenanceLogoImage"
                           Width="100"
                           Height="100"
                           HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="pack://application:,,,/Assets/Maintenance.png">
                        <Image.Effect>
                            <DropShadowEffect BlurRadius="10"
                                              Direction="270"
                                              Opacity="0.16"
                                              ShadowDepth="2"
                                              Color="Black" />
                        </Image.Effect>
                    </Image>
                    <TextBlock Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Text="维护 Emerde" />
                    <TextBlock x:Name="InstalledVersionText"
                               Margin="0,2,0,0"
                               HorizontalAlignment="Center"
                               Style="{StaticResource SubtitleStyle}"
                               Text="已安装版本 1.6.7.0" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="31,30,31,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="76" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:Button Click="UpgradeButtonClick" Style="{StaticResource MaintenanceUpgradeButtonStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" Background="#1214B86B" CornerRadius="5">
                                <ui:SymbolIcon HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="17"
                                               Foreground="#0E9F5B"
                                               Symbol="ArrowSync24" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontSize="15" FontWeight="SemiBold" Text="升级" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="更新程序并保留设置" />
                            </StackPanel>
                        </Grid>
                    </ui:Button>
                    <ui:Button Grid.Column="2"
                               Click="RepairButtonClick"
                               Style="{StaticResource MaintenanceRepairButtonStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" Background="#120078D4" CornerRadius="5">
                                <ui:SymbolIcon HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="17"
                                               Foreground="#0067B8"
                                               Symbol="WrenchScrewdriver24" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontSize="15" FontWeight="SemiBold" Text="修复" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="校验并恢复程序文件" />
                            </StackPanel>
                        </Grid>
                    </ui:Button>
                    <ui:Button Grid.Column="4"
                               Click="UninstallButtonClick"
                               Style="{StaticResource MaintenanceUninstallButtonStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" Background="#12C42B1C" CornerRadius="5">
                                <ui:SymbolIcon HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="17"
                                               Foreground="#C42B1C"
                                               Symbol="Delete24" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontSize="15" FontWeight="SemiBold" Text="卸载" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="移除程序文件" />
                            </StackPanel>
                        </Grid>
                    </ui:Button>
                    <Rectangle Grid.Row="1"
                               Grid.ColumnSpan="5"
                               Height="1"
                               VerticalAlignment="Bottom"
                               Fill="#20000000" />
                    <Grid Grid.Row="2" Grid.ColumnSpan="5" Margin="5,10,5,0">
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="卸载选项" />
                        <CheckBox x:Name="KeepUserDataCheckBox"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Content="保留用户数据"
                                  FontSize="11"
                                  IsChecked="True" />
                    </Grid>
                </Grid>
            </Grid>

            <Grid x:Name="ProgressPage" Visibility="Collapsed">
                <StackPanel Width="470"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Image x:Name="ProgressLogoImage"
                           Width="84"
                           Height="84"
                           HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="pack://application:,,,/Assets/Installer.png" />
                    <TextBlock x:Name="ProgressTitleText"
                               Margin="0,17,0,0"
                               HorizontalAlignment="Center"
                               Style="{StaticResource TitleStyle}"
                               Text="正在安装 Emerde" />
                    <ProgressBar x:Name="SimulationProgress"
                                 Height="6"
                                 Margin="0,32,0,0"
                                 Maximum="100"
                                 Value="0" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ProgressStatusText"
                                   Style="{StaticResource SubtitleStyle}"
                                   Text="正在准备..." />
                        <TextBlock x:Name="ProgressValueText"
                                   Grid.Column="1"
                                   Margin="12,0,0,0"
                                   Style="{StaticResource SubtitleStyle}"
                                   Text="0%" />
                    </Grid>
                </StackPanel>
            </Grid>

            <Grid x:Name="FinishPage" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border x:Name="FinishStatusBorder"
                            Width="84"
                            Height="84"
                            Background="#14B86B"
                            CornerRadius="42">
                        <TextBlock x:Name="FinishStatusIcon"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="38"
                                   Foreground="White"
                                   Text="&#x2713;" />
                    </Border>
                    <TextBlock x:Name="FinishTitleText"
                               Margin="0,18,0,0"
                               HorizontalAlignment="Center"
                               Style="{StaticResource TitleStyle}"
                               Text="Emerde 已安装" />
                    <TextBlock x:Name="FinishMessageText"
                               Width="420"
                               Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Style="{StaticResource SubtitleStyle}"
                               Text="安装已完成。" />
                    <ui:Button x:Name="FinishPrimaryButton"
                               Width="132"
                               Height="40"
                               Margin="0,24,0,0"
                               Click="FinishPrimaryButtonClick"
                               Content="运行 Emerde"
                               Style="{StaticResource EmerdePrimaryButtonStyle}" />
                    <CheckBox x:Name="LaunchAfterFinishCheckBox"
                              Margin="0,12,0,0"
                              HorizontalAlignment="Center"
                              Checked="LaunchAfterFinishCheckBoxChanged"
                              Content="完成后运行 Emerde"
                              FontSize="11"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              IsChecked="True"
                              Opacity="0.76"
                              Unchecked="LaunchAfterFinishCheckBoxChanged" />
                </StackPanel>
            </Grid>

            <Grid x:Name="RunningDialogLayer"
                  Panel.ZIndex="100"
                  Background="#66000000"
                  Visibility="Collapsed">
                <Border Width="410"
                        Padding="24,22"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#FFF7F7F7"
                        BorderBrush="#26000000"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="30"
                                Height="30"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="#FFF4CE"
                                CornerRadius="15">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#9D5D00"
                                       Text="!" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="#202020"
                                       Text="Emerde 正在运行" />
                            <TextBlock Margin="0,7,0,0"
                                       FontSize="13"
                                       Foreground="#666666"
                                       LineHeight="20"
                                       Text="继续前需要关闭 Emerde。是否立即停止并继续？"
                                       TextWrapping="Wrap" />
                            <StackPanel Margin="0,20,0,0"
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal">
                                <ui:Button Width="82"
                                           Margin="0,0,9,0"
                                           Click="CancelStopButtonClick"
                                           Content="取消"
                                           Style="{StaticResource SecondaryButtonStyle}" />
                                <ui:Button x:Name="StopAndContinueButton"
                                           Width="120"
                                           Click="StopAndContinueButtonClick"
                                           Content="停止并继续"
                                           Style="{StaticResource EmerdePrimaryButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
