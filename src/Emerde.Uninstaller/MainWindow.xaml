<ui:FluentWindow x:Class="Emerde.Uninstaller.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="卸载 Emerde"
                 Width="370"
                 Height="224"
                 d:Background="{DynamicResource ApplicationBackgroundBrush}"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen"
                 WindowStyle="None"
                 BorderBrush="Transparent"
                 BorderThickness="0"
                 MinWidth="0"
                 MinHeight="0"
                 ResizeMode="NoResize"
                 SnapsToDevicePixels="True"
                 UseLayoutRounding="True"
                 mc:Ignorable="d">
    <ui:FluentWindow.Style>
        <Style TargetType="{x:Type ui:FluentWindow}" BasedOn="{StaticResource DefaultFluentWindowStyle}">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Window}">
                        <AdornerDecorator>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="Transparent"
                                    BorderThickness="0">
                                <ContentPresenter />
                            </Border>
                        </AdornerDecorator>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Style>
    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.Resources>
            <Style x:Key="TitleStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="19" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="SubtitleStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="LineHeight" Value="19" />
            </Style>
            <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type ui:Button}">
                <Setter Property="Padding" Value="18,7" />
                <Setter Property="Background" Value="#14B86B" />
                <Setter Property="BorderBrush" Value="#14B86B" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ui:Button}">
                            <Border x:Name="ButtonChrome"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonChrome" Property="Background" Value="#0EAA60" />
                                    <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#0EAA60" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonChrome" Property="Background" Value="#0A9553" />
                                    <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#0A9553" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SecondaryButtonStyle" TargetType="{x:Type ui:Button}">
                <Setter Property="Padding" Value="16,7" />
                <Setter Property="Background" Value="#0A000000" />
                <Setter Property="BorderBrush" Value="#24000000" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ui:Button}">
                            <Border x:Name="ButtonChrome"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonChrome" Property="Background" Value="#10000000" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonChrome" Property="Background" Value="#18000000" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Panel.ZIndex="10">
            <ui:TitleBar Height="40" Title="" ShowMaximize="False" />
            <StackPanel Margin="16,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Orientation="Horizontal">
                <Image Width="18"
                       Height="18"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="pack://application:,,,/Assets/Uninstaller.png" />
                <TextBlock Margin="9,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Text="卸载 Emerde" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="18,8,18,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <Image Width="42"
                       Height="42"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="pack://application:,,,/Assets/Uninstaller.png" />
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Style="{StaticResource TitleStyle}" Text="卸载 Emerde" />
                    <TextBlock x:Name="DescriptionText"
                               Margin="0,2,0,0"
                               FontSize="11"
                               Style="{StaticResource SubtitleStyle}"
                               Text="将从此电脑移除 Emerde 的程序文件。" />
                </StackPanel>
            </StackPanel>

            <Rectangle Grid.Row="1" Height="1" Margin="0,10,0,0" Fill="#20000000" />
            <CheckBox x:Name="KeepUserDataCheckBox"
                      Grid.Row="2"
                      Margin="0,11,0,0"
                      Content="保留用户数据"
                      IsChecked="True" />

            <TextBlock x:Name="ErrorText"
                       Grid.Row="3"
                       Margin="0,4,0,0"
                       Foreground="#C42B1C"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />

            <Grid Grid.Row="4" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Button x:Name="CancelButton"
                           Grid.Column="0"
                           Height="34"
                           HorizontalAlignment="Stretch"
                           Click="CancelButtonClick"
                           Content="取消"
                           Style="{StaticResource SecondaryButtonStyle}" />
                <ui:Button x:Name="UninstallButton"
                           Grid.Column="2"
                           Height="34"
                           HorizontalAlignment="Stretch"
                           Click="UninstallButtonClick"
                           Content="卸载"
                           Style="{StaticResource PrimaryButtonStyle}" />
            </Grid>
        </Grid>

        <Grid x:Name="RunningDialogLayer"
              Grid.Row="1"
              Panel.ZIndex="100"
              Background="#66000000"
              Visibility="Collapsed">
            <Border Width="350"
                    Padding="18,16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#FFF7F7F7"
                    BorderBrush="#26000000"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="26"
                            Height="26"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="#FFF4CE"
                            CornerRadius="13">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#9D5D00"
                                   Text="!" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#202020"
                                   Text="Emerde 正在运行" />
                        <TextBlock Margin="0,5,0,0"
                                   MinHeight="40"
                                   FontSize="12"
                                   Foreground="#666666"
                                   LineHeight="20"
                                   Text="继续前需要关闭 Emerde。&#10;是否立即停止并继续？"
                                   TextTrimming="None"
                                   TextWrapping="Wrap" />
                        <StackPanel Margin="0,13,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                            <ui:Button Width="78"
                                       Height="32"
                                       Margin="0,0,7,0"
                                       Click="CancelStopButtonClick"
                                       Content="取消"
                                       Style="{StaticResource SecondaryButtonStyle}" />
                            <ui:Button Width="120"
                                       Height="32"
                                       Click="StopAndContinueButtonClick"
                                       Content="停止并继续"
                                       Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
